---
import { getT, navRoutes, getEquivalentLanguageUrl, type Lang } from '../utils/i18n';

export interface Props {
  lang?: Lang;
  currentPath?: string;
}

const { lang = 'tr', currentPath = Astro.url.pathname } = Astro.props;
const t = getT(lang);

// Helper to normalize path for active route comparison
const normalizePath = (path: string) => {
  const p = path.replace(/\/$/, '') || '/';
  return p;
};

const activePath = normalizePath(currentPath);

const links = navRoutes.map((route) => {
  const href = lang === 'tr' ? route.pathTr : route.pathEn;
  const label = t.nav[route.key];
  const normalizedHref = normalizePath(href);
  
  // Exact match for root, prefix match or exact match for nested routes
  const isActive = normalizedHref === '/' || normalizedHref === '/en'
    ? activePath === normalizedHref
    : activePath === normalizedHref || activePath.startsWith(`${normalizedHref}/`);

  return { href, label, isActive };
});

const targetLang: Lang = lang === 'tr' ? 'en' : 'tr';
const switchLangUrl = getEquivalentLanguageUrl(currentPath, targetLang);
const homeUrl = lang === 'tr' ? '/' : '/en';
---

<header class="sticky top-0 z-40 w-full bg-parchment/95 backdrop-blur-md border-b border-sand h-20 transition-all duration-300">
  <div class="max-w-[1280px] mx-auto h-full px-5 md:px-12 flex items-center justify-between gap-4">
    
    <!-- Brand / Logo with Bodrum Emblem -->
    <a 
      href={homeUrl} 
      class="group flex items-center gap-3 focus:outline-none focus-visible:ring-2 focus-visible:ring-olive rounded-sm py-1"
      aria-label={`${t.siteTitle} - ${t.nav.home}`}
    >
      <!-- Custom Library Emblem (Bodrum Blue Anchor/Book Emblem) -->
      <div class="w-9 h-9 rounded-full bg-olive text-white flex items-center justify-center shadow-xs transition-transform group-hover:scale-105">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />
        </svg>
      </div>
      <span class="font-serif text-xl sm:text-2xl italic font-semibold text-ink tracking-tight group-hover:text-olive transition-colors duration-200">
        {t.siteTitle}
      </span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden lg:flex items-center gap-5 xl:gap-7" aria-label="Ana Menü">
      {links.map((link) => (
        <a
          href={link.href}
          class={`text-sm xl:text-[15px] transition-all duration-200 ${
            link.isActive
              ? 'border-b-2 border-olive pb-1 font-semibold text-olive'
              : 'text-ink/80 hover:text-olive hover:border-b-2 hover:border-sand pb-1 font-medium'
          }`}
          aria-current={link.isActive ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <!-- Desktop Utility Actions: Search & Language Switcher -->
    <div class="hidden lg:flex items-center gap-3">
      <!-- Search Trigger Button -->
      <button
        type="button"
        data-search-trigger
        class="flex items-center gap-2 px-3 py-1.5 rounded border border-sand bg-surface-container-low hover:bg-surface-container hover:border-ink/30 text-ink/80 hover:text-ink transition-all text-xs focus:outline-none focus-visible:ring-2 focus-visible:ring-olive cursor-pointer"
        aria-label={t.search.title}
        title={`${t.search.title} (⌘K)`}
      >
        <span class="material-symbols-outlined text-[18px] text-ink/70">search</span>
        <span class="hidden xl:inline text-xs text-ink/70">{t.search.title}</span>
        <kbd class="font-mono text-[10px] bg-parchment border border-sand px-1.5 py-0.5 rounded text-stone-gray shadow-xs">
          ⌘K
        </kbd>
      </button>

      <!-- Language Switcher Toggle -->
      <a
        href={switchLangUrl}
        class="flex items-center text-xs tracking-wider font-medium text-ink border border-sand hover:border-ink/40 bg-surface-container-low px-2.5 py-1.5 rounded transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-olive"
        title={lang === 'tr' ? 'Switch to English' : 'Türkçe\'ye geç'}
        aria-label={lang === 'tr' ? 'Switch website to English' : 'Web sitesini Türkçe\'ye çevir'}
      >
        <span class={lang === 'tr' ? 'font-bold text-olive' : 'text-stone-gray hover:text-ink'}>TR</span>
        <span class="mx-1 text-sand">|</span>
        <span class={lang === 'en' ? 'font-bold text-olive' : 'text-stone-gray hover:text-ink'}>EN</span>
      </a>
    </div>

    <!-- Mobile Action Buttons -->
    <div class="flex lg:hidden items-center gap-2">
      <!-- Mobile Search Button -->
      <button
        type="button"
        data-search-trigger
        class="p-2 text-ink/80 hover:text-olive focus:outline-none focus-visible:ring-2 focus-visible:ring-olive rounded"
        aria-label={t.search.title}
      >
        <span class="material-symbols-outlined text-2xl">search</span>
      </button>

      <!-- Mobile Menu Hamburger Button -->
      <button
        type="button"
        id="mobile-menu-open-btn"
        class="p-2 text-ink/80 hover:text-olive focus:outline-none focus-visible:ring-2 focus-visible:ring-olive rounded"
        aria-label="Menüyü Aç"
        aria-expanded="false"
        aria-controls="mobile-drawer"
      >
        <span class="material-symbols-outlined text-2xl">menu</span>
      </button>
    </div>

  </div>
</header>

<!-- Mobile Navigation Drawer -->
<div
  id="mobile-drawer"
  class="fixed inset-0 z-50 transform -translate-x-full transition-transform duration-300 ease-in-out lg:hidden"
  aria-hidden="true"
  role="dialog"
  aria-modal="true"
  aria-label="Mobil Menü"
>
  <!-- Backdrop overlay -->
  <div 
    id="mobile-drawer-backdrop" 
    class="fixed inset-0 bg-ink/60 backdrop-blur-xs opacity-0 transition-opacity duration-300"
  ></div>

  <!-- Drawer panel content -->
  <div class="relative w-full max-w-sm bg-parchment h-full flex flex-col shadow-2xl border-r border-sand overflow-y-auto">
    
    <!-- Drawer Header -->
    <div class="p-6 border-b border-sand flex items-center justify-between">
      <div class="flex items-center gap-2.5">
        <div class="w-8 h-8 rounded-full bg-olive text-white flex items-center justify-center shadow-xs">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />
          </svg>
        </div>
        <span class="font-serif text-lg italic font-semibold text-ink">
          {t.siteTitle}
        </span>
      </div>

      <button
        type="button"
        id="mobile-menu-close-btn"
        class="p-2 text-ink/70 hover:text-olive focus:outline-none focus-visible:ring-2 focus-visible:ring-olive rounded"
        aria-label="Menüyü Kapat"
      >
        <span class="material-symbols-outlined text-2xl">close</span>
      </button>
    </div>

    <!-- Drawer Navigation Links -->
    <nav class="p-6 flex flex-col gap-4 flex-1" aria-label="Mobil Menü Linkleri">
      {links.map((link) => (
        <a
          href={link.href}
          class={`text-base font-serif transition-colors py-2 border-b border-sand/60 flex items-center justify-between ${
            link.isActive
              ? 'text-olive font-semibold'
              : 'text-ink hover:text-olive'
          }`}
        >
          <span>{link.label}</span>
          <span class="material-symbols-outlined text-sm text-stone-gray">chevron_right</span>
        </a>
      ))}
    </nav>

    <!-- Drawer Footer Actions -->
    <div class="p-6 border-t border-sand bg-surface-container-low flex flex-col gap-4">
      <!-- Mobile Search Shortcut -->
      <button
        type="button"
        data-search-trigger
        class="w-full flex items-center justify-center gap-2 py-2.5 px-4 rounded border border-sand bg-parchment text-ink text-sm hover:bg-surface-container transition-colors"
      >
        <span class="material-symbols-outlined text-lg text-stone-gray">search</span>
        <span>{t.search.placeholder}</span>
      </button>

      <!-- Language Selector -->
      <div class="flex items-center justify-between pt-2 text-sm text-stone-gray">
        <span>Dil / Language:</span>
        <a
          href={switchLangUrl}
          class="flex items-center font-semibold text-ink border border-sand bg-parchment px-3 py-1 rounded text-xs hover:border-ink/50 transition-colors"
        >
          <span class={lang === 'tr' ? 'text-olive font-bold' : 'text-stone-gray'}>TR</span>
          <span class="mx-1 text-sand">|</span>
          <span class={lang === 'en' ? 'text-olive font-bold' : 'text-stone-gray'}>EN</span>
        </a>
      </div>
    </div>

  </div>
</div>

<script>
  function setupMobileDrawer() {
    const openBtn = document.getElementById('mobile-menu-open-btn');
    const closeBtn = document.getElementById('mobile-menu-close-btn');
    const drawer = document.getElementById('mobile-drawer');
    const backdrop = document.getElementById('mobile-drawer-backdrop');

    if (!openBtn || !closeBtn || !drawer || !backdrop) return;

    const elOpenBtn = openBtn;
    const elCloseBtn = closeBtn;
    const elDrawer = drawer;
    const elBackdrop = backdrop;

    function openDrawer() {
      elDrawer.classList.remove('-translate-x-full');
      elDrawer.setAttribute('aria-hidden', 'false');
      elOpenBtn.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      setTimeout(() => {
        elBackdrop.classList.remove('opacity-0');
        elBackdrop.classList.add('opacity-100');
      }, 10);
    }

    function closeDrawer() {
      elBackdrop.classList.remove('opacity-100');
      elBackdrop.classList.add('opacity-0');
      elDrawer.classList.add('-translate-x-full');
      elDrawer.setAttribute('aria-hidden', 'true');
      elOpenBtn.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    }

    elOpenBtn.addEventListener('click', openDrawer);
    elCloseBtn.addEventListener('click', closeDrawer);
    elBackdrop.addEventListener('click', closeDrawer);

    // Close on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !elDrawer.classList.contains('-translate-x-full')) {
        closeDrawer();
      }
    });

    // Close drawer when a navigation link is clicked
    const navLinks = elDrawer.querySelectorAll('nav a');
    navLinks.forEach((link) => {
      link.addEventListener('click', closeDrawer);
    });
  }

  // Setup on initial load and page transitions
  setupMobileDrawer();
  document.addEventListener('astro:page-load', setupMobileDrawer);
</script>
