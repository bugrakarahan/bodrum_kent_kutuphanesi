---
import { getT, navRoutes, type Lang } from '../utils/i18n';

export interface Props {
  lang?: Lang;
  currentPath?: string;
}

const { lang = 'tr', currentPath = '/' } = Astro.props;
const t = getT(lang);

const links = navRoutes.map((route) => {
  const href = lang === 'tr' ? route.pathTr : route.pathEn;
  const isExactActive = currentPath === href;
  const isNestedActive = href !== '/' && href !== '/en' && currentPath.startsWith(href);
  const isActive = isExactActive || isNestedActive;

  return {
    href,
    label: t.nav[route.key],
    isActive
  };
});

const targetLang = lang === 'tr' ? 'en' : 'tr';
const currentRouteObj = navRoutes.find(
  (r) => r.pathTr === currentPath || r.pathEn === currentPath
);
const switchUrl = currentRouteObj
  ? targetLang === 'tr'
    ? currentRouteObj.pathTr
    : currentRouteObj.pathEn
  : targetLang === 'tr'
    ? '/'
    : '/en';
---

<header
  id="main-header"
  class="fixed top-0 left-0 right-0 z-50 bg-olive text-parchment border-b border-white/15 h-20 shadow-sm flex items-center"
>
  <div class="max-w-[1360px] mx-auto w-full px-4 sm:px-6 lg:px-8 flex items-center justify-between gap-3">
    
    <!-- 1. Left: Brand Logo & Title (Compact & Elegant) -->
    <a
      href={lang === 'tr' ? '/' : '/en'}
      class="flex items-center gap-3 shrink-0 group focus:outline-none focus-visible:ring-2 focus-visible:ring-parchment"
      aria-label={`${t.siteTitle} ${t.home}`}
    >
      <img
        src="/images/logo.png"
        alt="Bodrum Kent Kütüphanesi Logosu"
        class="w-10 h-10 object-contain rounded-xs border border-white/25 bg-white/5 shadow-2xs group-hover:scale-105 transition-transform"
      />
      
      <span class="font-serif text-base sm:text-lg font-bold tracking-tight text-white whitespace-nowrap">
        {t.siteTitle}
      </span>
    </a>

    <!-- 2. Center: Desktop Navigation Links (Refined typography) -->
    <nav class="hidden lg:flex items-center justify-center gap-3 xl:gap-5 flex-1 px-2" aria-label="Ana Menü">
      {links.map((link) => (
        <a
          href={link.href}
          class={`font-sans text-[11px] xl:text-[12px] uppercase tracking-wider font-semibold text-center transition-all duration-150 py-1 px-1 whitespace-nowrap ${
            link.isActive
              ? 'text-white border-b-2 border-white font-bold'
              : 'text-parchment/80 hover:text-white hover:border-b border-white/40'
          }`}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <!-- 3. Right: Utility Controls (Always fully visible, shrink-0) -->
    <div class="flex items-center gap-2 shrink-0">
      
      <!-- Search Modal Trigger Button -->
      <button
        type="button"
        data-search-trigger
        class="flex items-center gap-1.5 px-2.5 py-1.5 text-xs font-sans font-semibold text-white bg-white/10 border border-white/20 hover:bg-white/20 rounded-xs transition-colors shadow-2xs"
        aria-label="Site İçi Arama"
      >
        <span class="material-symbols-outlined text-[17px]">search</span>
        <span class="hidden sm:inline font-mono uppercase text-[11px] tracking-wider">ARA</span>
        <kbd class="hidden md:inline-block text-[10px] font-mono bg-black/20 text-white/80 px-1 py-0.2 rounded border border-white/20">
          ⌘K
        </kbd>
      </button>

      <!-- Language Toggle Switcher -->
      <a
        href={switchUrl}
        class="px-2.5 py-1.5 text-xs font-mono font-bold tracking-wider uppercase text-white bg-white/10 border border-white/20 hover:bg-white/20 rounded-xs transition-colors flex items-center gap-1 shadow-2xs"
        aria-label={`Dili Değiştir (${targetLang.toUpperCase()})`}
      >
        <span class="material-symbols-outlined text-[15px]">language</span>
        <span>{lang === 'tr' ? 'EN' : 'TR'}</span>
      </a>

      <!-- Mobile Hamburger Button -->
      <button
        type="button"
        id="mobile-menu-toggle"
        class="lg:hidden p-2 text-parchment hover:text-white hover:bg-white/10 rounded-xs transition-colors ml-1"
        aria-label="Menüyü Aç"
        aria-expanded="false"
      >
        <span class="material-symbols-outlined text-2xl" id="menu-icon">menu</span>
      </button>

    </div>

  </div>

  <!-- Mobile Drawer Menu -->
  <div
    id="mobile-menu-drawer"
    class="lg:hidden hidden bg-olive border-b border-white/15 px-5 py-6 space-y-4 shadow-xl absolute top-20 left-0 right-0"
  >
    <nav class="flex flex-col space-y-3" aria-label="Mobil Menü">
      {links.map((link) => (
        <a
          href={link.href}
          class={`font-sans text-sm uppercase tracking-wider font-semibold py-2 px-3 rounded-xs transition-colors text-center ${
            link.isActive
              ? 'bg-white/20 text-white font-bold'
              : 'text-parchment/90 hover:bg-white/10 hover:text-white'
          }`}
        >
          {link.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const drawer = document.getElementById('mobile-menu-drawer');
  const menuIcon = document.getElementById('menu-icon');

  if (toggleBtn && drawer && menuIcon) {
    toggleBtn.addEventListener('click', () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', String(!isExpanded));
      drawer.classList.toggle('hidden');
      menuIcon.textContent = isExpanded ? 'menu' : 'close';
    });
  }
</script>
