---
import { getT, navRoutes, type Lang } from '../utils/i18n';

export interface Props {
  lang?: Lang;
}

const { lang = 'tr' } = Astro.props;
const t = getT(lang);
const currentYear = new Date().getFullYear();

const links = navRoutes.map((route) => ({
  href: lang === 'tr' ? route.pathTr : route.pathEn,
  label: t.navFooter[route.key] || t.nav[route.key]
}));
---

<footer class="bg-olive text-parchment border-t border-white/15 py-6 md:py-8 px-5 md:px-12">
  <div class="max-w-[1280px] mx-auto">
    <!-- Top 4 Columns Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8 pb-6 border-b border-white/15">
      
      <!-- Column 1: Institutional Brand, Mission Statement & Designer Credit -->
      <div class="flex flex-col gap-2.5">
        <a 
          href={lang === 'tr' ? '/' : '/en'} 
          class="font-serif text-base sm:text-lg font-bold tracking-tight text-white hover:text-parchment/80 transition-colors inline-block"
        >
          {t.siteTitle}
        </a>
        <p class="text-xs text-parchment/90 leading-relaxed font-sans">
          {t.footer.missionSnippet}
        </p>
        
        <!-- Ex Libris Motif -->
        <div class="mt-1 flex items-center gap-2 text-parchment/75">
          <div class="w-6 h-6 rounded-full border border-white/20 bg-white/10 flex items-center justify-center shadow-2xs">
            <svg class="w-3 h-3 text-parchment" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />
            </svg>
          </div>
          <div class="text-[10px] uppercase tracking-widest leading-tight">
            <span class="font-serif font-bold text-white block">EX LIBRIS • BODRUM</span>
          </div>
        </div>

        <!-- Designer Credit: Only SHELLIX is bold and underlined -->
        <div class="pt-1 text-[11px] sm:text-[12px] font-sans tracking-wider uppercase text-parchment/90 leading-snug">
          <div>
            <a
              href="https://shellix.com"
              target="_blank"
              rel="noopener noreferrer"
              class="text-white font-bold underline underline-offset-2 hover:text-amber-200 transition-colors"
            >SHELLIX</a> TARAFINDAN
          </div>
          <div class="pt-0.5">
            {lang === 'tr' ? 'SEVGİYLE TASARLANDI ❤️' : 'DESIGNED WITH LOVE ❤️'}
          </div>
        </div>
      </div>

      <!-- Column 2: Menu / Navigation Links -->
      <div class="flex flex-col gap-2.5">
        <h3 class="font-serif text-sm sm:text-base text-white font-bold tracking-tight">
          {t.footer.navigation}
        </h3>
        <ul class="space-y-1 text-xs font-sans" role="list">
          {links.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-parchment/85 hover:text-white hover:underline underline-offset-4 transition-colors inline-block font-medium"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Column 3: Sosyal Medya -->
      <div class="flex flex-col gap-2.5">
        <h3 class="font-serif text-sm sm:text-base text-white font-bold tracking-tight">
          {t.footer.socialMedia}
        </h3>
        <ul class="space-y-1.5 text-xs font-sans" role="list">
          <li>
            <a
              href="https://wa.me/905423739748"
              target="_blank"
              rel="noopener noreferrer"
              class="group flex items-center gap-2 text-parchment/85 hover:text-white transition-colors font-medium"
            >
              <span class="w-5 h-5 rounded border border-white/30 bg-white/15 flex items-center justify-center group-hover:border-white group-hover:bg-white/25 transition-colors">
                <svg class="w-3 h-3 text-white" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
                </svg>
              </span>
              <span>WhatsApp Kanalı</span>
            </a>
          </li>

          <li>
            <a
              href="https://instagram.com"
              target="_blank"
              rel="noopener noreferrer"
              class="group flex items-center gap-2 text-parchment/85 hover:text-white transition-colors font-medium"
            >
              <span class="w-5 h-5 rounded border border-white/20 bg-white/10 flex items-center justify-center group-hover:border-white transition-colors">
                <svg class="w-2.5 h-2.5 text-parchment" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                  <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                  <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
                </svg>
              </span>
              <span>Instagram</span>
            </a>
          </li>

          <li>
            <a
              href="https://youtube.com"
              target="_blank"
              rel="noopener noreferrer"
              class="group flex items-center gap-2 text-parchment/85 hover:text-white transition-colors font-medium"
            >
              <span class="w-5 h-5 rounded border border-white/20 bg-white/10 flex items-center justify-center group-hover:border-white transition-colors">
                <svg class="w-2.5 h-2.5 text-parchment" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
                </svg>
              </span>
              <span>YouTube</span>
            </a>
          </li>
        </ul>
      </div>

      <!-- Column 4: Campus & Visiting -->
      <div class="flex flex-col gap-2.5">
        <h3 class="font-serif text-sm sm:text-base text-white font-bold tracking-tight">
          {t.footer.campusAndVisit}
        </h3>
        <div class="space-y-1.5 text-xs sm:text-sm font-sans text-parchment/90">
          <p class="flex items-start gap-1.5">
            <span class="material-symbols-outlined text-[16px] text-parchment shrink-0 mt-0.5">location_on</span>
            <span>{t.footer.address}</span>
          </p>
          <p class="flex items-start gap-1.5">
            <span class="material-symbols-outlined text-[16px] text-parchment shrink-0 mt-0.5">call</span>
            <a href="tel:+905423739748" class="hover:text-white transition-colors font-bold text-white">{t.footer.phone}</a>
          </p>
          <p class="flex items-start gap-1.5">
            <span class="material-symbols-outlined text-[16px] text-parchment shrink-0 mt-0.5">schedule</span>
            <span>{t.footer.openingHours}</span>
          </p>
          <p class="flex items-start gap-1.5 pt-0.5">
            <span class="material-symbols-outlined text-[16px] text-parchment shrink-0 mt-0.5">mail</span>
            <a
              href="mailto:bilgi@bodrumkentkutuphanesi.org"
              class="text-parchment/90 hover:text-white transition-colors text-xs font-sans break-all"
            >
              bilgi@bodrumkentkutuphanesi.org
            </a>
          </p>
        </div>
      </div>

    </div>

    <!-- Bottom Bar: Copyright & Legal Policies -->
    <div class="pt-4 flex flex-col sm:flex-row items-center justify-between gap-2.5 text-[11px] sm:text-xs font-sans text-parchment/70">
      <p class="text-center sm:text-left">
        &copy; {currentYear} {t.siteTitle}. {t.footer.rightsReserved}
      </p>
      
      <div class="flex items-center gap-3 sm:gap-5 flex-wrap justify-center">
        <a 
          href={lang === 'tr' ? '/iletisim#kvkk' : '/en/contact#kvkk'} 
          class="hover:text-white transition-colors"
        >
          {t.footer.kvkk}
        </a>
        <span class="text-white/30 hidden sm:inline">•</span>
        <a 
          href={lang === 'tr' ? '/iletisim#gizlilik' : '/en/contact#privacy'} 
          class="hover:text-white transition-colors"
        >
          {t.footer.privacy}
        </a>
        <span class="text-white/30 hidden sm:inline">•</span>
        <a 
          href={lang === 'tr' ? '/iletisim#cerezler' : '/en/contact#cookies'} 
          class="hover:text-white transition-colors"
        >
          {t.footer.cookies}
        </a>
      </div>
    </div>
  </div>
</footer>
