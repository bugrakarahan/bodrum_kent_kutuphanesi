---
import type { Lang } from '../utils/i18n';

export interface Props {
  lang?: Lang;
}

const { lang = 'tr' } = Astro.props;
---

<div
  id="gallery-modal-backdrop"
  class="fixed inset-0 z-50 bg-ink/90 backdrop-blur-md flex items-center justify-center p-4 sm:p-6 opacity-0 pointer-events-none transition-opacity duration-300"
  role="dialog"
  aria-modal="true"
  aria-labelledby="gallery-modal-title"
>
  <div
    id="gallery-modal-container"
    class="w-full max-w-md sm:max-w-lg bg-olive border-2 border-white/20 rounded-xs shadow-2xl overflow-hidden flex flex-col transform scale-95 transition-transform duration-300 max-h-[95vh]"
  >
    <!-- Header -->
    <div class="px-4 py-3 bg-bodrum-blue-dark border-b border-white/10 flex items-center justify-between text-white">
      <div class="flex items-center gap-2 overflow-hidden mr-3">
        <span class="material-symbols-outlined text-parchment text-xl shrink-0">photo_library</span>
        <div>
          <span class="text-[10px] font-mono tracking-wider uppercase text-sand/80 block">
            {lang === 'tr' ? 'ETKİNLİK FOTOĞRAF ARŞİVİ' : 'EVENT PHOTO ARCHIVE'}
          </span>
          <h3 id="gallery-modal-title" class="font-serif font-bold text-sm sm:text-base text-parchment truncate">
            Etkinlik Fotoğrafları
          </h3>
        </div>
      </div>

      <button
        type="button"
        id="gallery-modal-close"
        class="p-1 rounded text-sand/80 hover:text-white hover:bg-white/10 transition-colors cursor-pointer"
        aria-label="Kapat"
      >
        <span class="material-symbols-outlined text-xl">close</span>
      </button>
    </div>

    <!-- Main Active Photo Display (Vertical 3:4 Fitted) -->
    <div class="relative bg-black flex items-center justify-center p-2 min-h-[380px] max-h-[65vh] overflow-hidden group">
      <img
        id="gallery-modal-img"
        src=""
        alt="Etkinlik Fotoğrafı"
        class="max-w-full max-h-[60vh] object-contain rounded-2xs select-none transition-all duration-300 aspect-[3/4]"
      />

      <!-- Navigation Arrows -->
      <button
        type="button"
        id="gallery-prev-btn"
        class="absolute left-2 top-1/2 -translate-y-1/2 w-9 h-9 rounded-full bg-black/70 hover:bg-olive text-white flex items-center justify-center transition-colors shadow-lg cursor-pointer"
        aria-label="Önceki Fotoğraf"
      >
        <span class="material-symbols-outlined text-xl">chevron_left</span>
      </button>

      <button
        type="button"
        id="gallery-next-btn"
        class="absolute right-2 top-1/2 -translate-y-1/2 w-9 h-9 rounded-full bg-black/70 hover:bg-olive text-white flex items-center justify-center transition-colors shadow-lg cursor-pointer"
        aria-label="Sonraki Fotoğraf"
      >
        <span class="material-symbols-outlined text-xl">chevron_right</span>
      </button>

      <!-- Counter Badge -->
      <div class="absolute bottom-3 left-1/2 -translate-x-1/2 px-2.5 py-0.5 bg-black/80 text-white font-mono text-[11px] rounded-full border border-white/20">
        <span id="gallery-current-index">1</span> / <span id="gallery-total-count">1</span>
      </div>
    </div>

    <!-- Thumbnail Strip -->
    <div id="gallery-thumbs-container" class="p-2.5 bg-bodrum-blue-dark border-t border-white/10 overflow-x-auto flex items-center justify-start sm:justify-center gap-1.5">
      <!-- Dynamically generated thumbnails -->
    </div>
  </div>
</div>

<script>
  function setupGalleryModal() {
    const backdrop = document.getElementById('gallery-modal-backdrop');
    const container = document.getElementById('gallery-modal-container');
    const closeBtn = document.getElementById('gallery-modal-close');
    const titleEl = document.getElementById('gallery-modal-title');
    const imgEl = document.getElementById('gallery-modal-img') as HTMLImageElement | null;
    const prevBtn = document.getElementById('gallery-prev-btn');
    const nextBtn = document.getElementById('gallery-next-btn');
    const currentIndexEl = document.getElementById('gallery-current-index');
    const totalCountEl = document.getElementById('gallery-total-count');
    const thumbsContainer = document.getElementById('gallery-thumbs-container');

    if (!backdrop || !container || !imgEl) return;

    let photos: string[] = [];
    let currentIndex = 0;

    function renderPhoto(index: number) {
      if (!photos.length || !imgEl) return;
      currentIndex = (index + photos.length) % photos.length;
      imgEl.src = photos[currentIndex];
      if (currentIndexEl) currentIndexEl.textContent = String(currentIndex + 1);
      if (totalCountEl) totalCountEl.textContent = String(photos.length);

      // Update active thumbnail outline
      if (thumbsContainer) {
        Array.from(thumbsContainer.children).forEach((thumb, i) => {
          if (i === currentIndex) {
            thumb.classList.add('ring-2', 'ring-olive', 'opacity-100');
            thumb.classList.remove('opacity-50');
          } else {
            thumb.classList.remove('ring-2', 'ring-olive', 'opacity-100');
            thumb.classList.add('opacity-50');
          }
        });
      }
    }

    function openModal(photoList: string[], eventTitle?: string) {
      photos = photoList.length ? photoList : ['/images/drive/etkinlik_arsiv.jpg'];
      currentIndex = 0;

      if (titleEl && eventTitle) {
        titleEl.textContent = eventTitle;
      }

      if (thumbsContainer) {
        thumbsContainer.innerHTML = '';
        photos.forEach((src, idx) => {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = `w-14 h-10 rounded-2xs overflow-hidden border border-white/20 transition-all shrink-0 cursor-pointer ${idx === 0 ? 'ring-2 ring-olive opacity-100' : 'opacity-50 hover:opacity-80'}`;
          btn.innerHTML = `<img src="${src}" class="w-full h-full object-cover" alt="Fotoğraf ${idx + 1}" />`;
          btn.addEventListener('click', () => renderPhoto(idx));
          thumbsContainer.appendChild(btn);
        });
      }

      renderPhoto(0);

      backdrop?.classList.remove('opacity-0', 'pointer-events-none');
      backdrop?.classList.add('opacity-100');
      container?.classList.remove('scale-95');
      container?.classList.add('scale-100');
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      backdrop?.classList.add('opacity-0', 'pointer-events-none');
      backdrop?.classList.remove('opacity-100');
      container?.classList.add('scale-95');
      container?.classList.remove('scale-100');
      document.body.style.overflow = '';
    }

    // Export to global window
    (window as any).openEventGallery = openModal;

    document.addEventListener('click', (e) => {
      const target = (e.target as HTMLElement).closest('[data-gallery-trigger]');
      if (target) {
        e.preventDefault();
        const photosJson = target.getAttribute('data-gallery-photos');
        const title = target.getAttribute('data-gallery-title') || 'Etkinlik Fotoğrafları';
        try {
          const list = photosJson ? JSON.parse(photosJson) : [];
          openModal(list, title);
        } catch {
          openModal(['/images/drive/etkinlik_arsiv.jpg'], title);
        }
      }
    });

    prevBtn?.addEventListener('click', () => renderPhoto(currentIndex - 1));
    nextBtn?.addEventListener('click', () => renderPhoto(currentIndex + 1));
    closeBtn?.addEventListener('click', closeModal);
    backdrop.addEventListener('click', (e) => {
      if (e.target === backdrop) closeModal();
    });

    window.addEventListener('keydown', (e) => {
      if (!backdrop.classList.contains('opacity-100')) return;
      if (e.key === 'Escape') {
        e.preventDefault();
        closeModal();
      } else if (e.key === 'ArrowLeft') {
        renderPhoto(currentIndex - 1);
      } else if (e.key === 'ArrowRight') {
        renderPhoto(currentIndex + 1);
      }
    });
  }

  setupGalleryModal();
  document.addEventListener('astro:page-load', setupGalleryModal);
</script>
