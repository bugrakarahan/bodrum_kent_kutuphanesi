---
import { getT, type Lang } from '../utils/i18n';

export interface Props {
  lang?: Lang;
}

const { lang = 'tr' } = Astro.props;
const t = getT(lang);
---

<div
  id="video-modal-backdrop"
  class="fixed inset-0 z-50 bg-ink/85 backdrop-blur-md flex items-center justify-center p-4 sm:p-6 md:p-10 opacity-0 pointer-events-none transition-opacity duration-300"
  role="dialog"
  aria-modal="true"
  aria-labelledby="video-modal-title"
>
  <div
    id="video-modal-container"
    class="w-full max-w-4xl bg-primary rounded-md border border-stone-gray/40 shadow-2xl overflow-hidden flex flex-col transform scale-95 transition-transform duration-300"
  >
    <!-- Modal Header -->
    <div class="px-4 py-3 bg-primary-container border-b border-sand/20 flex items-center justify-between text-on-primary">
      <div class="flex items-center gap-2 overflow-hidden mr-4">
        <span class="material-symbols-outlined text-olive text-[20px] shrink-0">play_circle</span>
        <h3 id="video-modal-title" class="font-serif italic text-base md:text-lg text-parchment truncate">
          {t.talks}
        </h3>
      </div>

      <button
        type="button"
        id="video-modal-close"
        class="p-1.5 rounded text-sand/80 hover:text-white hover:bg-white/10 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-olive shrink-0 cursor-pointer"
        aria-label="Videoyu kapat"
      >
        <span class="material-symbols-outlined text-[22px]">close</span>
      </button>
    </div>

    <!-- Video 16:9 Aspect Ratio Frame -->
    <div class="relative w-full pb-[56.25%] bg-black">
      <iframe
        id="video-modal-iframe"
        class="absolute inset-0 w-full h-full border-0"
        src=""
        title="YouTube Video Player"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        allowfullscreen
      ></iframe>
    </div>

    <!-- Modal Chapters Bar -->
    <div
      id="video-modal-chapters-container"
      class="hidden px-4 py-2.5 bg-primary-container border-b border-sand/15 overflow-x-auto"
    >
      <div class="flex items-center gap-2">
        <span class="text-[10px] font-sans font-bold uppercase tracking-wider text-sand/60 flex items-center gap-1 shrink-0">
          <span class="material-symbols-outlined text-xs text-olive">schedule</span>
          <span>Bölümler:</span>
        </span>
        <div id="video-modal-chapters-list" class="flex items-center gap-1.5 flex-nowrap shrink-0"></div>
      </div>
    </div>

    <!-- Modal Footer / Captions -->
    <div class="px-4 py-2.5 bg-primary-container/90 flex items-center justify-between text-xs text-sand/70">
      <span id="video-modal-caption" class="truncate font-sans font-medium text-sand/90">
        Bodrum Kent Kütüphanesi Arşivi
      </span>
      <span class="font-mono text-[11px] shrink-0 text-sand/50">
        ESC: Kapat
      </span>
    </div>
  </div>
</div>

<script>
  function setupVideoModal() {
    const backdrop = document.getElementById('video-modal-backdrop');
    const container = document.getElementById('video-modal-container');
    const closeBtn = document.getElementById('video-modal-close');
    const iframe = document.getElementById('video-modal-iframe') as HTMLIFrameElement | null;
    const titleEl = document.getElementById('video-modal-title');
    const captionEl = document.getElementById('video-modal-caption');
    const chaptersContainer = document.getElementById('video-modal-chapters-container');
    const chaptersList = document.getElementById('video-modal-chapters-list');

    if (!backdrop || !container || !iframe) return;

    let previousActiveElement: HTMLElement | null = null;
    let currentVideoId = '';

    function renderChapters(_youtubeId: string, chaptersData?: any, activeSeconds?: number) {
      if (!chaptersContainer || !chaptersList) return;

      let chapters: any[] = [];
      if (typeof chaptersData === 'string' && chaptersData.trim().length > 0) {
        try {
          chapters = JSON.parse(chaptersData);
        } catch (e) {
          chapters = [];
        }
      } else if (Array.isArray(chaptersData)) {
        chapters = chaptersData;
      }

      if (chapters.length === 0) {
        chaptersContainer.classList.add('hidden');
        chaptersList.innerHTML = '';
        return;
      }

      chaptersContainer.classList.remove('hidden');
      chaptersList.innerHTML = '';

      chapters.forEach((chap) => {
        const sec = typeof chap.seconds === 'number' ? chap.seconds : parseInt(chap.seconds, 10) || 0;
        const btn = document.createElement('button');
        btn.type = 'button';
        const isActive = activeSeconds !== undefined && Math.abs(activeSeconds - sec) < 2;

        btn.className = `px-2.5 py-1 rounded text-xs font-sans transition-colors inline-flex items-center gap-1.5 shrink-0 cursor-pointer ${
          isActive
            ? 'bg-olive text-white font-bold ring-1 ring-white/30'
            : 'bg-white/10 hover:bg-olive/80 hover:text-white text-sand/90 font-medium'
        }`;

        const titleText = chap.titleTr || chap.titleEn || chap.title || '';
        const timeText = chap.time || '';

        btn.innerHTML = `<span>${titleText}</span><span class="font-mono text-[10px] opacity-75 bg-black/20 px-1 py-0.5 rounded">${timeText}</span>`;

        btn.addEventListener('click', (e) => {
          e.preventDefault();
          jumpToTime(sec, titleText, timeText);
        });

        chaptersList.appendChild(btn);
      });
    }

    function jumpToTime(seconds: number, chapterTitle?: string, chapterTime?: string) {
      if (!iframe || !currentVideoId) return;
      const startParam = seconds > 0 ? `&start=${seconds}` : '';
      iframe.src = `https://www.youtube-nocookie.com/embed/${encodeURIComponent(currentVideoId)}?autoplay=1&rel=0&modestbranding=1&enablejsapi=1${startParam}`;

      if (captionEl && chapterTitle) {
        captionEl.textContent = `${chapterTitle} (${chapterTime || ''})`;
      }

      // Update active state on chapter buttons
      if (chaptersList) {
        const btns = chaptersList.querySelectorAll('button');
        btns.forEach((b) => {
          b.classList.remove('bg-olive', 'text-white', 'font-bold', 'ring-1', 'ring-white/30');
          b.classList.add('bg-white/10', 'text-sand/90', 'font-medium');
        });
      }
    }

    function openModal(
      youtubeId: string,
      titleOrStartTime?: string | number,
      subtitleOrTitle?: string,
      startTimeParam?: number,
      chaptersData?: any
    ) {
      if (!youtubeId || !iframe) return;

      currentVideoId = youtubeId;
      previousActiveElement = document.activeElement as HTMLElement | null;

      let title = typeof titleOrStartTime === 'string' ? titleOrStartTime : undefined;
      let subtitle = subtitleOrTitle;
      let startTime = typeof titleOrStartTime === 'number' ? titleOrStartTime : startTimeParam;

      if (titleEl && title) {
        titleEl.textContent = title;
      }
      if (captionEl && subtitle) {
        captionEl.textContent = subtitle;
      }

      const sec = (typeof startTime === 'number' && startTime > 0) ? startTime : 0;
      const startParam = sec > 0 ? `&start=${encodeURIComponent(String(sec))}` : '';

      iframe.src = `https://www.youtube-nocookie.com/embed/${encodeURIComponent(youtubeId)}?autoplay=1&rel=0&modestbranding=1&enablejsapi=1${startParam}`;

      renderChapters(youtubeId, chaptersData, sec);

      backdrop?.classList.remove('opacity-0', 'pointer-events-none');
      backdrop?.classList.add('opacity-100');
      container?.classList.remove('scale-95');
      container?.classList.add('scale-100');
      document.body.style.overflow = 'hidden';

      closeBtn?.focus();
    }

    function closeModal() {
      if (iframe) {
        iframe.src = '';
      }
      currentVideoId = '';

      backdrop?.classList.add('opacity-0', 'pointer-events-none');
      backdrop?.classList.remove('opacity-100');
      container?.classList.add('scale-95');
      container?.classList.remove('scale-100');
      document.body.style.overflow = '';

      if (previousActiveElement && typeof previousActiveElement.focus === 'function') {
        previousActiveElement.focus();
      }
    }

    // Expose openVideoModal and closeVideoModal on window
    (window as any).openVideoModal = (
      youtubeId: string,
      startOrTitle?: number | string,
      subtitle?: string,
      startTime?: number,
      chapters?: any
    ) => {
      openModal(youtubeId, startOrTitle, subtitle, startTime, chapters);
    };

    (window as any).closeVideoModal = () => {
      closeModal();
    };

    // Listen for custom dispatch event
    window.addEventListener('open-video-modal', ((e: CustomEvent) => {
      if (e.detail) {
        openModal(
          e.detail.youtubeId || e.detail.videoId,
          e.detail.title || e.detail.startTime,
          e.detail.subtitle,
          e.detail.startTime,
          e.detail.chapters
        );
      }
    }) as EventListener);

    // Event delegation on data-youtube-id
    document.addEventListener('click', (e) => {
      const target = (e.target as HTMLElement).closest('[data-youtube-id]');
      if (target) {
        e.preventDefault();
        const youtubeId = target.getAttribute('data-youtube-id') || '';
        const title = target.getAttribute('data-video-title') || '';
        const subtitle = target.getAttribute('data-video-subtitle') || '';
        const startTimeStr = target.getAttribute('data-start-time') || target.getAttribute('data-start');
        const startTime = startTimeStr ? parseInt(startTimeStr, 10) : undefined;
        const chapters = target.getAttribute('data-chapters') || '';
        openModal(youtubeId, title, subtitle, startTime, chapters);
      }
    });

    closeBtn?.addEventListener('click', closeModal);
    backdrop.addEventListener('click', (e) => {
      if (e.target === backdrop) closeModal();
    });

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && backdrop.classList.contains('opacity-100')) {
        e.preventDefault();
        closeModal();
      }
    });
  }

  setupVideoModal();
  document.addEventListener('astro:page-load', setupVideoModal);
</script>
