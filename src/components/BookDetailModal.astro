---
import type { Lang } from '../utils/i18n';

export interface Props {
  lang?: Lang;
}

const { lang = 'tr' } = Astro.props;
---

<div
  id="book-modal-backdrop"
  class="fixed inset-0 z-50 bg-ink/80 backdrop-blur-sm flex items-center justify-center p-4 sm:p-6 opacity-0 pointer-events-none transition-opacity duration-300"
  role="dialog"
  aria-modal="true"
  aria-labelledby="book-modal-title"
>
  <div
    id="book-modal-container"
    class="w-full max-w-2xl bg-parchment border-2 border-olive rounded-xs shadow-2xl overflow-hidden flex flex-col transform scale-95 transition-transform duration-300 max-h-[90vh]"
  >
    <!-- Modal Header -->
    <div class="px-6 py-4 bg-olive text-white flex items-center justify-between border-b border-sand">
      <div class="flex items-center gap-2.5">
        <span class="material-symbols-outlined text-amber-200 text-2xl">menu_book</span>
        <div>
          <span class="text-[11px] font-mono tracking-widest uppercase text-white/80 block">
            {lang === 'tr' ? 'HALİKARNAS BALIKÇISI KÜLLİYATI' : 'HERITAGE COLLECTION'}
          </span>
          <h3 id="book-modal-title" class="font-serif font-bold text-lg sm:text-xl text-white leading-tight">
            Eser Detayı
          </h3>
        </div>
      </div>

      <button
        type="button"
        id="book-modal-close"
        class="p-1.5 rounded text-white/80 hover:text-white hover:bg-white/10 transition-colors cursor-pointer"
        aria-label="Kapat"
      >
        <span class="material-symbols-outlined text-2xl">close</span>
      </button>
    </div>

    <!-- Modal Content (Scrollable) -->
    <div class="p-6 overflow-y-auto space-y-6">
      <div class="grid grid-cols-1 sm:grid-cols-12 gap-6 items-start">
        
        <!-- Book Cover Image -->
        <div class="sm:col-span-5 flex flex-col items-center">
          <div class="aspect-[2/3] w-full max-w-[200px] bg-surface-container-high border-2 border-olive rounded-xs overflow-hidden shadow-md">
            <img
              id="book-modal-image"
              src=""
              alt=""
              class="w-full h-full object-cover"
            />
          </div>
          <div class="mt-3 text-center">
            <span id="book-modal-year" class="inline-block px-3 py-1 bg-olive/10 text-olive font-mono text-xs font-bold rounded-xs">
              İlk Basım: 1946
            </span>
          </div>
        </div>

        <!-- Book Details -->
        <div class="sm:col-span-7 space-y-4">
          <div>
            <h4 id="book-modal-heading" class="font-serif text-2xl font-bold text-ink leading-tight mb-1">
              Kitap Adı
            </h4>
            <div class="text-xs text-stone-gray font-sans font-medium">
              Yazar: <span class="text-ink font-bold font-serif">Cevat Şakir Kabaağaçlı</span>
            </div>
          </div>

          <div class="p-4 bg-surface-container-low border border-sand rounded-xs">
            <h5 class="text-xs font-sans font-bold uppercase tracking-wider text-olive mb-1.5">
              {lang === 'tr' ? 'Eser Özeti & Önemi' : 'Synopsis & Significance'}
            </h5>
            <p id="book-modal-summary" class="font-sans text-sm sm:text-base text-ink/90 leading-relaxed text-justify">
              Özet metni...
            </p>
          </div>

          <div class="p-3.5 bg-olive/5 border border-olive/20 rounded-xs flex items-start gap-2.5">
            <span class="material-symbols-outlined text-olive text-lg shrink-0 mt-0.5">verified</span>
            <div class="text-xs font-sans text-ink/80 leading-relaxed">
              {lang === 'tr'
                ? 'Bu eser, Bodrum Kent Kütüphanesi Arşivi ve Nadir Eserler Odası bünyesinde korunmakta olup araştırmacıların ziyaretine açıktır.'
                : 'This volume is preserved within the Bodrum City Library Heritage Archive and is available for research.'}
            </div>
          </div>
        </div>

      </div>
    </div>

    <!-- Modal Footer Actions -->
    <div class="px-6 py-4 bg-surface-container-high border-t border-sand flex flex-col sm:flex-row items-center justify-between gap-3">
      <span class="text-xs font-sans text-stone-gray text-center sm:text-left">
        {lang === 'tr' ? 'Kütüphane Yerleşkesi: Kızılağaç, Bodrum' : 'Location: Kizilagac, Bodrum'}
      </span>

      <button
        type="button"
        id="book-modal-reserve-btn"
        class="w-full sm:w-auto px-6 py-2.5 bg-olive hover:bg-bodrum-blue-dark text-white font-sans font-bold text-xs uppercase tracking-wider rounded-xs transition-colors shadow-xs flex items-center justify-center gap-1.5 cursor-pointer"
      >
        <span class="material-symbols-outlined text-base">local_library</span>
        <span>{lang === 'tr' ? 'Kütüphanede İnceleme Talebi' : 'Request for Archival Access'}</span>
      </button>
    </div>
  </div>
</div>

<script>
  function setupBookModal() {
    const backdrop = document.getElementById('book-modal-backdrop');
    const container = document.getElementById('book-modal-container');
    const closeBtn = document.getElementById('book-modal-close');
    const imgEl = document.getElementById('book-modal-image') as HTMLImageElement | null;
    const yearEl = document.getElementById('book-modal-year');
    const headingEl = document.getElementById('book-modal-heading');
    const summaryEl = document.getElementById('book-modal-summary');
    const reserveBtn = document.getElementById('book-modal-reserve-btn');

    if (!backdrop || !container) return;

    function openModal(title: string, year: string, summary: string, image: string) {
      if (headingEl) headingEl.textContent = title;
      if (yearEl) yearEl.textContent = `İlk Basım: ${year}`;
      if (summaryEl) summaryEl.textContent = summary;
      if (imgEl) {
        imgEl.src = image;
        imgEl.alt = title;
      }

      backdrop?.classList.remove('opacity-0', 'pointer-events-none');
      backdrop?.classList.add('opacity-100');
      container?.classList.remove('scale-95');
      container?.classList.add('scale-100');
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      backdrop?.classList.add('opacity-0', 'pointer-events-none');
      backdrop?.classList.remove('opacity-100');
      container?.classList.add('scale-95');
      container?.classList.remove('scale-100');
      document.body.style.overflow = '';
    }

    document.addEventListener('click', (e) => {
      const target = (e.target as HTMLElement).closest('[data-book-card]');
      if (target) {
        e.preventDefault();
        const title = target.getAttribute('data-book-title') || '';
        const year = target.getAttribute('data-book-year') || '';
        const summary = target.getAttribute('data-book-summary') || '';
        const image = target.getAttribute('data-book-image') || '';
        openModal(title, year, summary, image);
      }
    });

    closeBtn?.addEventListener('click', closeModal);
    backdrop.addEventListener('click', (e) => {
      if (e.target === backdrop) closeModal();
    });

    if (reserveBtn) {
      reserveBtn.addEventListener('click', () => {
        closeModal();
        if ((window as any).showToast) {
          (window as any).showToast(
            'Arşiv inceleme talebiniz alındı! Kütüphane ekibimiz yerinde inceleme randevunuz için sizinle iletişime geçecektir.',
            'success',
            5000
          );
        }
      });
    }

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && backdrop.classList.contains('opacity-100')) {
        e.preventDefault();
        closeModal();
      }
    });
  }

  setupBookModal();
  document.addEventListener('astro:page-load', setupBookModal);
</script>
