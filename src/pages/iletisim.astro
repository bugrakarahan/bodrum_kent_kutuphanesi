---
import Layout from '../layouts/Layout.astro';
import { getT } from '../utils/i18n';

const lang = 'tr';
const t = getT(lang);
---

<Layout
  title={`İletişim | ${t.siteTitle}`}
  description="Bodrum Kent Kütüphanesi iletişim bilgileri, yerleşke konumu, telefon, e-posta ve mesaj formu."
  lang={lang}
  currentPath="/iletisim"
>
  <!-- Hero Header (Standardized Scale) -->
  <section class="py-6 md:py-10 px-5 md:px-12 bg-surface-bright border-b border-sand">
    <div class="max-w-[1280px] mx-auto">
      <div class="max-w-3xl">
        <h1 class="font-serif text-xl sm:text-2xl text-ink font-bold leading-snug mb-2">
          İletişim & Yerleşke
        </h1>
        <p class="font-sans text-xs sm:text-sm text-ink/80 leading-relaxed">
          Kütüphanemizi ziyaret etmek, etkinliklerimize katılmak ve sorularınızı iletmek için bizimle iletişime geçebilirsiniz.
        </p>
      </div>
    </div>
  </section>

  <!-- Content Grid: Perfectly Aligned Bottom Lines via items-stretch -->
  <div class="max-w-[1280px] mx-auto px-5 md:px-12 py-6 md:py-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-stretch">
      
      <!-- Left Column: Kütüphane Bilgileri -->
      <div class="lg:col-span-5 flex flex-col justify-between space-y-4">
        <div>
          <span class="text-[11px] uppercase tracking-widest text-olive font-sans font-bold block mb-1">DOĞRUDAN İLETİŞİM</span>
          <h2 class="font-serif text-base sm:text-lg text-ink font-bold leading-snug mb-1.5">
            Kütüphane Bilgileri
          </h2>
          <p class="font-sans text-xs text-ink/85 leading-relaxed">
            Ziyaret etmek, kitaplarla buluşmak, tanışmak için ve sorularınızı iletmek için iletişim kanallarımızdan bize ulaşabilirsiniz.
          </p>
        </div>

        <div class="space-y-3 font-sans flex-1 flex flex-col justify-between">
          
          <!-- GSM & Telefon -->
          <div class="p-3.5 sm:p-4 bg-surface-container-low border-2 border-olive rounded-xs flex items-start gap-3 shadow-xs">
            <div class="w-8 h-8 rounded-full bg-olive text-white flex items-center justify-center shrink-0 mt-0.5 shadow-2xs">
              <span class="material-symbols-outlined text-base">call</span>
            </div>
            <div>
              <div class="text-[10px] uppercase tracking-wider text-stone-gray font-bold">GSM / Telefon</div>
              <a href="tel:+905423739748" class="text-ink text-xs sm:text-sm font-bold hover:text-olive transition-colors block mt-0.5">
                +90 (0) 542 373 97 48
              </a>
            </div>
          </div>

          <!-- E-Posta -->
          <div class="p-3.5 sm:p-4 bg-surface-container-low border-2 border-olive rounded-xs flex items-start gap-3 shadow-xs">
            <div class="w-8 h-8 rounded-full bg-olive text-white flex items-center justify-center shrink-0 mt-0.5 shadow-2xs">
              <span class="material-symbols-outlined text-base">mail</span>
            </div>
            <div>
              <div class="text-[10px] uppercase tracking-wider text-stone-gray font-bold">E-Posta</div>
              <a href="mailto:bilgi@bodrumkentkutuphanesi.org" class="text-ink text-xs sm:text-sm font-bold hover:text-olive transition-colors break-all block mt-0.5">
                bilgi@bodrumkentkutuphanesi.org
              </a>
            </div>
          </div>

          <!-- Yerleşke & Konum -->
          <div class="p-3.5 sm:p-4 bg-surface-container-low border-2 border-olive rounded-xs flex items-start gap-3 shadow-xs">
            <div class="w-8 h-8 rounded-full bg-olive text-white flex items-center justify-center shrink-0 mt-0.5 shadow-2xs">
              <span class="material-symbols-outlined text-base">location_on</span>
            </div>
            <div>
              <div class="text-[10px] uppercase tracking-wider text-stone-gray font-bold">Yerleşke & Konum</div>
              <p class="text-ink text-xs sm:text-sm font-bold mt-0.5">Kızılağaç, Bodrum / Muğla</p>
              <p class="text-[11px] text-stone-gray mt-0.5">Salı – Pazar: 10:00 – 19:00 (Pazartesi kapalıdır)</p>
            </div>
          </div>

          <!-- Sosyal Medya Kanalları (Bottom Box) -->
          <div class="p-3.5 sm:p-4 bg-surface-container-low border-2 border-olive rounded-xs shadow-xs">
            <div class="text-[10px] uppercase tracking-wider text-stone-gray font-bold mb-2">
              Sosyal Medya & İletişim Kanallarımız
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-2">
              <a
                href="https://wa.me/905423739748"
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center justify-center gap-1.5 p-2 bg-parchment border border-olive text-ink hover:bg-olive hover:text-white transition-colors text-[11px] font-bold uppercase rounded-xs"
              >
                <span class="material-symbols-outlined text-sm text-olive group-hover:text-white">chat</span>
                <span>WhatsApp</span>
              </a>

              <a
                href="https://instagram.com"
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center justify-center gap-1.5 p-2 bg-parchment border border-olive text-ink hover:bg-olive hover:text-white transition-colors text-[11px] font-bold uppercase rounded-xs"
              >
                <span class="material-symbols-outlined text-sm text-olive group-hover:text-white">photo_camera</span>
                <span>Instagram</span>
              </a>

              <a
                href="https://youtube.com"
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center justify-center gap-1.5 p-2 bg-parchment border border-olive text-ink hover:bg-olive hover:text-white transition-colors text-[11px] font-bold uppercase rounded-xs"
              >
                <span class="material-symbols-outlined text-sm text-olive group-hover:text-white">smart_display</span>
                <span>YouTube</span>
              </a>
            </div>
          </div>

        </div>
      </div>

      <!-- Right Column: İletişim & Mesaj Formu (Matching height & end line) -->
      <div class="lg:col-span-7 bg-surface-container-low border-2 border-olive rounded-xs p-5 sm:p-7 shadow-xs flex flex-col justify-between">
        <div>
          <h3 class="font-serif text-base sm:text-lg text-ink font-bold mb-1">
            Bize Mesaj Gönderin
          </h3>
          <p class="font-sans text-xs text-ink/85 mb-4">
            Görüş, öneri veya bilgi taleplerinizi iletebilirsiniz. En kısa sürede yanıtlanacaktır.
          </p>

          <form id="contact-form" class="space-y-3 font-sans">
            <div>
              <label class="block text-[11px] font-bold text-ink uppercase tracking-wider mb-0.5">Ad Soyad *</label>
              <input 
                type="text" 
                required 
                placeholder="Adınız Soyadınız"
                class="w-full px-3 py-1.5 bg-parchment border border-sand text-ink text-xs focus:outline-none focus:border-olive rounded-xs" 
              />
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div>
                <label class="block text-[11px] font-bold text-ink uppercase tracking-wider mb-0.5">E-Posta *</label>
                <input 
                  type="email" 
                  required 
                  placeholder="ornek@alanadi.com"
                  class="w-full px-3 py-1.5 bg-parchment border border-sand text-ink text-xs focus:outline-none focus:border-olive rounded-xs" 
                />
              </div>
              <div>
                <label class="block text-[11px] font-bold text-ink uppercase tracking-wider mb-0.5">Telefon</label>
                <input 
                  type="tel" 
                  placeholder="05XX XXX XX XX"
                  class="w-full px-3 py-1.5 bg-parchment border border-sand text-ink text-xs focus:outline-none focus:border-olive rounded-xs" 
                />
              </div>
            </div>

            <div>
              <label class="block text-[11px] font-bold text-ink uppercase tracking-wider mb-0.5">Konu</label>
              <input 
                type="text" 
                placeholder="Mesajınızın konusu..."
                class="w-full px-3 py-1.5 bg-parchment border border-sand text-ink text-xs focus:outline-none focus:border-olive rounded-xs" 
              />
            </div>

            <div>
              <label class="block text-[11px] font-bold text-ink uppercase tracking-wider mb-0.5">Mesajınız *</label>
              <textarea 
                rows="5" 
                required 
                placeholder="Mesajınızı buraya yazınız..."
                class="w-full px-3 py-1.5 bg-parchment border border-sand text-ink text-xs focus:outline-none focus:border-olive rounded-xs"
              ></textarea>
            </div>

            <button 
              type="submit" 
              class="w-full py-2.5 bg-olive text-white hover:bg-bodrum-blue-dark text-xs font-sans font-bold tracking-wider uppercase transition-colors shadow-xs rounded-xs cursor-pointer mt-1"
            >
              Mesajı Gönder
            </button>
          </form>
        </div>
      </div>

    </div>
  </div>
</Layout>

<script>
  const contactForm = document.getElementById('contact-form');
  if (contactForm) {
    contactForm.addEventListener('submit', (e) => {
      e.preventDefault();
      if ((window as any).showToast) {
        (window as any).showToast(
          'Mesajınız başarıyla iletildi! Kütüphane ekibimiz en kısa sürede size dönüş yapacaktır.',
          'success',
          5000
        );
      }
      (contactForm as HTMLFormElement).reset();
    });
  }
</script>
