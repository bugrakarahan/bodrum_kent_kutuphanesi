---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { getT } from '../utils/i18n';

const lang = 'tr';
const t = getT(lang);

const allEvents = await getCollection('events');
const upcomingEvents = allEvents.filter((e) => !e.data.isPast);
const pastEvents = allEvents.filter((e) => e.data.isPast);

const pastEventCategories = [
  "TÜMÜ", "EDEBİYAT", "KÜLTÜR", "SANAT", "TARİH", "FELSEFE", "ARKEOLOJİ", "SOSYOLOJİ", "PSİKOLOJİ", "EKOLOJİ", "BİLİM"
];
---

<Layout
  title={`Etkinlikler | ${t.siteTitle}`}
  description="Bodrum Kent Kütüphanesi etkinlikleri, kitap kulübü, söyleşi ve atölye buluşmaları."
  lang={lang}
  currentPath="/etkinlikler"
>
  <!-- Hero Header (Standardized Scale) -->
  <section class="py-6 md:py-10 px-5 md:px-12 bg-surface-bright border-b border-sand">
    <div class="max-w-[1280px] mx-auto">
      <div class="max-w-3xl">
        <h1 class="font-serif text-xl sm:text-2xl text-ink font-bold leading-snug mb-2">
          Bilginin ve Sanatın Işığında Etkinlikler
        </h1>
        <p class="font-sans text-xs sm:text-sm text-ink/80 leading-relaxed">
          Edebiyat, Tarih, Arkeoloji, Antik Tarih, Felsefe, Sosyoloji, Psikoloji, Sanat,… etkinliklerimize katılımlarınızı bekliyoruz…
        </p>
      </div>
    </div>
  </section>

  <!-- Main Content Area -->
  <div class="max-w-[1280px] mx-auto px-5 md:px-12 py-6 md:py-10 space-y-10">
    
    <!-- Gelecek Etkinlikler Section -->
    <section>
      <h2 class="font-serif text-lg sm:text-xl text-ink font-bold mb-4 pb-2 border-b border-sand">
        Gelecek Etkinlikler
      </h2>

      {upcomingEvents.map((event) => (
        <div class="bg-surface-container-low border-2 border-olive p-4 sm:p-6 shadow-xs rounded-xs">
          <div>
            <div class="inline-block px-2.5 py-0.5 bg-olive text-white text-[11px] font-sans uppercase tracking-widest font-bold mb-2.5 rounded-xs">
              {event.data.categoryLabelTr}
            </div>

            <h3 class="font-serif text-base sm:text-lg text-ink font-bold leading-snug mb-3.5">
              {event.data.title}
            </h3>

            <!-- Kitap Kulübü Metin & Canva Görseli -->
            <div class="space-y-3 text-ink/90 font-sans text-xs sm:text-[13px] leading-relaxed text-justify">
              <p>
                Zihinleri ve düşünce yapılarını zorlayan, ezber bozan, farklı bir kitap kulübü olmayı hedefliyoruz. Seçeceğimiz kitaplar ve bu kitaplardan yola çıkarak konuşacağımız konular da aynı şekilde farklı, sorgulayıcı ve düşündürücü olacak.
              </p>
              
              <p>
                Burada herkesin aynı şeyi düşündüğü bir sohbet değil, farklı düşüncelerin ve görüşlerin çarpıştığı, sağlam tartışmaların yaşandığı bir ortam istiyoruz. Çünkü iyi bir kitap, yalnızca okunup biten değil, zihnimizde yeni sorular bırakan kitaptır.
              </p>

              <!-- Canva Kitap Kulübü Görseli -->
              <div class="my-4 max-w-md mx-auto bg-parchment border-2 border-olive p-2 rounded-xs shadow-md">
                <div class="aspect-[16/10] overflow-hidden bg-surface-container-high relative border border-sand/60 rounded-2xs">
                  <img
                    src={event.data.image}
                    alt="Bodrum Kent Kütüphanesi Kitap Kulübü"
                    class="w-full h-full object-cover"
                  />
                </div>
                <div class="pt-1.5 text-center text-[11px] text-stone-gray font-sans italic">
                  Bodrum Kent Kütüphanesi • Kitap Kulübü Buluşmaları
                </div>
              </div>

              <p>
                Tartışmalarımızın sonunda belki daha önce hiç düşünmediğimiz bir şeyi düşünecek, belki bir fikrimizi değiştirecek, belki de dünyaya başka bir pencereden bakmaya başlayacağız. Kısacası, yalnızca kitapları değil, düşüncelerimizi de masaya yatıracağız.
              </p>

              <p class="font-bold text-olive">
                Değişmeye, sorgulamaya ve birlikte düşünmeye hazırsanız, sizi Kitap Kulübümüze bekliyoruz!
              </p>
            </div>

            <!-- Action & Notice with Add to Calendar & WhatsApp -->
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pt-4 mt-4 border-t border-sand">
              <div class="flex flex-wrap items-center gap-2.5">
                <a
                  href="https://wa.me/905423739748?text=Merhaba,%20Bodrum%20Kent%20K%C3%BCt%C3%BCphanesi%20Kitap%20Kul%C3%BCb%C3%BCne%20kat%C4%B1lmak%20istiyorum."
                  target="_blank"
                  rel="noopener noreferrer"
                  class="px-4 py-2 bg-olive hover:bg-bodrum-blue-dark text-white text-xs font-sans font-bold tracking-wider uppercase transition-colors shadow-xs shrink-0 rounded-xs inline-flex items-center gap-1.5"
                >
                  <span class="material-symbols-outlined text-sm">chat</span>
                  <span>KİTAP KULÜBÜMÜZE KATILIN</span>
                </a>

                <a
                  href="https://calendar.google.com/calendar/render?action=TEMPLATE&text=Bodrum+Kent+K%C3%BCt%C3%BCphanesi+Kitap+Kul%C3%BCb%C3%BC&details=Bodrum+Kent+K%C3%BCt%C3%BCphanesi+Kitap+Kul%C3%BCb%C3%BC+Bulu%C5%9Fmas%C4%B1&location=K%C4%B1z%C4%B1la%C4%9Fa%C3%A7%2C+Bodrum"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="px-3.5 py-2 bg-parchment border border-olive text-olive hover:bg-olive hover:text-white text-xs font-sans font-bold tracking-wider uppercase transition-colors shadow-xs shrink-0 rounded-xs inline-flex items-center gap-1"
                  title="Google Takvime Hatırlatıcı Ekle"
                >
                  <span class="material-symbols-outlined text-sm">calendar_add_on</span>
                  <span>Google Takvime Ekle</span>
                </a>
              </div>

              <span class="text-[11px] sm:text-xs font-sans italic text-ink/80 leading-snug">
                Duyuru ve ilk buluşma tarihi, Instagram hesabımız ve WhatsApp Kanalımızda paylaşılmıştır.
              </span>
            </div>
          </div>
        </div>
      ))}
    </section>

    <!-- Geçmiş Etkinlikler Section -->
    <section>
      <h2 class="font-serif text-lg sm:text-xl text-ink font-bold mb-3 pb-2 border-b border-sand">
        Geçmiş Etkinlikler
      </h2>

      <!-- Topic Badges: Centered -->
      <div class="flex flex-wrap items-center justify-center gap-1.5 mb-5 text-[11px] font-sans font-bold pt-1">
        {pastEventCategories.map((cat, idx) => (
          <span class={`px-2.5 py-1 uppercase tracking-wider rounded-xs transition-colors shadow-2xs ${
            idx === 0
              ? 'bg-olive text-white ring-2 ring-olive/40'
              : 'bg-olive text-white hover:bg-bodrum-blue-dark'
          }`}>
            {cat}
          </span>
        ))}
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {pastEvents.map((event) => (
          <div class="bg-surface-container-low border-2 border-olive p-3.5 sm:p-4 flex flex-col justify-between shadow-xs rounded-xs">
            <div>
              <!-- 1-Afis Main Image with Click-to-Open Gallery Modal -->
              <div 
                class="aspect-[16/10] overflow-hidden bg-surface-container-high mb-3 border border-sand rounded-2xs cursor-pointer group relative"
                data-gallery-trigger
                data-gallery-title={event.data.title}
                data-gallery-photos={JSON.stringify(event.data.photos || [event.data.image])}
              >
                <img
                  src={event.data.image}
                  alt={event.data.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                />
                <div class="absolute inset-0 bg-black/30 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center text-white text-xs font-sans font-bold uppercase tracking-wider gap-1">
                  <span class="material-symbols-outlined text-sm">photo_library</span>
                  <span>Fotoğrafları Gör</span>
                </div>
              </div>

              <div class="flex items-center justify-between text-[11px] text-stone-gray font-mono mb-1.5">
                <span class="text-olive font-sans font-bold text-[11px] uppercase">{event.data.categoryLabelTr}</span>
                <span class="font-bold">{event.data.displayDateTr}</span>
              </div>

              <h3 class="font-serif text-sm sm:text-base text-ink font-bold mb-2 leading-snug text-center">
                Antropolog & Arkeolog<br />
                <span class="text-olive font-bold">Timuçin Binder ile</span><br />
                Antik Çağ Ege’sinin Gökyüzü Mitleri
              </h3>

              <div class="text-xs text-ink/85 font-sans leading-relaxed mb-3 space-y-1.5 whitespace-pre-line text-justify">
                {event.data.summaryTr}
              </div>
            </div>

            <div class="flex items-center justify-center gap-2 pt-2.5 border-t border-sand">
              <button
                type="button"
                class="btn-event-detail px-3 py-1 bg-olive text-white hover:bg-bodrum-blue-dark text-[11px] font-sans font-bold uppercase tracking-wider transition-colors rounded-xs shadow-2xs cursor-pointer"
                data-title={event.data.title}
                data-summary={event.data.summaryTr}
              >
                Detay
              </button>

              <button
                type="button"
                class="btn-event-gallery px-3 py-1 bg-parchment border border-olive text-olive hover:bg-olive hover:text-white text-[11px] font-sans font-bold uppercase tracking-wider transition-colors rounded-xs shadow-2xs cursor-pointer inline-flex items-center gap-1"
                data-gallery-trigger
                data-gallery-title={event.data.title}
                data-gallery-photos={JSON.stringify(event.data.photos || [event.data.image])}
              >
                <span class="material-symbols-outlined text-xs">photo_library</span>
                <span>Fotoğraflar</span>
              </button>
            </div>
          </div>
        ))}
      </div>
    </section>

  </div>
</Layout>

<script>
  document.querySelectorAll('.btn-event-detail').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      const target = e.currentTarget as HTMLElement;
      const title = target.getAttribute('data-title');
      const summary = target.getAttribute('data-summary');
      alert(`${title}\n\n${summary}`);
    });
  });
</script>
