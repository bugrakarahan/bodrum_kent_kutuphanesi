---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { getT } from '../utils/i18n';

const lang = 'tr';
const t = getT(lang);

const allEvents = await getCollection('events');
const upcomingEvents = allEvents.filter((e) => !e.data.isPast);
const pastEvents = allEvents.filter((e) => e.data.isPast);

const pastEventCategories = [
  "TÜMÜ", "EDEBİYAT", "KÜLTÜR", "SANAT", "TARİH", "FELSEFE", "ARKEOLOJİ", "SOSYOLOJİ", "PSİKOLOJİ", "EKOLOJİ", "BİLİM"
];
---

<Layout
  title={`Etkinlikler | ${t.siteTitle}`}
  description="Bodrum Kent Kütüphanesi etkinlikleri, kitap kulübü, söyleşi ve atölye buluşmaları."
  lang={lang}
  currentPath="/etkinlikler"
>
  <!-- Hero Header (Standardized Scale) -->
  <section class="py-6 md:py-10 px-5 md:px-12 bg-surface-bright border-b border-sand">
    <div class="max-w-[1280px] mx-auto">
      <div class="max-w-3xl">
        <h1 class="font-serif text-xl sm:text-2xl text-ink font-bold leading-snug mb-2">
          Bilginin ve Sanatın Işığında Etkinlikler
        </h1>
        <p class="font-sans text-xs sm:text-sm text-ink/80 leading-relaxed">
          Edebiyat, Tarih, Arkeoloji, Antik Tarih, Felsefe, Sosyoloji, Psikoloji, Sanat,… etkinliklerimize katılımlarınızı bekliyoruz…
        </p>
      </div>
    </div>
  </section>

  <!-- Main Content Area -->
  <div class="max-w-[1280px] mx-auto px-5 md:px-12 py-6 md:py-10 space-y-12">
    
    <!-- 1. Gelecek Etkinlikler Section (Birebir Önceki Beğenilen Haline Geri Getirildi) -->
    <section>
      <h2 class="font-serif text-lg sm:text-xl text-ink font-bold mb-4 pb-2 border-b border-sand">
        Gelecek Etkinlikler
      </h2>

      <div class="max-w-2xl mx-auto space-y-6">
        {upcomingEvents.map((event) => {
          const eventPayload = JSON.stringify({
            title: event.data.title,
            category: event.data.categoryLabelTr,
            date: event.data.date,
            displayDate: event.data.displayDateTr,
            location: event.data.locationTr,
            summary: event.data.summaryTr,
            image: event.data.image,
            photos: event.data.photos || []
          });

          return (
            <div class="bg-surface-container-low border-2 border-olive p-5 sm:p-6 shadow-xs rounded-xs">
              <div class="space-y-4">
                
                <!-- Category Badge & Date -->
                <div class="flex items-center justify-between gap-2 border-b border-sand pb-3">
                  <span class="inline-block px-2.5 py-0.5 bg-olive text-white text-[11px] font-sans uppercase tracking-widest font-bold rounded-2xs">
                    {event.data.categoryLabelTr}
                  </span>
                  <span class="text-xs font-mono text-stone-gray font-bold">
                    {event.data.displayDateTr}
                  </span>
                </div>

                <!-- Event Title -->
                <h3 class="font-serif text-lg sm:text-xl text-ink font-bold leading-snug text-center sm:text-left">
                  {event.data.title}
                </h3>

                <!-- Descriptive Editorial Body -->
                <div class="space-y-3 text-ink/90 font-sans text-xs sm:text-[13px] leading-relaxed text-justify">
                  <p>
                    Zihinleri ve düşünce yapılarını zorlayan, ezber bozan, farklı bir kitap kulübü olmayı hedefliyoruz. Seçeceğimiz kitaplar ve bu kitaplardan yola çıkarak konuşacağımız konular da aynı şekilde farklı, sorgulayıcı ve düşündürücü olacak.
                  </p>
                  <p>
                    Burada herkesin aynı şeyi düşündüğü bir sohbet değil, farklı düşüncelerin ve görüşlerin çarpıştığı, sağlam tartışmaların yaşandığı bir ortam istiyoruz. Çünkü iyi bir kitap, yalnızca okunup biten değil, zihnimizde yeni sorular bırakan kitaptır.
                  </p>

                  <!-- Dikey 3:4 Canva Görseli Ortalanmış ve Boyutlandırılmış -->
                  <div class="mt-4 mb-2 flex flex-col items-center">
                    <div 
                      class="w-full max-w-[280px] sm:max-w-[320px] aspect-[3/4] bg-parchment border-2 border-olive p-1.5 rounded-xs shadow-sm cursor-pointer group"
                      data-event-detail-trigger
                      data-event-data={eventPayload}
                      title="Etkinlik Detaylarını ve Takvim Seçeneklerini Görüntüle"
                    >
                      <div class="w-full h-full overflow-hidden bg-surface-container-high relative border border-sand/60 rounded-2xs flex items-center justify-center">
                        <img
                          src={event.data.image}
                          alt="Bodrum Kent Kütüphanesi Kitap Kulübü"
                          class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-300"
                        />
                      </div>
                      <div class="pt-1.5 text-center text-[11px] text-stone-gray font-sans italic flex items-center justify-center gap-1">
                        <span>Bodrum Kent Kütüphanesi • Kitap Kulübü</span>
                        <span class="material-symbols-outlined text-xs text-olive">open_in_new</span>
                      </div>
                    </div>
                  </div>

                  <!-- Fotoğraf alt yazısından sonra tam 1/2 cm (~19px) boşluk -->
                  <p class="!mt-5">
                    Tartışmalarımızın sonunda belki daha önce hiç düşünmediğimiz bir şeyi düşünecek, belki bir fikrimizi değiştirecek, belki de dünyaya başka bir pencereden bakmaya başlayacağız. Kısacası, yalnızca kitapları değil, düşüncelerimizi de masaya yatıracağız.
                  </p>

                  <p class="font-bold text-olive">
                    Değişmeye, sorgulamaya ve birlikte düşünmeye hazırsanız, sizi Kitap Kulübümüze bekliyoruz!
                  </p>
                </div>

                <!-- Action Buttons & Notice -->
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pt-4 mt-4 border-t border-sand">
                  <div class="flex flex-wrap items-center gap-2">
                    <a
                      href="https://wa.me/905423739748?text=Merhaba,%20Bodrum%20Kent%20K%C3%BCt%C3%BCphanesi%20Kitap%20Kul%C3%BCb%C3%BCne%20kat%C4%B1lmak%20istiyorum."
                      target="_blank"
                      rel="noopener noreferrer"
                      class="px-3.5 py-2 bg-olive hover:bg-bodrum-blue-dark text-white text-xs font-sans font-bold tracking-wider uppercase transition-colors shadow-xs shrink-0 rounded-xs inline-flex items-center gap-1.5"
                    >
                      <span class="material-symbols-outlined text-sm">chat</span>
                      <span>KİTAP KULÜBÜMÜZE KATILIN</span>
                    </a>

                    <!-- Detay & Takvim Trigger -->
                    <button
                      type="button"
                      class="px-3.5 py-2 bg-parchment border border-olive text-olive hover:bg-olive hover:text-white text-xs font-sans font-bold tracking-wider uppercase transition-colors shadow-xs shrink-0 rounded-xs inline-flex items-center gap-1 cursor-pointer"
                      data-event-detail-trigger
                      data-event-data={eventPayload}
                    >
                      <span class="material-symbols-outlined text-sm">calendar_month</span>
                      <span>Takvime Ekle / Detay</span>
                    </button>
                  </div>

                  <span class="text-[11px] sm:text-xs font-sans italic text-ink/80 leading-snug">
                    Duyuru ve ilk buluşma tarihi Instagram ve WhatsApp Kanalımızda paylaşılacaktır.
                  </span>
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </section>

    <!-- 2. Geçmiş Etkinlikler Section (Sola Yerleştirilmiş Dikey 3:4 Kart ve Fotoğraf) -->
    <section>
      <h2 class="font-serif text-lg sm:text-xl text-ink font-bold mb-3 pb-2 border-b border-sand">
        Geçmiş Etkinlikler
      </h2>

      <!-- Topic Badges: Centered -->
      <div class="flex flex-wrap items-center justify-center gap-1.5 mb-6 text-[11px] font-sans font-bold pt-1">
        {pastEventCategories.map((cat, idx) => (
          <span class={`px-2.5 py-1 uppercase tracking-wider rounded-xs transition-colors shadow-2xs ${
            idx === 0
              ? 'bg-olive text-white ring-2 ring-olive/40'
              : 'bg-olive text-white hover:bg-bodrum-blue-dark'
          }`}>
            {cat}
          </span>
        ))}
      </div>

      <!-- 3 Sütunlu Izgara (Sola Yaslı, Yeni Etkinlikler Sağına Eklenecek) -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {pastEvents.map((event) => {
          const eventPayload = JSON.stringify({
            title: event.data.title,
            category: event.data.categoryLabelTr,
            date: event.data.date,
            displayDate: event.data.displayDateTr,
            location: event.data.locationTr,
            summary: event.data.summaryTr,
            image: event.data.image,
            photos: event.data.photos || []
          });

          return (
            <div class="bg-surface-container-low border-2 border-olive p-4 sm:p-5 flex flex-col justify-between shadow-xs rounded-xs w-full max-w-[360px]">
              <div>
                <!-- Dikey 3:4 Afiş Fotoğrafı -->
                <div 
                  class="aspect-[3/4] w-full overflow-hidden bg-surface-container-high border-2 border-olive rounded-xs mb-3 cursor-pointer group relative shadow-sm"
                  data-gallery-trigger
                  data-gallery-title={event.data.title}
                  data-gallery-photos={JSON.stringify(event.data.photos || [event.data.image])}
                  title="11 Fotoğraflı Galeriyi İnceleyin"
                >
                  <img
                    src={event.data.image}
                    alt={event.data.title}
                    class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-300"
                  />
                  <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center text-white text-xs font-sans font-bold uppercase tracking-wider gap-1.5 p-2 text-center">
                    <span class="material-symbols-outlined text-base">photo_library</span>
                    <span>Fotoğrafları Gör (11)</span>
                  </div>
                </div>

                <div class="flex items-center justify-between text-[11px] text-stone-gray font-mono mb-2">
                  <span class="text-olive font-sans font-bold text-xs uppercase">{event.data.categoryLabelTr}</span>
                  <span class="font-bold">{event.data.displayDateTr}</span>
                </div>

                <h3 class="font-serif text-base sm:text-lg text-ink font-bold mb-2 leading-snug text-center">
                  Antropolog & Arkeolog<br />
                  <span class="text-olive font-bold">Timuçin Binder ile</span><br />
                  Antik Çağ Ege’sinin Gökyüzü Mitleri
                </h3>

                <p class="text-xs text-ink/85 font-sans leading-relaxed text-justify mb-3 line-clamp-4">
                  Antik Çağ Ege gökyüzü mitolojisi, yıldızlar, takımyıldızlar ve antik denizcilerin yön bulma kadim bilgeliği üzerine söyleşi ve atölye buluşması.
                </p>
              </div>

              <!-- Action Bar -->
              <div class="flex items-center justify-center gap-2 pt-3 border-t border-sand">
                <button
                  type="button"
                  class="flex-1 py-2 bg-olive text-white hover:bg-bodrum-blue-dark text-xs font-sans font-bold uppercase tracking-wider transition-colors rounded-xs shadow-2xs cursor-pointer inline-flex items-center justify-center gap-1"
                  data-event-detail-trigger
                  data-event-data={eventPayload}
                >
                  <span class="material-symbols-outlined text-sm">event_note</span>
                  <span>Detay & Bilgi</span>
                </button>

                <button
                  type="button"
                  class="flex-1 py-2 bg-parchment border border-olive text-olive hover:bg-olive hover:text-white text-xs font-sans font-bold uppercase tracking-wider transition-colors rounded-xs shadow-2xs cursor-pointer inline-flex items-center justify-center gap-1"
                  data-gallery-trigger
                  data-gallery-title={event.data.title}
                  data-gallery-photos={JSON.stringify(event.data.photos || [event.data.image])}
                >
                  <span class="material-symbols-outlined text-sm">photo_library</span>
                  <span>Fotoğraflar (11)</span>
                </button>
              </div>
            </div>
          );
        })}
      </div>
    </section>

  </div>
</Layout>
