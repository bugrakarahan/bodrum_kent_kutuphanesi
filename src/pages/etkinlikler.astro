---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { getT } from '../utils/i18n';

const lang = 'tr';
const t = getT(lang);

const allEvents = await getCollection('events');
const upcomingEvents = allEvents.filter((e) => !e.data.isPast);
const pastEvents = allEvents.filter((e) => e.data.isPast);

const pastEventCategories = [
  "TÜMÜ", "EDEBİYAT", "KÜLTÜR", "SANAT", "TARİH", "FELSEFE", "ARKEOLOJİ", "SOSYOLOJİ", "PSİKOLOJİ", "EKOLOJİ", "BİLİM"
];
---

<Layout
  title={`Etkinlikler | ${t.siteTitle}`}
  description="Bodrum Kent Kütüphanesi etkinlikleri, kitap kulübü, söyleşi ve atölye buluşmaları."
  lang={lang}
  currentPath="/etkinlikler"
>
  <!-- Hero Header -->
  <section class="py-16 md:py-24 px-5 md:px-12 bg-surface-bright border-b border-sand">
    <div class="max-w-[1280px] mx-auto">
      <div class="max-w-3xl">
        <h1 class="font-serif text-3xl sm:text-4xl md:text-5xl text-ink font-bold leading-tight mb-4">
          Bilginin ve Sanatın Işığında Etkinlikler
        </h1>
        <p class="font-serif text-lg sm:text-xl text-ink/80 leading-relaxed">
          Edebiyat, Tarih, Arkeoloji, Antik Tarih, Felsefe, Sosyoloji, Psikoloji, Sanat,… etkinliklerimize katılımlarınızı bekliyoruz…
        </p>
      </div>
    </div>
  </section>

  <!-- Main Content Area -->
  <div class="max-w-[1280px] mx-auto px-5 md:px-12 py-16">
    
    <!-- Gelecek Etkinlikler Section -->
    <section class="mb-20">
      <h2 class="font-serif text-2xl sm:text-3xl text-ink font-bold mb-8 pb-3 border-b border-sand">
        Gelecek Etkinlikler
      </h2>

      {upcomingEvents.map((event) => (
        <div class="bg-surface-container-low border-2 border-olive p-8 sm:p-12 shadow-xs">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
            
            <div class="lg:col-span-8">
              <div class="inline-block px-3.5 py-1 bg-olive text-white text-xs font-serif uppercase tracking-widest font-bold mb-4 rounded-xs">
                {event.data.categoryLabelTr}
              </div>

              <h3 class="font-serif text-2xl sm:text-3xl text-ink font-bold leading-tight mb-6">
                {event.data.title}
              </h3>

              <div class="prose max-w-none text-ink/90 font-serif text-lg sm:text-xl leading-relaxed space-y-4 whitespace-pre-line mb-8">
                {event.data.summaryTr}
              </div>

              <div class="flex flex-col sm:flex-row sm:items-center gap-4 pt-6 border-t border-sand">
                <button
                  type="button"
                  id="btn-join-bookclub"
                  class="px-8 py-3.5 bg-olive text-white hover:bg-bodrum-blue-dark text-base font-serif font-bold tracking-wider uppercase transition-colors shadow-xs shrink-0"
                >
                  Kitap Kulübüne Katılın
                </button>
                <span class="text-base font-serif italic text-ink/80 leading-snug">
                  Duyurular ve ilk buluşma tarihi Instagram ve WhatsApp kanalımızdan paylaşılacaktır.
                </span>
              </div>
            </div>

            <div class="lg:col-span-4">
              <div class="bg-parchment border border-sand p-3 shadow-xs">
                <div class="aspect-[4/3] overflow-hidden bg-surface-container-high border border-sand/60">
                  <img
                    src={event.data.image}
                    alt={event.data.title}
                    class="w-full h-full object-cover"
                  />
                </div>
                <div class="p-3 text-center">
                  <span class="font-serif italic text-base text-ink block font-bold">Bodrum Kent Kütüphanesi</span>
                  <span class="text-sm text-stone-gray font-serif">Buluşma Salonu & Bahçe</span>
                </div>
              </div>
            </div>

          </div>
        </div>
      ))}
    </section>

    <!-- Geçmiş Etkinlikler Section -->
    <section>
      <h2 class="font-serif text-2xl sm:text-3xl text-ink font-bold mb-6 pb-3 border-b border-sand">
        Geçmiş Etkinlikler
      </h2>

      <!-- Topic Filters: TÜMÜ, EDEBİYAT, KÜLTÜR, SANAT, TARİH, FELSEFE, ARKEOLOJİ, SOSYOLOJİ, PSİKOLOJİ, EKOLOJİ, BİLİM -->
      <div class="flex flex-wrap gap-2.5 mb-10 text-sm font-serif font-bold">
        {pastEventCategories.map((cat, idx) => (
          <span class={`px-4 py-2 uppercase tracking-wider transition-colors ${
            idx === 0
              ? 'bg-olive text-white shadow-xs'
              : 'bg-surface-container-low border border-sand text-ink hover:border-olive hover:text-olive'
          }`}>
            {cat}
          </span>
        ))}
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {pastEvents.map((event) => (
          <div class="bg-surface-container-low border-2 border-olive p-6 flex flex-col justify-between shadow-xs">
            <div>
              <div class="aspect-[16/10] overflow-hidden bg-surface-container-high mb-4 border border-sand">
                <img
                  src={event.data.image}
                  alt={event.data.title}
                  class="w-full h-full object-cover"
                />
              </div>

              <div class="flex items-center justify-between text-xs text-stone-gray font-mono mb-2">
                <span class="text-olive font-serif font-bold text-sm uppercase">{event.data.categoryLabelTr}</span>
                <span class="font-bold">{event.data.displayDateTr}</span>
              </div>

              <h3 class="font-serif text-xl sm:text-2xl text-ink font-bold mb-3 leading-snug">
                {event.data.title}
              </h3>

              <div class="text-base text-ink/85 font-serif leading-relaxed mb-6 space-y-3 whitespace-pre-line">
                {event.data.summaryTr}
              </div>
            </div>

            <div class="flex items-center gap-3 pt-4 border-t border-sand">
              <button
                type="button"
                class="btn-event-detail px-5 py-2.5 bg-olive text-white hover:bg-bodrum-blue-dark text-xs font-serif font-bold uppercase tracking-wider transition-colors"
                data-title={event.data.title}
                data-summary={event.data.summaryTr}
              >
                Detay
              </button>

              <button
                type="button"
                class="btn-event-gallery px-5 py-2.5 bg-parchment border border-olive text-olive hover:bg-olive hover:text-white text-xs font-serif font-bold uppercase tracking-wider transition-colors"
              >
                Galeri
              </button>
            </div>
          </div>
        ))}
      </div>
    </section>

  </div>
</Layout>

<script>
  const bookClubBtn = document.getElementById('btn-join-bookclub');
  if (bookClubBtn) {
    bookClubBtn.addEventListener('click', () => {
      if ((window as any).showToast) {
        (window as any).showToast(
          'Kitap Kulübü ilgiliniz için teşekkürler! İlk buluşma detayları için WhatsApp ve sosyal medya kanallarımızı takip edebilirsiniz.',
          'success',
          5000
        );
      }
    });
  }

  document.querySelectorAll('.btn-event-gallery').forEach((btn) => {
    btn.addEventListener('click', () => {
      if ((window as any).showToast) {
        (window as any).showToast(
          'Etkinlik fotoğraf galerisi arşive eklenmektedir.',
          'info',
          3000
        );
      }
    });
  });

  document.querySelectorAll('.btn-event-detail').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      const target = e.currentTarget as HTMLElement;
      const title = target.getAttribute('data-title');
      const summary = target.getAttribute('data-summary');
      alert(`${title}\n\n${summary}`);
    });
  });
</script>
