---
import Layout from '../layouts/Layout.astro';
import { getT } from '../utils/i18n';

const lang = 'tr';
const t = getT(lang);

const balikciArrivalQuote = {
  title: "HALİKARNAS BALIKÇISI’NIN BODRUM’A İLK GELDİĞİ AN",
  quote: "En nihayet yokuşun tepesine gelmiştik… Yüreğim çarpıyor. Kaç aydır buraya gelmeye uğraşıyordum yahu!” Tepedeki bir dönemeci dönünce, “şırrrak”, “guuuurr” diye Arşipel’in koyu çividisi ölçülmez açıklıklara kadar yayılıverdi… bir derinlik vardı sonsuz. Akşamın çividisinde koyulaşan koca Arşipel -eski deniz- varlığını bana öyle bir heybetle bildirdi. Masmavi bir gürleyişti o… berrak bir açıklığa uzuyor da uzuyordu… hilâl şeklinde iki liman, ortada da kaleyi taşıyan yarımada…",
  source: "MAVİ SÜRGÜN – HALİKARNAS BALIKÇISI"
};

const initialGuestbookNotes = [
  {
    name: "Defne S.",
    location: "Bodrum / Gümüşlük",
    date: "Ağustos 2026",
    note: "Bodrum’un ruhunu ve Balıkçı’nın mirasını böylesine yaşayan bir kütüphanede görmek paha biçilemez. Zeytin Taneleri Kütüphanesi’ni sabırsızlıkla bekliyoruz!"
  },
  {
    name: "Prof. Dr. Murat A.",
    location: "İzmir",
    date: "Temmuz 2026",
    note: "Ege ve Akdeniz araştırmaları için bağımsız ve çağdaş bir kültür vahası. Arşivdeki nadir eserler koleksiyonu çok değerli."
  },
  {
    name: "Selin & Caner",
    location: "İstanbul",
    date: "Ağustos 2026",
    note: "Kitap kulübü tartışmalarına katılmak için gün sayıyoruz. Bodrum’a kazandırdığınız bu kıymetli nefes alanı için teşekkürler."
  }
];
---

<Layout
  title={t.siteTitle}
  description={t.siteTagline}
  lang={lang}
  currentPath="/"
>
  <!-- 1. Hero & Ana Tanıtım Vitrini -->
  <section class="relative flex items-center justify-center py-6 md:py-10 px-5 md:px-12 overflow-hidden border-b border-sand bg-surface-bright">
    
    <!-- Subtle Ambient Background Layer -->
    <div class="absolute inset-0 z-0 opacity-10 pointer-events-none">
      <div
        class="w-full h-full bg-cover bg-center filter grayscale contrast-125"
        style="background-image: url('/images/logo.png');"
      ></div>
      <div class="absolute inset-0 bg-gradient-to-b from-parchment/70 via-parchment/90 to-parchment"></div>
    </div>

    <!-- Ex Libris Watermark -->
    <div class="absolute -top-10 -right-10 md:top-6 md:right-8 ex-libris-watermark select-none pointer-events-none">
      <span class="material-symbols-outlined text-[140px] md:text-[220px] text-olive leading-none">auto_stories</span>
    </div>

    <!-- Hero Content Container -->
    <div class="relative z-10 max-w-[1280px] mx-auto w-full">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-10 items-center">
        
        <!-- Left: Headline & Manifesto -->
        <div class="lg:col-span-7 space-y-3.5">
          <h1 class="font-serif text-xl sm:text-2xl text-ink font-bold leading-snug tracking-tight">
            Bodrum’un Kültürel Hafızası İçin,<br class="hidden sm:inline" />
            Yaşayan Bir Kütüphane
          </h1>

          <!-- Main Manifesto Text -->
          <div class="bg-parchment border border-sand p-4 sm:p-5 rounded-xs shadow-xs space-y-2.5">
            <p class="font-sans text-xs sm:text-sm text-ink/90 leading-relaxed text-justify">
              Bodrum Kent Kütüphanesi, Bodrum’da yaşayanlar ile kenti ziyaret eden kitapseverleri, edebiyat, sanat ve bilim dünyasının değerli isimleriyle ve kitaplarıyla buluşturmayı amaçlayan, çok amaçlı ve yaşayan bir kütüphane projesidir.
            </p>
            <p class="font-sans text-xs sm:text-sm text-ink/90 leading-relaxed text-justify">
              Kitap merkezli etkinlikler, söyleşiler, atölyeler ve kültürel buluşmalar aracılığıyla yaşam boyu öğrenmeyi, üretimi ve paylaşımı destekleyen; Halikarnas Balıkçısı’nın Akdeniz ve Mavi Hümanizmasını koruyan, Anadolu Uygarlığı’nın değerinin altını çizen; bağımsız bir buluşma alanı olarak tasarlanmaktadır.
            </p>
          </div>
        </div>

        <!-- Right: Bodrum Mavisi Paralel Oval Çerçeve İçinde BKK Logosu -->
        <div class="lg:col-span-5 flex items-center justify-center">
          <div class="p-2 sm:p-2.5 rounded-[28px] sm:rounded-[36px] border-2 border-olive bg-parchment shadow-sm inline-block">
            <div class="w-full max-w-[200px] sm:max-w-[230px] aspect-square rounded-[22px] sm:rounded-[30px] overflow-hidden">
              <img
                src="/images/logo.png"
                alt="Bodrum Kent Kütüphanesi Logosu"
                class="w-full h-full object-contain rounded-[22px] sm:rounded-[30px]"
                loading="eager"
              />
            </div>
          </div>
        </div>

      </div>

      <!-- 3 Institutional Boxes: Dengeli & Eşit Boşluklu Logo Çerçeveleri -->
      <div class="mt-8 pt-6 border-t border-sand">
        <div class="max-w-4xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-5 text-ink">
          
          <!-- 1. Zeytin Taneleri Kütüphanesi (Tam Oturan Logo Çerçevesi) -->
          <div class="bg-parchment p-4 border-2 border-olive rounded-xs shadow-xs flex flex-col justify-between items-center text-center max-w-[280px] w-full mx-auto">
            <div class="h-10 flex items-center justify-center w-full">
              <h3 class="font-serif text-sm sm:text-base font-bold text-olive text-center leading-snug">
                Zeytin Taneleri Kütüphanesi
              </h3>
            </div>

            <!-- Eşit Kenar Boşluklu Logo Çerçevesi -->
            <div class="aspect-square w-36 sm:w-40 my-2 flex items-center justify-center overflow-hidden rounded-xs border border-sand bg-white/70 p-1.5 shadow-2xs">
              <img
                src="/images/ztk_logo.png"
                alt="Zeytin Taneleri Kütüphanesi Logosu"
                class="w-full h-full object-contain"
              />
            </div>

            <div class="h-11 flex items-center justify-center w-full">
              <p class="font-sans text-[11px] sm:text-xs text-ink/85 leading-snug text-center">
                Çocuk, genç, ebeveyn ve<br />eğitimcilere yönelik kütüphane
              </p>
            </div>

            <div class="pt-2 border-t border-olive/20 text-[10px] sm:text-[11px] font-sans italic text-stone-gray w-full text-center">
              Web sayfası hazırlanmakta
            </div>
          </div>

          <!-- 2. Halikarnaslı Çocuklar (Tam Oturan Logo Çerçevesi) -->
          <div class="bg-parchment p-4 border-2 border-olive rounded-xs shadow-xs flex flex-col justify-between items-center text-center max-w-[280px] w-full mx-auto">
            <div class="h-10 flex items-center justify-center w-full">
              <h3 class="font-serif text-sm sm:text-base font-bold text-olive text-center leading-snug">
                Halikarnaslı Çocuklar
              </h3>
            </div>

            <!-- Eşit Kenar Boşluklu Logo Çerçevesi -->
            <div class="aspect-square w-36 sm:w-40 my-2 flex items-center justify-center overflow-hidden rounded-xs border border-sand bg-white/70 p-1.5 shadow-2xs">
              <img
                src="/images/hc_logo.png"
                alt="Halikarnaslı Çocuklar Sanat Çalışmaları"
                class="w-full h-full object-contain"
              />
            </div>

            <div class="h-11 flex items-center justify-center w-full">
              <p class="font-sans text-[11px] sm:text-xs text-ink/85 leading-snug text-center">
                Her yaşa yönelik<br />sanat çalışmaları
              </p>
            </div>

            <div class="pt-2 border-t border-olive/20 text-[10px] sm:text-[11px] font-sans italic text-stone-gray w-full text-center">
              Web sayfası hazırlanmakta
            </div>
          </div>

          <!-- 3. Halikarnas Derneği (Aynı Ebatta Logo Çerçevesi) -->
          <div class="bg-parchment p-4 border-2 border-olive rounded-xs shadow-xs flex flex-col justify-between items-center text-center max-w-[280px] w-full mx-auto">
            <div class="h-10 flex items-center justify-center w-full">
              <h3 class="font-serif text-sm sm:text-base font-bold text-olive text-center leading-snug">
                Halikarnas Kültür, Sanat,<br />
                Eğitim ve Ekoloji Derneği
              </h3>
            </div>

            <!-- Aynı Ebatta Kurumsal Mühür Çerçevesi -->
            <div class="aspect-square w-36 sm:w-40 my-2 flex flex-col items-center justify-center overflow-hidden rounded-xs border border-sand bg-olive/5 text-olive p-2 shadow-2xs">
              <div class="w-14 h-14 rounded-full bg-olive/10 border-2 border-olive flex items-center justify-center mb-1">
                <span class="material-symbols-outlined text-2xl text-olive">account_balance</span>
              </div>
              <span class="font-serif font-bold text-[9px] uppercase tracking-wider text-center text-olive">Kurumsal Çatı</span>
            </div>

            <div class="h-11 flex items-center justify-center w-full">
              <a
                href="/destek#basvuru-alani"
                class="font-sans text-[11px] sm:text-xs text-olive font-bold hover:underline leading-snug text-center block transition-colors"
              >
                Derneğimize üye olmak<br />için lütfen tıklayınız
              </a>
            </div>

            <div class="pt-2 border-t border-olive/20 text-[10px] sm:text-[11px] font-sans italic text-stone-gray w-full text-center">
              Web sayfası hazırlanmakta
            </div>
          </div>

        </div>
      </div>

    </div>
  </section>

  <!-- 2. Halikarnas Balıkçısı’nın Bodrum’a İlk Geldiği An (Kompakt ve Dengeli Kenar Boşluklu Kutu) -->
  <section class="py-6 md:py-8 px-5 md:px-12 bg-surface-container-low border-b border-sand">
    <div class="max-w-[1280px] mx-auto">
      <div class="max-w-3xl sm:max-w-4xl mx-auto bg-parchment border-2 border-olive rounded-xs p-6 sm:p-8 shadow-md relative overflow-hidden text-center">
        
        <div class="absolute -right-5 -bottom-5 opacity-5 pointer-events-none select-none">
          <span class="material-symbols-outlined text-[140px] text-olive leading-none">format_quote</span>
        </div>

        <div class="relative z-10 space-y-3.5">
          <div class="inline-flex items-center gap-1.5 px-3.5 py-1 bg-olive text-white text-[11px] sm:text-xs font-sans font-bold uppercase tracking-widest rounded-xs shadow-2xs">
            <span class="material-symbols-outlined text-xs">auto_stories</span>
            <span>{balikciArrivalQuote.title}</span>
          </div>

          <blockquote class="font-serif italic text-sm sm:text-base md:text-[16px] text-ink leading-relaxed text-justify sm:text-center px-2 sm:px-4">
            "{balikciArrivalQuote.quote}"
          </blockquote>

          <div class="flex items-center justify-center pt-1">
            <cite class="not-italic text-olive font-bold font-serif text-xs sm:text-sm tracking-wide">
              {balikciArrivalQuote.source}
            </cite>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Ziyaretçi Defteri / "Bodrum'a ve Kütüphanemize Bir Cümle Bırakın" -->
  <section class="py-8 md:py-10 px-5 md:px-12 bg-surface-bright border-b border-sand">
    <div class="max-w-[1280px] mx-auto">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-start">
        
        <!-- Sol: Tanıtım ve Form -->
        <div class="lg:col-span-5 space-y-3.5">
          <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 bg-olive text-white text-[11px] font-sans font-bold uppercase tracking-widest rounded-xs shadow-2xs">
            <span>DİJİTAL ANI DEFTERİ</span>
          </div>

          <h2 class="font-serif text-base sm:text-lg text-ink font-bold leading-snug">
            Bodrum’a ve Kütüphanemize<br />
            Bir Cümle Bırakın Lütfen
          </h2>

          <p class="font-sans text-xs text-ink/80 leading-relaxed">
            Bodrum Kent Kütüphanesi, siz kitapseverlerin ve dostlarımızın ilgisiyle büyüyor.<br />
            Siz de kütüphanemiz ve Bodrum için duygu, düşünce ve önerilerinizi buraya yazın lütfen.
          </p>

          <form id="guestbook-form" class="bg-parchment border-2 border-olive p-3.5 sm:p-4 rounded-xs shadow-xs space-y-2.5 font-sans">
            <div>
              <label class="block text-[11px] font-bold text-ink uppercase tracking-wider mb-0.5">Adınız / Rumuz *</label>
              <input
                type="text"
                id="guest-name"
                required
                placeholder="Örn: Ege Sevdalısı"
                class="w-full px-3 py-1.5 bg-surface-bright border border-sand text-ink text-xs rounded-xs focus:outline-none focus:border-olive"
              />
            </div>

            <div>
              <label class="block text-[11px] font-bold text-ink uppercase tracking-wider mb-0.5">Şehir / Semt</label>
              <input
                type="text"
                id="guest-location"
                placeholder="Örn: Bodrum / Yalıkavak"
                class="w-full px-3 py-1.5 bg-surface-bright border border-sand text-ink text-xs rounded-xs focus:outline-none focus:border-olive"
              />
            </div>

            <div>
              <label class="block text-[11px] font-bold text-ink uppercase tracking-wider mb-0.5">Kütüphane Notunuz *</label>
              <textarea
                id="guest-note"
                rows="3"
                required
                placeholder="Kütüphanemiz ve Bodrum için duygu, düşünce ve önerileriniz..."
                class="w-full px-3 py-1.5 bg-surface-bright border border-sand text-ink text-xs rounded-xs focus:outline-none focus:border-olive"
              ></textarea>
            </div>

            <button
              type="submit"
              class="w-full py-2 bg-olive hover:bg-bodrum-blue-dark text-white text-xs font-bold uppercase tracking-wider rounded-xs transition-colors shadow-xs flex items-center justify-center gap-1 cursor-pointer"
            >
              <span class="material-symbols-outlined text-sm">edit_note</span>
              <span>Anı Defterine Ekle</span>
            </button>
          </form>
        </div>

        <!-- Sağ: Ziyaretçi Notları Akışı -->
        <div class="lg:col-span-7 space-y-3">
          <div class="flex items-center justify-between pb-2 border-b border-sand">
            <h2 class="font-serif text-base sm:text-lg font-bold text-ink leading-snug">
              Kitapseverlerin & Dostlarımızın Notları
            </h2>
            <span class="text-[11px] font-mono text-stone-gray font-bold">Son Notlar</span>
          </div>

          <div id="guestbook-list" class="space-y-2.5">
            {initialGuestbookNotes.map((item) => (
              <div class="bg-parchment border border-sand p-3 sm:p-3.5 rounded-xs shadow-2xs space-y-1 transition-all hover:border-olive">
                <p class="font-serif italic text-xs sm:text-sm text-ink/90 leading-relaxed">
                  "{item.note}"
                </p>
                <div class="flex items-center justify-between text-[11px] font-sans text-stone-gray pt-1 border-t border-sand/50">
                  <span class="font-bold text-olive">{item.name} <span class="font-normal text-stone-gray/80">• {item.location}</span></span>
                  <span class="font-mono text-[10px]">{item.date}</span>
                </div>
              </div>
            ))}
          </div>
        </div>

      </div>

    </div>
  </section>
</Layout>

<script is:inline>
  const guestbookForm = document.getElementById('guestbook-form');
  const guestbookList = document.getElementById('guestbook-list');

  if (guestbookForm && guestbookList) {
    guestbookForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const nameInput = document.getElementById('guest-name');
      const locationInput = document.getElementById('guest-location');
      const noteInput = document.getElementById('guest-note');

      const name = nameInput.value.trim();
      const location = locationInput.value.trim() || 'Bodrum';
      const note = noteInput.value.trim();

      if (!name || !note) return;

      const newCard = document.createElement('div');
      newCard.className = 'bg-parchment border-2 border-olive p-3 rounded-xs shadow-xs space-y-1 transition-all animate-fadeIn';
      newCard.innerHTML = `
        <p class="font-serif italic text-xs sm:text-sm text-ink leading-relaxed">
          "${note}"
        </p>
        <div class="flex items-center justify-between text-[11px] font-sans text-stone-gray pt-1 border-t border-sand/50">
          <span class="font-bold text-olive">${name} <span class="font-normal text-stone-gray/80">• ${location}</span></span>
          <span class="font-mono text-[10px] font-bold text-emerald-700 bg-emerald-50 px-1 py-0.5 rounded-2xs">Şimdi</span>
        </div>
      `;

      guestbookList.prepend(newCard);
      guestbookForm.reset();

      if (window.showToast) {
        window.showToast('Notunuz Bodrum Kent Kütüphanesi Dijital Anı Defteri’ne eklendi! Teşekkür ederiz.', 'success', 5000);
      }
    });
  }
</script>
