---
import Layout from '../layouts/Layout.astro';
import { getT } from '../utils/i18n';

const lang = 'tr';
const t = getT(lang);

const balıkçıQuotes = [
  {
    quote: "Yokuş başına geldiğinde Bodrum'u göreceksin, sanma ki sen geldiğin gibi gideceksin. Senden öncekiler de böyleydiler; akıllarını hep Bodrum'da bırakıp gittiler...",
    source: "Mavi Sürgün"
  },
  {
    quote: "Deniz, insanın içindeki sonsuzluğu uyandırır. Akdeniz'e bir kere gönül veren, artık karanın dar kalıplarına sığamaz.",
    source: "Merhaba Akdeniz"
  },
  {
    quote: "Bizim hümanizmamız masa başında değil, Ege'nin tuzlu sularında ve Anadolu'nun bin yıllık kadim toprağında yoğrulmuştur.",
    source: "Altıncı Kıta Akdeniz"
  }
];

const initialGuestbookNotes = [
  {
    name: "Defne S.",
    location: "Bodrum / Gümüşlük",
    date: "Ağustos 2026",
    note: "Bodrum’un ruhunu ve Balıkçı’nın mirasını böylesine yaşayan bir kütüphanede görmek paha biçilemez. Zeytin Taneleri Kütüphanesi’ni sabırsızlıkla bekliyoruz!"
  },
  {
    name: "Prof. Dr. Murat A.",
    location: "İzmir",
    date: "Temmuz 2026",
    note: "Ege ve Akdeniz araştırmaları için bağımsız ve çağdaş bir kültür vahası. Arşivdeki nadir eserler koleksiyonu çok değerli."
  },
  {
    name: "Selin & Caner",
    location: "İstanbul",
    date: "Ağustos 2026",
    note: "Kitap kulübü tartışmalarına katılmak için gün sayıyoruz. Bodrum’a kazandırdığınız bu kıymetli nefes alanı için teşekkürler."
  }
];
---

<Layout
  title={t.siteTitle}
  description={t.siteTagline}
  lang={lang}
  currentPath="/"
>
  <!-- 1. Hero & Ana Tanıtım Vitrini -->
  <section class="relative min-h-[50vh] flex items-center justify-center py-8 md:py-12 px-5 md:px-12 overflow-hidden border-b border-sand bg-surface-bright">
    
    <!-- Subtle Ambient Background Layer -->
    <div class="absolute inset-0 z-0 opacity-10 pointer-events-none">
      <div
        class="w-full h-full bg-cover bg-center filter grayscale contrast-125"
        style="background-image: url('/images/logo.png');"
      ></div>
      <div class="absolute inset-0 bg-gradient-to-b from-parchment/70 via-parchment/90 to-parchment"></div>
    </div>

    <!-- Ex Libris Watermark -->
    <div class="absolute -top-10 -right-10 md:top-8 md:right-10 ex-libris-watermark select-none pointer-events-none">
      <span class="material-symbols-outlined text-[160px] md:text-[260px] text-olive leading-none">auto_stories</span>
    </div>

    <!-- Hero Content Container -->
    <div class="relative z-10 max-w-[1280px] mx-auto w-full">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
        
        <!-- Left: Refined 2-Line Headline & Elegant Manifesto -->
        <div class="lg:col-span-7 space-y-4">
          <h1 class="font-serif text-2xl sm:text-3xl lg:text-[32px] text-ink font-bold leading-[1.25] tracking-tight">
            Bodrum’un Kültürel Hafızası İçin,<br class="hidden sm:inline" />
            Yaşayan Bir Kütüphane
          </h1>

          <!-- Main Manifesto Text with balanced size -->
          <div class="bg-parchment border border-sand p-5 sm:p-6 rounded-xs shadow-xs space-y-3">
            <p class="font-sans text-sm sm:text-[15px] text-ink/90 leading-relaxed text-justify">
              Bodrum Kent Kütüphanesi, Bodrum’da yaşayanlar ile kenti ziyaret eden kitapseverleri, edebiyat, sanat ve bilim dünyasının değerli isimleriyle ve kitaplarıyla buluşturmayı amaçlayan, çok amaçlı ve yaşayan bir kütüphane projesidir.
            </p>
            <p class="font-sans text-sm sm:text-[15px] text-ink/90 leading-relaxed text-justify">
              Kitap merkezli etkinlikler, söyleşiler, atölyeler ve kültürel buluşmalar aracılığıyla yaşam boyu öğrenmeyi, üretimi ve paylaşımı destekleyen; Halikarnas Balıkçısı’nın Akdeniz ve Mavi Hümanizmasını koruyan, Anadolu Uygarlığı’nın değerinin altını çizen; bağımsız bir buluşma alanı olarak tasarlanmaktadır.
            </p>
          </div>
        </div>

        <!-- Right: Clean Oval-Cornered BKK Logo -->
        <div class="lg:col-span-5 flex items-center justify-center">
          <div class="w-full max-w-[230px] sm:max-w-[260px] aspect-square rounded-xl sm:rounded-2xl overflow-hidden shadow-sm">
            <img
              src="/images/logo.png"
              alt="Bodrum Kent Kütüphanesi Logosu"
              class="w-full h-full object-contain rounded-xl sm:rounded-2xl"
              loading="eager"
            />
          </div>
        </div>

      </div>

      <!-- 3 Strategic Institutional Boxes: Compact, Larger Logos & Exact Horizontal Alignment -->
      <div class="mt-10 pt-7 border-t border-sand grid grid-cols-1 md:grid-cols-3 gap-5 text-ink">
        
        <!-- 1. Zeytin Taneleri Kütüphanesi -->
        <div class="bg-parchment p-5 border-2 border-olive rounded-xs shadow-xs flex flex-col justify-between items-center text-center min-h-[320px]">
          <!-- Title Container (Fixed Height) -->
          <div class="h-12 flex items-center justify-center w-full">
            <h3 class="font-serif text-lg sm:text-xl font-bold text-olive text-center leading-snug">
              Zeytin Taneleri Kütüphanesi
            </h3>
          </div>

          <!-- Large Logo Container -->
          <div class="w-32 h-32 sm:w-36 sm:h-36 my-2 flex items-center justify-center overflow-hidden">
            <img
              src="/images/ztk_logo.png"
              alt="Zeytin Taneleri Kütüphanesi Logosu"
              class="max-w-full max-h-full object-contain scale-115"
            />
          </div>

          <!-- 2-Line Description (Fixed Height for Alignment) -->
          <div class="h-12 flex items-center justify-center w-full">
            <p class="font-sans text-xs sm:text-sm text-ink/85 leading-snug text-center">
              Çocuk, genç, ebeveyn ve<br />eğitimcilere yönelik kütüphane
            </p>
          </div>

          <!-- Footer Notice -->
          <div class="pt-2 border-t border-olive/20 text-xs font-sans italic text-stone-gray w-full text-center">
            Web sayfası hazırlanmakta
          </div>
        </div>

        <!-- 2. Halikarnaslı Çocuklar -->
        <div class="bg-parchment p-5 border-2 border-olive rounded-xs shadow-xs flex flex-col justify-between items-center text-center min-h-[320px]">
          <!-- Title Container (Fixed Height) -->
          <div class="h-12 flex items-center justify-center w-full">
            <h3 class="font-serif text-lg sm:text-xl font-bold text-olive text-center leading-snug">
              Halikarnaslı Çocuklar
            </h3>
          </div>

          <!-- Large Artwork Container -->
          <div class="w-32 h-32 sm:w-36 sm:h-36 my-2 flex items-center justify-center overflow-hidden rounded-xs border border-sand">
            <img
              src="/images/hc_logo.jpg"
              alt="Halikarnaslı Çocuklar Sanat Çalışmaları"
              class="w-full h-full object-cover scale-105"
            />
          </div>

          <!-- Description (Fixed Height for Alignment) -->
          <div class="h-12 flex items-center justify-center w-full">
            <p class="font-sans text-xs sm:text-sm text-ink/85 leading-snug text-center">
              Her yaşa yönelik sanat çalışmaları
            </p>
          </div>

          <!-- Footer Notice -->
          <div class="pt-2 border-t border-olive/20 text-xs font-sans italic text-stone-gray w-full text-center">
            Web sayfası hazırlanmakta
          </div>
        </div>

        <!-- 3. Halikarnas Derneği -->
        <div class="bg-parchment p-5 border-2 border-olive rounded-xs shadow-xs flex flex-col justify-between items-center text-center min-h-[320px]">
          <!-- Title Container (Fixed Height) -->
          <div class="h-12 flex items-center justify-center w-full">
            <h3 class="font-serif text-lg sm:text-xl font-bold text-olive text-center leading-snug">
              Halikarnas Kültür, Sanat, Eğitim<br />ve Ekoloji Derneği
            </h3>
          </div>

          <!-- Large Icon Container -->
          <div class="w-32 h-32 sm:w-36 sm:h-36 my-2 flex items-center justify-center bg-olive/10 text-olive rounded-full border border-olive/30">
            <span class="material-symbols-outlined text-4xl sm:text-5xl">account_balance</span>
          </div>

          <!-- Description (Fixed Height for Alignment) -->
          <div class="h-12 flex items-center justify-center w-full">
            <p class="font-sans text-xs sm:text-sm text-ink/85 leading-snug text-center">
              Tüm çalışmalarımızın resmî çatısı
            </p>
          </div>

          <!-- Footer Notice -->
          <div class="pt-2 border-t border-olive/20 text-xs font-sans italic text-stone-gray w-full text-center">
            Web sayfası hazırlanmakta
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- 2. Günün Balıkçı Alıntısı / "Merhaba" Edebiyat Vitrini -->
  <section class="py-10 md:py-14 px-5 md:px-12 bg-surface-container-low border-b border-sand">
    <div class="max-w-[1280px] mx-auto">
      <div class="bg-parchment border-2 border-olive rounded-xs p-6 sm:p-10 shadow-md relative overflow-hidden">
        
        <div class="absolute -right-8 -bottom-8 opacity-5 pointer-events-none select-none">
          <span class="material-symbols-outlined text-[180px] text-olive leading-none">format_quote</span>
        </div>

        <div class="relative z-10 max-w-4xl mx-auto text-center space-y-4">
          <div class="inline-flex items-center gap-2 px-3 py-1 bg-olive/10 text-olive text-xs font-sans font-bold uppercase tracking-widest rounded-xs">
            <span class="material-symbols-outlined text-sm">auto_stories</span>
            <span>HALİKARNAS BALIKÇISI’NDAN BİR SELAM</span>
          </div>

          <blockquote id="quote-display" class="font-serif italic text-lg sm:text-xl md:text-2xl text-ink leading-relaxed">
            "{balıkçıQuotes[0].quote}"
          </blockquote>

          <div class="flex items-center justify-center gap-3 text-sm font-sans">
            <span class="font-bold text-olive font-serif text-base">Cevat Şakir Kabaağaçlı</span>
            <span class="text-stone-gray">•</span>
            <cite id="quote-source" class="not-italic text-stone-gray font-medium">{balıkçıQuotes[0].source}</cite>
          </div>

          <div class="pt-1 flex items-center justify-center gap-2">
            <button
              type="button"
              id="next-quote-btn"
              class="px-4 py-1.5 bg-olive text-white hover:bg-bodrum-blue-dark text-xs font-sans font-bold uppercase tracking-wider rounded-xs transition-colors shadow-2xs flex items-center gap-1.5 cursor-pointer"
            >
              <span class="material-symbols-outlined text-sm">refresh</span>
              <span>Başka Bir Alıntı Göster</span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Ziyaretçi Defteri / "Bodrum'a ve Kütüphanemize Bir Cümle Bırakın Lütfen" -->
  <section class="py-10 md:py-14 px-5 md:px-12 bg-surface-bright border-b border-sand">
    <div class="max-w-[1280px] mx-auto">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start">
        
        <!-- Sol: Tanıtım ve Form -->
        <div class="lg:col-span-5 space-y-4">
          <div class="inline-flex items-center gap-2 px-3 py-1 bg-olive text-white text-xs font-sans font-bold uppercase tracking-widest rounded-xs shadow-2xs">
            <span>DİJİTAL ANI DEFTERİ</span>
          </div>

          <h2 class="font-serif text-xl sm:text-2xl text-ink font-bold leading-tight">
            Bodrum’a ve Kütüphanemize<br />
            Bir Cümle Bırakın Lütfen
          </h2>

          <p class="font-sans text-xs sm:text-sm text-ink/80 leading-relaxed text-justify">
            Bodrum Kent Kütüphanesi, siz kitapseverlerin ve dostlarımızın ilgisiyle büyüyor! Siz de kütüphanemiz ve Bodrum için duygu, düşünce ve önerilerinizi buraya yazabilirsiniz.
          </p>

          <form id="guestbook-form" class="bg-parchment border-2 border-olive p-4 sm:p-5 rounded-xs shadow-xs space-y-3 font-sans">
            <div>
              <label class="block text-xs font-bold text-ink uppercase tracking-wider mb-1">Adınız / Rumuz *</label>
              <input
                type="text"
                id="guest-name"
                required
                placeholder="Örn: Ege Sevdalısı"
                class="w-full px-3 py-2 bg-surface-bright border border-sand text-ink text-sm rounded-xs focus:outline-none focus:border-olive"
              />
            </div>

            <div>
              <label class="block text-xs font-bold text-ink uppercase tracking-wider mb-1">Şehir / Semt</label>
              <input
                type="text"
                id="guest-location"
                placeholder="Örn: Bodrum / Yalıkavak"
                class="w-full px-3 py-2 bg-surface-bright border border-sand text-ink text-sm rounded-xs focus:outline-none focus:border-olive"
              />
            </div>

            <div>
              <label class="block text-xs font-bold text-ink uppercase tracking-wider mb-1">Kütüphane Notunuz *</label>
              <textarea
                id="guest-note"
                rows="3"
                required
                placeholder="Kütüphanemiz ve Bodrum için duygu, düşünce ve önerileriniz..."
                class="w-full px-3 py-2 bg-surface-bright border border-sand text-ink text-sm rounded-xs focus:outline-none focus:border-olive"
              ></textarea>
            </div>

            <button
              type="submit"
              class="w-full py-2.5 bg-olive hover:bg-bodrum-blue-dark text-white text-xs font-bold uppercase tracking-wider rounded-xs transition-colors shadow-xs flex items-center justify-center gap-1.5 cursor-pointer"
            >
              <span class="material-symbols-outlined text-sm">edit_note</span>
              <span>Anı Defterine Ekle</span>
            </button>
          </form>
        </div>

        <!-- Sağ: Ziyaretçi Notları Akışı -->
        <div class="lg:col-span-7 space-y-3.5">
          <div class="flex items-center justify-between pb-2 border-b border-sand">
            <h3 class="font-serif text-lg sm:text-xl font-bold text-ink">
              Kitapseverlerin & Dostlarımızın Notları
            </h3>
            <span class="text-xs font-mono text-stone-gray font-bold">Son Notlar</span>
          </div>

          <div id="guestbook-list" class="space-y-3">
            {initialGuestbookNotes.map((item) => (
              <div class="bg-parchment border border-sand p-4 rounded-xs shadow-2xs space-y-1.5 transition-all hover:border-olive">
                <p class="font-serif italic text-sm sm:text-base text-ink/90 leading-relaxed">
                  "{item.note}"
                </p>
                <div class="flex items-center justify-between text-xs font-sans text-stone-gray pt-1.5 border-t border-sand/50">
                  <span class="font-bold text-olive">{item.name} <span class="font-normal text-stone-gray/80">• {item.location}</span></span>
                  <span class="font-mono text-[11px]">{item.date}</span>
                </div>
              </div>
            ))}
          </div>
        </div>

      </div>

    </div>
  </section>
</Layout>

<script is:inline define:vars={{ balıkçıQuotes }}>
  let quoteIndex = 0;
  const quoteDisplay = document.getElementById('quote-display');
  const quoteSource = document.getElementById('quote-source');
  const nextQuoteBtn = document.getElementById('next-quote-btn');

  if (nextQuoteBtn && quoteDisplay && quoteSource) {
    nextQuoteBtn.addEventListener('click', () => {
      quoteIndex = (quoteIndex + 1) % balıkçıQuotes.length;
      quoteDisplay.textContent = `"${balıkçıQuotes[quoteIndex].quote}"`;
      quoteSource.textContent = balıkçıQuotes[quoteIndex].source;
    });
  }

  const guestbookForm = document.getElementById('guestbook-form');
  const guestbookList = document.getElementById('guestbook-list');

  if (guestbookForm && guestbookList) {
    guestbookForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const nameInput = document.getElementById('guest-name');
      const locationInput = document.getElementById('guest-location');
      const noteInput = document.getElementById('guest-note');

      const name = nameInput.value.trim();
      const location = locationInput.value.trim() || 'Bodrum';
      const note = noteInput.value.trim();

      if (!name || !note) return;

      const newCard = document.createElement('div');
      newCard.className = 'bg-parchment border-2 border-olive p-4 rounded-xs shadow-xs space-y-1.5 transition-all animate-fadeIn';
      newCard.innerHTML = `
        <p class="font-serif italic text-sm sm:text-base text-ink leading-relaxed">
          "${note}"
        </p>
        <div class="flex items-center justify-between text-xs font-sans text-stone-gray pt-1.5 border-t border-sand/50">
          <span class="font-bold text-olive">${name} <span class="font-normal text-stone-gray/80">• ${location}</span></span>
          <span class="font-mono text-[11px] font-bold text-emerald-700 bg-emerald-50 px-1.5 py-0.5 rounded-2xs">Şimdi</span>
        </div>
      `;

      guestbookList.prepend(newCard);
      guestbookForm.reset();

      if (window.showToast) {
        window.showToast('Notunuz Bodrum Kent Kütüphanesi Dijital Anı Defteri’ne eklendi! Teşekkür ederiz.', 'success', 5000);
      }
    });
  }
</script>
