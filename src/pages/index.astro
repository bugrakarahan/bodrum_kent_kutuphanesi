---
import Layout from '../layouts/Layout.astro';
import { getT } from '../utils/i18n';

const lang = 'tr';
const t = getT(lang);
---

<Layout
  title={t.siteTitle}
  description={t.siteTagline}
  lang={lang}
  currentPath="/"
>
  <!-- 1. Hero & Ana Tanıtım Vitrini -->
  <section class="relative min-h-[70vh] flex items-center justify-center py-10 md:py-16 px-5 md:px-12 overflow-hidden border-b border-sand bg-surface-bright">
    
    <!-- Subtle Ambient Background Layer -->
    <div class="absolute inset-0 z-0 opacity-10 pointer-events-none">
      <div
        class="w-full h-full bg-cover bg-center filter grayscale contrast-125"
        style="background-image: url('https://lh3.googleusercontent.com/aida/AP1WRLvo60AOVtg-X2yx5_UsWAYHm8SVZyT_7GmTxiGOeYNbsSg0TADSsk0S_nyvd794vLfkUY3I7nwaPhBWhJdlPkO45ZzOwy2dFyAdRBD_sw9MQ0ohoBLQsfabJSdYSm4TbUmg_2DEzDzqMqJbLKVQjdUYWpK6uJXcvx1KUMGHoDWpGghWlQBy8J7PfXLubkb5erCLKPe8Nznl46CMhd-jcSxP8dhqHD4evmD0Zl-vA-Sxo0_PqpRIAuZpIWo');"
      ></div>
      <div class="absolute inset-0 bg-gradient-to-b from-parchment/70 via-parchment/90 to-parchment"></div>
    </div>

    <!-- Ex Libris Watermark -->
    <div class="absolute -top-10 -right-10 md:top-8 md:right-10 ex-libris-watermark select-none pointer-events-none">
      <span class="material-symbols-outlined text-[180px] md:text-[300px] text-olive leading-none">auto_stories</span>
    </div>

    <!-- Hero Content Container -->
    <div class="relative z-10 max-w-[1280px] mx-auto w-full">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        
        <!-- Left: Standardized Heading & Justified Manifesto -->
        <div class="lg:col-span-7 space-y-6">
          
          <!-- Standardized Main Heading with Comma -->
          <h1 class="font-serif text-3xl sm:text-4xl lg:text-[38px] text-ink font-bold leading-[1.25] tracking-tight">
            Bodrum’un Kültürel Hafızası İçin, Yaşayan Bir Kütüphane
          </h1>

          <!-- Main Manifesto Text: 2 Paragraphs with Text-Justify Balance -->
          <div class="bg-parchment border border-sand p-6 sm:p-8 rounded-xs shadow-xs space-y-4">
            <p class="font-serif text-lg sm:text-xl text-ink/90 leading-relaxed text-justify">
              Bodrum Kent Kütüphanesi, Bodrum’da yaşayanlar ile kenti ziyaret eden kitapseverleri, edebiyat, sanat ve bilim dünyasının değerli isimleriyle ve kitaplarıyla buluşturmayı amaçlayan, çok amaçlı ve yaşayan bir kütüphane projesidir.
            </p>
            <p class="font-serif text-lg sm:text-xl text-ink/90 leading-relaxed text-justify">
              Kitap merkezli etkinlikler, söyleşiler, atölyeler ve kültürel buluşmalar aracılığıyla yaşam boyu öğrenmeyi, üretimi ve paylaşımı destekleyen; Halikarnas Balıkçısı’nın Akdeniz ve Mavi Hümanizmasını koruyan, Anadolu Uygarlığı’nın değerinin altını çizen; bağımsız bir buluşma alanı olarak tasarlanmaktadır.
            </p>
          </div>
        </div>

        <!-- Right: Atmospheric Heritage Photo -->
        <div class="lg:col-span-5">
          <div class="relative group">
            <div class="relative bg-parchment border-2 border-olive p-3 shadow-md rounded-xs">
              <div class="aspect-[4/3] overflow-hidden bg-surface-container-high relative border border-sand/60">
                <img
                  src="https://lh3.googleusercontent.com/aida-public/AB6AXuDQ_kg3bbgJ4ynOz1o7DQcY3YaIdeG_zUESiNKW-81FsNfEZqrXlPi-ZAYWzb2FYdKriB4ESdIgn04zGCTSrnOaQAobk2tEQSDMKK4TlQhdPdjUJk74KLsSusQUSR9nHe1QycFJgHdfJUQSr8eFa2k0wQHdX3j1D5aQBbxg9mUEAGpQs_UGA_l1geAuKfbBil5Wy-_VugN7cjAepbQ_HoOugyaLOfsfF-vsYSCOhY75Ao3sAvwHFdv3nGJYn9whKvXn8vnrP8j4yEE"
                  alt="Bodrum Kent Kütüphanesi Kültürel Hafıza"
                  class="w-full h-full object-cover"
                  loading="eager"
                />
              </div>
              <div class="pt-3 pb-1 px-1 flex items-center justify-between text-sm text-stone-gray font-serif italic">
                <span class="font-bold text-ink">Bodrum Kent Kütüphanesi</span>
                <span class="font-mono text-xs not-italic">Kızılağaç • 2019</span>
              </div>
            </div>
          </div>
        </div>

      </div>

      <!-- 3 Strategic Institutional Headings & Lowercase Descriptions -->
      <div class="mt-12 pt-8 border-t border-sand grid grid-cols-1 md:grid-cols-3 gap-6 text-ink">
        
        <!-- 1. Zeytin Taneleri Kütüphanesi -->
        <div class="bg-parchment p-6 border-2 border-olive rounded-xs shadow-xs flex flex-col justify-between">
          <div>
            <h3 class="font-serif text-xl font-bold text-olive mb-2">
              Zeytin Taneleri Kütüphanesi
            </h3>
            <p class="font-serif text-base text-ink/85 leading-relaxed mb-4">
              Çocuk, genç, ebeveyn ve eğitimcilere yönelik kütüphane
            </p>
          </div>
          <div class="pt-2 border-t border-olive/20 text-xs font-serif italic text-stone-gray">
            Web sayfası hazırlanmakta
          </div>
        </div>

        <!-- 2. Halikarnaslı Çocuklar -->
        <div class="bg-parchment p-6 border-2 border-olive rounded-xs shadow-xs flex flex-col justify-between">
          <div>
            <h3 class="font-serif text-xl font-bold text-olive mb-2">
              Halikarnaslı Çocuklar
            </h3>
            <p class="font-serif text-base text-ink/85 leading-relaxed mb-4">
              Her yaşa yönelik sanat çalışmaları
            </p>
          </div>
          <div class="pt-2 border-t border-olive/20 text-xs font-serif italic text-stone-gray">
            Web sayfası hazırlanmakta
          </div>
        </div>

        <!-- 3. Halikarnas Derneği -->
        <div class="bg-parchment p-6 border-2 border-olive rounded-xs shadow-xs flex flex-col justify-between">
          <div>
            <h3 class="font-serif text-xl font-bold text-olive mb-2">
              Halikarnas Kültür, Sanat, Eğitim ve Ekoloji Derneği
            </h3>
            <p class="font-serif text-base text-ink/85 leading-relaxed mb-4">
              Tüm çalışmalarımızın resmî çatısı
            </p>
          </div>
          <div class="pt-2 border-t border-olive/20 text-xs font-serif italic text-stone-gray">
            Web sayfası hazırlanmakta
          </div>
        </div>

      </div>

    </div>
  </section>
</Layout>
