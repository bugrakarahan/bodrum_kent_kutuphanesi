---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { getT } from '../utils/i18n';

const lang = 'tr';
const t = getT(lang);

const allTalks = await getCollection('talks');
const featuredTalks = allTalks.filter((t) => t.data.featured);
const otherTalks = allTalks.filter((t) => !t.data.featured);

const categories = [
  "TÜMÜ", "YAZARLAR", "EDEBİYAT", "KÜLTÜR", "SANAT", "TARİH", "FELSEFE", "ARKEOLOJİ", "SOSYOLOJİ", "PSİKOLOJİ", "EKOLOJİ", "BİLİM"
];
---

<Layout
  title={`Söyleşiler | ${t.siteTitle}`}
  description="Kültür, sanat, toplumsal ve bilimsel dünyamızı aydınlatan yazarlar, akademisyenler ve araştırmacılar ile söyleşiler."
  lang={lang}
  currentPath="/soylesiler"
>
  <!-- Hero Section (Standardized Headline Size) -->
  <section class="py-12 md:py-16 px-5 md:px-12 bg-surface-bright border-b border-sand">
    <div class="max-w-[1280px] mx-auto">
      <div class="max-w-3xl">
        <h1 class="font-serif text-3xl sm:text-4xl text-ink font-bold leading-tight mb-4">
          Kültür, Sanat ve Bilim Söyleşileri
        </h1>
        <p class="font-serif text-lg sm:text-xl text-ink/80 leading-relaxed">
          Kültür, sanat, toplumsal ve bilimsel dünyamızı aydınlatan ve zenginleştiren yazarlar, sanatçılar, bilim insanları ve araştırmacılar ile yaptığımız sohbetlerin video kayıtları.
        </p>
      </div>
    </div>
  </section>

  <!-- Category Pills Bar: All in Bodrum Blue, Compact Single Line -->
  <div class="border-b border-sand bg-parchment py-3.5 px-5 md:px-12 sticky top-22 z-30 overflow-x-auto">
    <div class="max-w-[1280px] mx-auto flex items-center gap-2 min-w-max">
      {categories.map((cat, idx) => (
        <button
          type="button"
          class={`px-3 py-1.5 text-xs font-serif font-bold uppercase tracking-wider rounded-xs transition-colors shadow-2xs ${
            idx === 0
              ? 'bg-olive text-white ring-2 ring-olive/40'
              : 'bg-olive text-white hover:bg-bodrum-blue-dark'
          }`}
        >
          {cat}
        </button>
      ))}
    </div>
  </div>

  <div class="max-w-[1280px] mx-auto px-5 md:px-12 py-12 space-y-16">
    
    <!-- Öne Çıkan Söyleşiler -->
    <section>
      <h2 class="font-serif text-2xl sm:text-3xl text-ink font-bold mb-6 pb-3 border-b border-sand">
        Öne Çıkan Söyleşiler
      </h2>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        {featuredTalks.map((talk) => (
          <div class="bg-surface-container-low border-2 border-olive p-6 sm:p-8 flex flex-col justify-between shadow-xs rounded-xs">
            <div>
              <!-- Video Thumbnail with Play Button Overlay -->
              <div 
                class="relative aspect-[16/9] overflow-hidden bg-black mb-5 cursor-pointer group border border-sand rounded-2xs"
                data-youtube-id={talk.data.youtubeId}
              >
                <img
                  src={talk.data.thumbnail}
                  alt={talk.data.titleTr}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                />
                
                <div class="absolute inset-0 bg-gradient-to-t from-ink/70 via-transparent to-transparent flex items-center justify-center">
                  <div class="w-14 h-14 rounded-full bg-olive text-white flex items-center justify-center shadow-lg group-hover:scale-110 transition-transform">
                    <span class="material-symbols-outlined text-3xl">play_arrow</span>
                  </div>
                </div>

                <div class="absolute bottom-3 right-3 px-2 py-0.5 bg-black/80 text-white font-mono text-xs rounded-xs">
                  {talk.data.duration}
                </div>
              </div>

              <div class="flex items-center justify-between text-xs text-stone-gray font-mono mb-2">
                <span class="text-olive font-serif font-bold text-sm">{talk.data.guestTr}</span>
                <span class="font-bold">{talk.data.date}</span>
              </div>

              <h3 class="font-serif text-xl sm:text-2xl text-ink font-bold leading-tight mb-3">
                {talk.data.titleTr}
              </h3>

              <p class="font-serif text-base text-ink/85 leading-relaxed mb-6 text-justify">
                {talk.data.summaryTr}
              </p>
            </div>

            <button
              type="button"
              data-youtube-id={talk.data.youtubeId}
              class="w-full py-3 bg-olive hover:bg-bodrum-blue-dark text-white text-xs sm:text-sm font-serif font-bold uppercase tracking-wider transition-colors flex items-center justify-center gap-2 shadow-xs rounded-xs"
            >
              <span class="material-symbols-outlined text-base">play_circle</span>
              <span>Videoyu İzle</span>
            </button>
          </div>
        ))}
      </div>
    </section>

    <!-- Diğer Söyleşiler ve Kayıtlar -->
    <section>
      <h2 class="font-serif text-2xl sm:text-3xl text-ink font-bold mb-6 pb-3 border-b border-sand">
        Diğer Söyleşiler ve Kayıtlar
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {otherTalks.map((talk) => (
          <div class="bg-surface-container-low border-2 border-olive p-6 flex flex-col justify-between shadow-xs rounded-xs">
            <div>
              <div 
                class="relative aspect-[16/9] overflow-hidden bg-black mb-4 cursor-pointer group border border-sand rounded-2xs"
                data-youtube-id={talk.data.youtubeId}
              >
                <img
                  src={talk.data.thumbnail}
                  alt={talk.data.titleTr}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                />
                <div class="absolute inset-0 flex items-center justify-center">
                  <div class="w-12 h-12 rounded-full bg-olive text-white flex items-center justify-center shadow group-hover:scale-110 transition-transform">
                    <span class="material-symbols-outlined text-3xl">play_arrow</span>
                  </div>
                </div>
                <div class="absolute bottom-2 right-2 px-1.5 py-0.5 bg-black/80 text-white font-mono text-[10px]">
                  {talk.data.duration}
                </div>
              </div>

              <div class="text-sm text-olive font-serif font-bold mb-1">
                {talk.data.guestTr}
              </div>

              <h3 class="font-serif text-lg sm:text-xl text-ink font-bold leading-snug mb-2">
                {talk.data.titleTr}
              </h3>

              <p class="font-serif text-sm text-ink/75 leading-relaxed mb-4 text-justify">
                {talk.data.summaryTr}
              </p>
            </div>

            <button
              type="button"
              data-youtube-id={talk.data.youtubeId}
              class="w-full py-2.5 bg-parchment border border-olive text-olive hover:bg-olive hover:text-white text-xs font-serif font-bold uppercase tracking-wider transition-colors flex items-center justify-center gap-1.5 rounded-xs"
            >
              <span>İzle</span>
              <span class="material-symbols-outlined text-xs">arrow_forward</span>
            </button>
          </div>
        ))}
      </div>
    </section>

  </div>
</Layout>
