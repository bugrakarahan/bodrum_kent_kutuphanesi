---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { getT } from '../utils/i18n';

const lang = 'tr';
const t = getT(lang);

const allTalks = await getCollection('talks');
const featuredTalks = allTalks.filter((t) => t.data.featured);
const pastTalks = allTalks.filter((t) => !t.data.featured);

const categories = [
  "HEPSİ", "EDEBİYAT", "KÜLTÜR", "SANAT", "TARİH", "ANTİK TARİH", "ARKEOLOJİ", "FELSEFE", "SOSYOLOJİ", "PSİKOLOJİ", "BİLİM", "EKOLOJİ"
];
---

<Layout
  title={`Söyleşiler | ${t.siteTitle}`}
  description="Kültür, sanat, toplumsal ve bilimsel dünyamızı aydınlatan yazarlar, akademisyenler ve araştırmacılar ile söyleşiler."
  lang={lang}
  currentPath="/soylesiler"
>
  <!-- Hero Section -->
  <section class="py-16 md:py-24 px-5 md:px-12 bg-surface-bright border-b border-sand">
    <div class="max-w-[1280px] mx-auto">
      <div class="max-w-3xl">
        <h1 class="font-serif text-3xl sm:text-4xl md:text-5xl text-ink font-bold leading-tight mb-4">
          Kültür, Sanat ve Bilim Söyleşileri
        </h1>
        <p class="font-serif text-lg sm:text-xl text-ink/80 leading-relaxed">
          Kültür, sanat, toplumsal ve bilimsel dünyamızı aydınlatan ve zenginleştiren yazarlar, sanatçılar, bilim insanları ve araştırmacılar ile yaptığımız sohbetlerin video kayıtları.
        </p>
      </div>
    </div>
  </section>

  <!-- Category Pills Bar -->
  <div class="border-b border-sand bg-parchment py-4 px-5 md:px-12 sticky top-20 z-30 overflow-x-auto">
    <div class="max-w-[1280px] mx-auto flex items-center gap-2 min-w-max">
      {categories.map((cat, idx) => (
        <button
          type="button"
          class={`px-3.5 py-1.5 text-xs font-serif font-semibold uppercase tracking-wider transition-colors ${
            idx === 0
              ? 'bg-olive text-white shadow-xs'
              : 'bg-surface-container-low border border-sand text-ink hover:border-olive hover:text-olive'
          }`}
        >
          {cat}
        </button>
      ))}
    </div>
  </div>

  <div class="max-w-[1280px] mx-auto px-5 md:px-12 py-16 space-y-20">
    
    <!-- Öne Çıkan Oturumlar (Timuçin Binder vb.) -->
    <section>
      <h2 class="font-serif text-2xl sm:text-3xl text-ink font-bold mb-8 pb-3 border-b border-sand">
        Öne Çıkan Oturumlar
      </h2>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        {featuredTalks.map((talk) => (
          <div class="bg-surface-container-low border border-sand p-6 flex flex-col justify-between shadow-xs">
            <div>
              <!-- Video Thumbnail with Play Button -->
              <div 
                class="relative aspect-[16/9] overflow-hidden bg-black mb-5 cursor-pointer group"
                data-youtube-id={talk.data.youtubeId}
              >
                <img
                  src={talk.data.thumbnail}
                  alt={talk.data.titleTr}
                  class="w-full h-full object-cover opacity-90 group-hover:opacity-100 group-hover:scale-105 transition-all duration-500"
                />
                
                <div class="absolute inset-0 bg-gradient-to-t from-ink/80 via-transparent to-transparent flex items-center justify-center">
                  <div class="w-14 h-14 rounded-full bg-olive text-white flex items-center justify-center shadow-lg group-hover:scale-110 transition-transform">
                    <span class="material-symbols-outlined text-3xl">play_arrow</span>
                  </div>
                </div>

                <div class="absolute bottom-3 right-3 px-2 py-0.5 bg-black/80 text-white font-mono text-xs rounded-xs">
                  {talk.data.duration}
                </div>
              </div>

              <div class="flex items-center justify-between text-xs text-stone-gray font-mono mb-2">
                <span class="text-olive font-serif font-bold">{talk.data.guestTr}</span>
                <span>{talk.data.date}</span>
              </div>

              <h3 class="font-serif text-xl sm:text-2xl text-ink font-bold leading-tight mb-3">
                {talk.data.titleTr}
              </h3>

              <p class="font-serif text-sm text-ink/80 leading-relaxed mb-6">
                {talk.data.summaryTr}
              </p>
            </div>

            <button
              type="button"
              data-youtube-id={talk.data.youtubeId}
              class="w-full py-3 bg-ink hover:bg-olive text-parchment text-xs font-serif font-semibold uppercase tracking-wider transition-colors flex items-center justify-center gap-2"
            >
              <span class="material-symbols-outlined text-sm">play_circle</span>
              <span>Videoyu İzle</span>
            </button>
          </div>
        ))}
      </div>
    </section>

    <!-- Geçmiş Söyleşiler ve Kayıtlar -->
    <section>
      <h2 class="font-serif text-2xl sm:text-3xl text-ink font-bold mb-8 pb-3 border-b border-sand">
        Geçmiş Söyleşiler ve Kayıtlar
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {pastTalks.map((talk) => (
          <div class="bg-surface-container-low border border-sand p-6 flex flex-col justify-between">
            <div>
              <div 
                class="relative aspect-[16/9] overflow-hidden bg-black mb-4 cursor-pointer group border border-sand"
                data-youtube-id={talk.data.youtubeId}
              >
                <img
                  src={talk.data.thumbnail}
                  alt={talk.data.titleTr}
                  class="w-full h-full object-cover opacity-90 group-hover:opacity-100 transition-opacity duration-300"
                />
                <div class="absolute inset-0 flex items-center justify-center">
                  <div class="w-10 h-10 rounded-full bg-olive text-white flex items-center justify-center shadow group-hover:scale-110 transition-transform">
                    <span class="material-symbols-outlined text-2xl">play_arrow</span>
                  </div>
                </div>
                <div class="absolute bottom-2 right-2 px-1.5 py-0.5 bg-black/80 text-white font-mono text-[10px]">
                  {talk.data.duration}
                </div>
              </div>

              <div class="text-xs text-olive font-serif font-bold mb-1">
                {talk.data.guestTr}
              </div>

              <h3 class="font-serif text-lg text-ink font-bold leading-snug mb-2">
                {talk.data.titleTr}
              </h3>

              <p class="font-serif text-xs text-ink/75 leading-relaxed mb-4">
                {talk.data.summaryTr}
              </p>
            </div>

            <button
              type="button"
              data-youtube-id={talk.data.youtubeId}
              class="w-full py-2 bg-parchment border border-sand hover:border-olive hover:text-olive text-xs font-serif font-semibold uppercase tracking-wider transition-colors flex items-center justify-center gap-1.5"
            >
              <span>İzle</span>
              <span class="material-symbols-outlined text-xs">arrow_forward</span>
            </button>
          </div>
        ))}
      </div>
    </section>

  </div>
</Layout>
