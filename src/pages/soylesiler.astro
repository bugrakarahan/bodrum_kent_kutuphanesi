---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { getT } from '../utils/i18n';

const lang = 'tr';
const t = getT(lang);

const allTalks = await getCollection('talks');

const categories = [
  "TÜMÜ", "YAZARLAR", "EDEBİYAT", "KÜLTÜR", "SANAT", "TARİH", "FELSEFE", "ARKEOLOJİ", "SOSYOLOJİ", "PSİKOLOJİ", "EKOLOJİ", "BİLİM"
];
---

<Layout
  title={`Söyleşiler | ${t.siteTitle}`}
  description="Kültür, sanat, toplumsal ve bilimsel dünyamızı aydınlatan yazarlar, akademisyenler ve araştırmacılar ile söyleşiler."
  lang={lang}
  currentPath="/soylesiler"
>
  <!-- Hero Section -->
  <section class="py-10 md:py-14 px-5 md:px-12 bg-surface-bright border-b border-sand">
    <div class="max-w-[1280px] mx-auto">
      <div class="max-w-3xl">
        <h1 class="font-serif text-3xl sm:text-4xl text-ink font-bold leading-tight mb-3">
          Kültür, Sanat ve Bilim Söyleşileri
        </h1>
        <p class="font-sans text-base sm:text-lg text-ink/80 leading-relaxed">
          Kültür, sanat, toplumsal ve bilimsel dünyamızı aydınlatan ve zenginleştiren yazarlar, sanatçılar, bilim insanları ve araştırmacılar ile yaptığımız sohbetlerin video kayıtları.
        </p>
      </div>
    </div>
  </section>

  <!-- Category Pills Bar: Centered, Single Line in Bodrum Blue -->
  <div class="border-b border-sand bg-parchment py-3.5 px-5 md:px-12 sticky top-20 z-30 overflow-x-auto">
    <div class="max-w-[1280px] mx-auto flex items-center justify-center gap-2 min-w-max">
      {categories.map((cat, idx) => (
        <button
          type="button"
          class={`px-3 py-1.5 text-xs font-sans font-bold uppercase tracking-wider rounded-xs transition-colors shadow-2xs ${
            idx === 0
              ? 'bg-olive text-white ring-2 ring-olive/40'
              : 'bg-olive text-white hover:bg-bodrum-blue-dark'
          }`}
        >
          {cat}
        </button>
      ))}
    </div>
  </div>

  <!-- Söyleşiler Grid (3 columns per row with interactive Chapters) -->
  <div class="max-w-[1280px] mx-auto px-5 md:px-12 py-10 md:py-14">
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {allTalks.map((talk) => (
        <div class="bg-surface-container-low border-2 border-olive p-5 flex flex-col justify-between shadow-xs rounded-xs">
          <div>
            <!-- Video Thumbnail with Play Button Overlay -->
            <div 
              class="relative aspect-[16/9] overflow-hidden bg-black mb-4 cursor-pointer group border border-sand rounded-2xs"
              data-youtube-id={talk.data.youtubeId}
              data-video-title={talk.data.titleTr}
              data-video-subtitle={talk.data.guestTr}
            >
              <img
                src={talk.data.thumbnail}
                alt={talk.data.titleTr}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
              
              <div class="absolute inset-0 bg-gradient-to-t from-ink/70 via-transparent to-transparent flex items-center justify-center">
                <div class="w-12 h-12 rounded-full bg-olive text-white flex items-center justify-center shadow-lg group-hover:scale-110 transition-transform">
                  <span class="material-symbols-outlined text-2xl">play_arrow</span>
                </div>
              </div>

              <div class="absolute bottom-2.5 right-2.5 px-2 py-0.5 bg-black/80 text-white font-mono text-[11px] rounded-xs">
                {talk.data.duration}
              </div>
            </div>

            <!-- Moderator & Date Header -->
            <div class="flex items-center justify-between text-xs text-stone-gray font-mono mb-2 pb-1 border-b border-sand/60">
              <span class="text-olive font-sans font-bold text-xs">{talk.data.guestTr}</span>
              <span class="font-bold">{talk.data.date}</span>
            </div>

            <!-- 2-line Title -->
            <h3 class="font-serif text-lg sm:text-xl text-ink font-bold leading-snug mb-3 whitespace-pre-line">
              {talk.data.titleTr}
            </h3>

            <p class="font-sans text-xs sm:text-sm text-ink/85 leading-relaxed mb-4 text-justify">
              {talk.data.summaryTr}
            </p>

            <!-- Video Chapters / Zaman Damgaları -->
            {talk.data.chapters && talk.data.chapters.length > 0 && (
              <div class="mt-4 pt-3 border-t border-sand/80">
                <div class="text-[11px] uppercase tracking-wider font-bold text-stone-gray mb-2 flex items-center gap-1">
                  <span class="material-symbols-outlined text-[14px] text-olive">bookmarks</span>
                  <span>Önemli Başlıklar (Zaman Damgaları)</span>
                </div>
                <div class="space-y-1.5">
                  {talk.data.chapters.map((chap) => (
                    <button
                      type="button"
                      data-youtube-id={talk.data.youtubeId}
                      data-start-time={chap.seconds}
                      data-video-title={talk.data.titleTr}
                      data-video-subtitle={`${chap.time} - ${chap.titleTr}`}
                      class="w-full text-left flex items-center justify-between px-2.5 py-1.5 bg-parchment hover:bg-bodrum-blue-light border border-sand/70 rounded-2xs text-xs transition-colors group cursor-pointer"
                    >
                      <span class="text-ink font-sans font-medium text-[12px] group-hover:text-olive truncate mr-2">
                        {chap.titleTr}
                      </span>
                      <span class="font-mono text-[11px] font-bold text-olive bg-olive/10 px-1.5 py-0.5 rounded-2xs shrink-0">
                        {chap.time}
                      </span>
                    </button>
                  ))}
                </div>
              </div>
            )}
          </div>

          <button
            type="button"
            data-youtube-id={talk.data.youtubeId}
            data-video-title={talk.data.titleTr}
            data-video-subtitle={talk.data.guestTr}
            class="w-full py-2.5 bg-olive hover:bg-bodrum-blue-dark text-white text-xs font-sans font-bold uppercase tracking-wider transition-colors flex items-center justify-center gap-1.5 shadow-xs rounded-xs mt-4"
          >
            <span class="material-symbols-outlined text-sm">play_circle</span>
            <span>Videoyu Baştan İzle</span>
          </button>
        </div>
      ))}
    </div>

  </div>
</Layout>
