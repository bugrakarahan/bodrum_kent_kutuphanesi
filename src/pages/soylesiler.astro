---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { getT } from '../utils/i18n';

const lang = 'tr';
const t = getT(lang);

const allTalks = await getCollection('talks');
const topRowTalks = allTalks.filter((t) => t.data.id === 'talk-timucin-binder-1');
const bottomRowTalks = allTalks.filter((t) => t.data.id !== 'talk-timucin-binder-1');
---

<Layout
  title={`Söyleşiler | ${t.siteTitle}`}
  description="Bodrum Kent Kütüphanesi söyleşi kayıtları, yazarlar, akademisyenler ve araştırmacılar ile buluşmalar."
  lang={lang}
  currentPath="/soylesiler"
>
  <!-- Hero Header (Standardized Scale) -->
  <section class="py-6 md:py-10 px-5 md:px-12 bg-surface-bright border-b border-sand">
    <div class="max-w-[1280px] mx-auto">
      <div class="max-w-3xl">
        <h1 class="font-serif text-xl sm:text-2xl text-ink font-bold leading-snug mb-2">
          Edebiyat, Sanat ve Bilim Söyleşileri
        </h1>
        <p class="font-sans text-xs sm:text-sm text-ink/80 leading-relaxed">
          Edebiyatçılar, akademisyenler, tarihçiler ve araştırmacılarla gerçekleştirdiğimiz derinlikli dijital video söyleşi arşivimiz.
        </p>
      </div>
    </div>
  </section>

  <!-- Video Rows Container -->
  <div class="max-w-[1280px] mx-auto px-5 md:px-12 py-6 md:py-10 space-y-8">
    
    <!-- Üst Sıra: Timuçin Binder 1. Bölüm (Gelecek söyleşilerle dolacak 3 sütunlu yapı) -->
    <div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {topRowTalks.map((talk) => (
          <div class="bg-surface-container-low border-2 border-olive rounded-xs p-4 sm:p-5 flex flex-col justify-between shadow-xs hover:shadow-md transition-shadow">
            <div>
              <!-- Video Thumbnail with YouTube Trigger -->
              <div
                class="aspect-video relative overflow-hidden bg-surface-container-high border border-sand cursor-pointer group rounded-2xs mb-3.5"
                data-youtube-id={talk.data.youtubeId}
              >
                <img
                  src={talk.data.thumbnail}
                  alt={talk.data.titleTr}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                />
                <div class="absolute inset-0 bg-ink/30 group-hover:bg-ink/10 transition-colors flex items-center justify-center">
                  <div class="w-10 h-10 rounded-full bg-olive/90 text-white flex items-center justify-center shadow-lg group-hover:scale-110 transition-transform">
                    <span class="material-symbols-outlined text-2xl ml-0.5">play_arrow</span>
                  </div>
                </div>
                <span class="absolute bottom-2 right-2 px-2 py-0.5 bg-ink/85 text-parchment text-[11px] font-mono rounded">
                  {talk.data.duration}
                </span>
              </div>

              <!-- Meta Information: Tam Görünen Moderatör ve Tarih -->
              <div class="flex items-center justify-between text-xs text-stone-gray font-mono mb-2">
                <span class="text-olive font-sans font-bold text-xs uppercase">{talk.data.guestTr}</span>
                <span class="font-bold shrink-0">{talk.data.date}</span>
              </div>

              <!-- Talk Title: Formatlı ve Ortalanmış -->
              <h2 class="font-serif text-base sm:text-lg text-ink font-bold mb-2.5 leading-snug whitespace-pre-line text-center">
                {talk.data.titleTr}
              </h2>

              <p class="text-xs sm:text-[13px] text-ink/85 font-sans leading-relaxed mb-3.5 text-justify">
                {talk.data.summaryTr}
              </p>

              <!-- Video Chapters Timeline -->
              {talk.data.chapters && talk.data.chapters.length > 0 && (
                <div class="mb-3.5 p-2.5 bg-parchment border border-sand rounded-xs space-y-1">
                  <div class="flex items-center gap-1 text-[10px] font-sans font-bold uppercase tracking-wider text-olive mb-1">
                    <span class="material-symbols-outlined text-xs">schedule</span>
                    <span>Bölümler</span>
                  </div>
                  <div class="grid grid-cols-1 gap-1 text-xs font-sans">
                    {talk.data.chapters.map((chap) => (
                      <button
                        type="button"
                        class="chapter-btn flex items-center justify-between p-1 hover:bg-olive/10 rounded text-left transition-colors cursor-pointer w-full group/chap"
                        data-youtube-id={talk.data.youtubeId}
                        data-start={chap.seconds}
                      >
                        <span class="text-ink/90 group-hover/chap:text-olive font-medium truncate mr-2">{chap.titleTr}</span>
                        <span class="font-mono text-stone-gray font-bold text-[11px] bg-sand/40 px-1.5 py-0.5 rounded shrink-0">{chap.time}</span>
                      </button>
                    ))}
                  </div>
                </div>
              )}
            </div>

            <div class="pt-3 border-t border-sand flex items-center justify-between">
              <button
                type="button"
                class="inline-flex items-center gap-1.5 text-xs font-sans font-bold text-olive hover:text-bodrum-blue-dark uppercase tracking-wider cursor-pointer"
                data-youtube-id={talk.data.youtubeId}
              >
                <span class="material-symbols-outlined text-base">play_circle</span>
                <span>İzle</span>
              </button>
              <span class="text-xs font-sans text-stone-gray">{talk.data.roleTr}</span>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Alt Sıra: Timuçin Binder 2. Bölüm, Mine Söğüt, Nazlı Eray (3 Sütun) -->
    <div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {bottomRowTalks.map((talk) => (
          <div class="bg-surface-container-low border-2 border-olive rounded-xs p-4 sm:p-5 flex flex-col justify-between shadow-xs hover:shadow-md transition-shadow">
            <div>
              <!-- Video Thumbnail with YouTube Trigger -->
              <div
                class="aspect-video relative overflow-hidden bg-surface-container-high border border-sand cursor-pointer group rounded-2xs mb-3.5"
                data-youtube-id={talk.data.youtubeId}
              >
                <img
                  src={talk.data.thumbnail}
                  alt={talk.data.titleTr}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                />
                <div class="absolute inset-0 bg-ink/30 group-hover:bg-ink/10 transition-colors flex items-center justify-center">
                  <div class="w-10 h-10 rounded-full bg-olive/90 text-white flex items-center justify-center shadow-lg group-hover:scale-110 transition-transform">
                    <span class="material-symbols-outlined text-2xl ml-0.5">play_arrow</span>
                  </div>
                </div>
                <span class="absolute bottom-2 right-2 px-2 py-0.5 bg-ink/85 text-parchment text-[11px] font-mono rounded">
                  {talk.data.duration}
                </span>
              </div>

              <!-- Meta Information -->
              <div class="flex items-center justify-between text-xs text-stone-gray font-mono mb-2">
                <span class="text-olive font-sans font-bold text-xs uppercase">{talk.data.guestTr}</span>
                <span class="font-bold shrink-0">{talk.data.date}</span>
              </div>

              <!-- Talk Title -->
              <h2 class="font-serif text-base sm:text-lg text-ink font-bold mb-2.5 leading-snug whitespace-pre-line text-center">
                {talk.data.titleTr}
              </h2>

              <p class="text-xs sm:text-[13px] text-ink/85 font-sans leading-relaxed mb-3.5 text-justify">
                {talk.data.summaryTr}
              </p>

              <!-- Video Chapters Timeline -->
              {talk.data.chapters && talk.data.chapters.length > 0 && (
                <div class="mb-3.5 p-2.5 bg-parchment border border-sand rounded-xs space-y-1">
                  <div class="flex items-center gap-1 text-[10px] font-sans font-bold uppercase tracking-wider text-olive mb-1">
                    <span class="material-symbols-outlined text-xs">schedule</span>
                    <span>Bölümler</span>
                  </div>
                  <div class="grid grid-cols-1 gap-1 text-xs font-sans">
                    {talk.data.chapters.map((chap) => (
                      <button
                        type="button"
                        class="chapter-btn flex items-center justify-between p-1 hover:bg-olive/10 rounded text-left transition-colors cursor-pointer w-full group/chap"
                        data-youtube-id={talk.data.youtubeId}
                        data-start={chap.seconds}
                      >
                        <span class="text-ink/90 group-hover/chap:text-olive font-medium truncate mr-2">{chap.titleTr}</span>
                        <span class="font-mono text-stone-gray font-bold text-[11px] bg-sand/40 px-1.5 py-0.5 rounded shrink-0">{chap.time}</span>
                      </button>
                    ))}
                  </div>
                </div>
              )}
            </div>

            <div class="pt-3 border-t border-sand flex items-center justify-between">
              <button
                type="button"
                class="inline-flex items-center gap-1.5 text-xs font-sans font-bold text-olive hover:text-bodrum-blue-dark uppercase tracking-wider cursor-pointer"
                data-youtube-id={talk.data.youtubeId}
              >
                <span class="material-symbols-outlined text-base">play_circle</span>
                <span>İzle</span>
              </button>
              <span class="text-xs font-sans text-stone-gray">{talk.data.roleTr}</span>
            </div>
          </div>
        ))}
      </div>
    </div>

  </div>
</Layout>

<script>
  document.querySelectorAll('.chapter-btn').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const target = e.currentTarget as HTMLElement;
      const youtubeId = target.getAttribute('data-youtube-id');
      const start = target.getAttribute('data-start') || '0';
      if (youtubeId && (window as any).openVideoModal) {
        (window as any).openVideoModal(youtubeId, parseInt(start, 10));
      }
    });
  });
</script>
