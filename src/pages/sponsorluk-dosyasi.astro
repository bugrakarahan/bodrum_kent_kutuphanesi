---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const board = await getCollection('board');
const sortedBoard = board.sort((a, b) => a.data.order - b.data.order);
---

<Layout 
  title="Destek ve Gönüllü Katılım Dosyası | Bodrum Kent Kütüphanesi"
  description="Bodrum Kent Kütüphanesi Destek, Katılım ve Kültür Hamiliği Tanıtım Dosyası."
  lang="tr"
>
  <div class="bg-parchment min-h-screen py-10 md:py-16 text-ink print:bg-white print:py-0">
    <div class="max-w-[960px] mx-auto px-5 sm:px-8 print:px-0">
      
      <!-- Top Action Bar (Hidden on Print) -->
      <div class="flex items-center justify-between gap-4 pb-8 mb-8 border-b border-sand print:hidden">
        <a 
          href="/destek" 
          class="inline-flex items-center gap-2 text-xs font-serif font-semibold uppercase tracking-wider text-ink hover:text-olive transition-colors"
        >
          <span class="material-symbols-outlined text-sm">arrow_back</span>
          <span>Destek Sayfasına Dön</span>
        </a>

        <div class="flex items-center gap-3">
          <button 
            type="button" 
            onclick="window.print()" 
            class="px-5 py-2.5 bg-ink text-parchment hover:bg-olive text-xs font-serif font-semibold uppercase tracking-wider transition-all flex items-center gap-2 shadow-xs"
          >
            <span class="material-symbols-outlined text-base">print</span>
            <span>Yazdır / PDF Kaydet</span>
          </button>
        </div>
      </div>

      <!-- Dossier Document Container -->
      <article class="bg-surface-container-low border border-sand p-8 sm:p-14 shadow-xs print:shadow-none print:border-none print:p-0">
        
        <!-- Document Cover Header -->
        <header class="text-center pb-10 mb-10 border-b-2 border-ink/20 relative">
          <div class="inline-flex items-center gap-2 px-3 py-1 bg-olive/10 border border-olive/20 rounded-full text-olive text-[11px] font-serif font-semibold uppercase tracking-widest mb-4">
            BODRUM KENT KÜTÜPHANESİ GİRİŞİMİ
          </div>

          <h1 class="font-serif text-3xl sm:text-4xl text-ink font-bold leading-tight mb-3">
            Bodrum Kent Kütüphanesi
          </h1>
          
          <p class="font-serif italic text-lg sm:text-xl text-olive mb-4">
            Destek ve Gönüllü Katılım Tanıtım Dosyası
          </p>

          <div class="flex items-center justify-center gap-4 text-xs uppercase tracking-widest text-stone-gray font-mono">
            <span>Yer: Kızılağaç, Bodrum</span>
            <span>•</span>
            <span>Tel: +90 (0) 542 373 97 48</span>
          </div>
        </header>

        <!-- Section 1: Executive Summary -->
        <section class="mb-10">
          <h2 class="font-serif text-2xl text-ink font-bold mb-4 pb-2 border-b border-sand flex items-center gap-2">
            <span class="text-olive font-mono text-lg">01.</span>
            <span>Amaç ve Tanıtım</span>
          </h2>
          
          <p class="font-serif text-sm sm:text-base text-ink/90 leading-relaxed mb-4">
            Bodrum Kent Kütüphanesi, Bodrum’da yaşayanlar ile kenti ziyaret eden kitapseverleri, edebiyat, sanat ve bilim dünyasının değerli isimleriyle ve kitaplarıyla buluşturmayı amaçlayan, çok amaçlı ve yaşayan bir kütüphane projesidir. Kitap merkezli etkinlikler, söyleşiler, atölyeler ve kültürel buluşmalar aracılığıyla yaşam boyu öğrenmeyi, üretimi ve paylaşımı destekleyen, Akdeniz ve Anadolu hümanizmasını koruyan, bağımsız bir buluşma alanı olarak tasarlanmaktadır.
          </p>
          
          <p class="font-serif text-sm sm:text-base text-ink/90 leading-relaxed mb-4">
            Bodrum Kent Kütüphanesi ismi ve fikri, ilk olarak, 16.09.2019 tarihinde Dibeklihan Kültür ve Sanat Köyü’nde dile getirilmiş ve Sayın Sönmez Taner tarafından 7 Eylül 2019 tarihinde Zeytin Taneleri Kütüphanesi ekibine emanet edilmiştir.
          </p>
        </section>

        <!-- Section 2: Founding Committee -->
        <section class="mb-10">
          <h2 class="font-serif text-2xl text-ink font-bold mb-4 pb-2 border-b border-sand flex items-center gap-2">
            <span class="text-olive font-mono text-lg">02.</span>
            <span>Girişim Kurulumuz</span>
          </h2>

          <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
            {sortedBoard.map((member) => (
              <div class="p-3 bg-parchment border border-sand text-xs font-serif">
                <span class="font-bold text-ink block">{member.data.name}</span>
                <span class="text-stone-gray text-[11px] italic">{member.data.roleTr}</span>
              </div>
            ))}
          </div>
        </section>

        <!-- Section 3: Destek Türleri -->
        <section class="mb-10">
          <h2 class="font-serif text-2xl text-ink font-bold mb-4 pb-2 border-b border-sand flex items-center gap-2">
            <span class="text-olive font-mono text-lg">03.</span>
            <span>Katkı ve Destek Alanları</span>
          </h2>

          <ul class="space-y-3 text-xs sm:text-sm text-ink/85 font-serif">
            <li><strong>• Kitap Bağışı:</strong> Koleksiyonu zenginleştirmek üzere özellikle tarih, edebiyat, arkeoloji ve sanat kitapları.</li>
            <li><strong>• Bilgi ve Uzmanlık:</strong> Yazar, araştırmacı, akademisyen ve sanatçı olarak etkinliklere katılım.</li>
            <li><strong>• Maddi Destek:</strong> Kütüphanenin gelişimi ve yayın/araştırma projelerinin gerçekleştirilmesine katkı.</li>
            <li><strong>• Gönüllülük:</strong> Organizasyon, iletişim ve kütüphane içi çalışmalarda aktif görev alma.</li>
            <li><strong>• Araştırma & Proje:</strong> Sözlü tarih, arşiv ve yerel belgeleme çalışmalarına destek.</li>
            <li><strong>• Mekân & Ekipman:</strong> Etkinlikler ve atölyeler için teknik ekipman ve yer paylaşımı.</li>
          </ul>
        </section>

        <!-- Section 4: Contact & Process -->
        <footer class="pt-6 border-t-2 border-ink/20">
          <h2 class="font-serif text-xl text-ink font-bold mb-4">İletişim ve Koordinasyon</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs font-serif">
            <div class="bg-parchment p-4 border border-sand">
              <span class="text-stone-gray block mb-1 font-mono uppercase">Telefon & E-Posta</span>
              <div class="font-bold text-ink text-sm">+90 (0) 542 373 97 48</div>
              <a href="mailto:destek@bodrumkentkutuphanesi.org" class="font-semibold text-olive hover:underline block mt-1">
                destek@bodrumkentkutuphanesi.org
              </a>
            </div>

            <div class="bg-parchment p-4 border border-sand">
              <span class="text-stone-gray block mb-1 font-mono uppercase">Web & Adres</span>
              <div class="font-bold text-ink text-sm">bodrumkentkutuphanesi.pages.dev</div>
              <span class="text-stone-gray mt-1 block">Kızılağaç, Bodrum / Muğla</span>
            </div>
          </div>
        </footer>

      </article>

    </div>
  </div>
</Layout>

<style>
  @media print {
    body {
      background-color: #ffffff !important;
      color: #000000 !important;
    }
    header, footer, nav {
      display: none !important;
    }
  }
</style>
