---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const board = await getCollection('board');
const sortedBoard = board.sort((a, b) => a.data.order - b.data.order);
---

<Layout 
  title="Sponsorluk ve Kültür Hamiliği Dosyası | Bodrum Kent Kütüphanesi"
  description="Bodrum Kent Kütüphanesi 4-5 Eylül 2026 Büyük Açılış Lansmanı Kurumsal Sponsorluk ve Tanıtım Dosyası."
  lang="tr"
>
  <div class="bg-parchment min-h-screen py-10 md:py-16 text-ink print:bg-white print:py-0">
    <div class="max-w-[960px] mx-auto px-5 sm:px-8 print:px-0">
      
      <!-- Top Action Bar (Hidden on Print) -->
      <div class="flex items-center justify-between gap-4 pb-8 mb-8 border-b border-sand print:hidden">
        <a 
          href="/destek" 
          class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-ink hover:text-olive transition-colors"
        >
          <span class="material-symbols-outlined text-sm">arrow_back</span>
          <span>Sponsorluk Sayfasına Dön</span>
        </a>

        <div class="flex items-center gap-3">
          <button 
            type="button" 
            onclick="window.print()" 
            class="px-5 py-2.5 bg-ink text-parchment hover:bg-olive text-xs font-semibold uppercase tracking-wider transition-all flex items-center gap-2 shadow-sm"
          >
            <span class="material-symbols-outlined text-base">print</span>
            <span>Yazdır / PDF Kaydet</span>
          </button>
        </div>
      </div>

      <!-- Dossier Document Container -->
      <article class="bg-surface-container-low border border-sand p-8 sm:p-14 shadow-sm print:shadow-none print:border-none print:p-0">
        
        <!-- Document Cover Header -->
        <header class="text-center pb-12 mb-12 border-b-2 border-ink/20 relative">
          <div class="inline-flex items-center gap-2 px-3 py-1 bg-olive/10 border border-olive/20 rounded-full text-olive text-[11px] font-semibold uppercase tracking-widest mb-4">
            BODRUM KENT KÜTÜPHANESİ GİRİŞİMİ
          </div>

          <h1 class="font-serif text-3xl sm:text-5xl text-ink font-bold leading-tight mb-4">
            4-5 Eylül 2026 Büyük Açılış Lansmanı & Sempozyumu
          </h1>
          
          <p class="font-serif italic text-xl sm:text-2xl text-olive mb-6">
            Kurumsal Sponsorluk ve Kültür Hamiliği Dosyası
          </p>

          <div class="flex items-center justify-center gap-6 text-xs uppercase tracking-widest text-stone-gray font-mono">
            <span>Tarih: 4-5 Eylül 2026</span>
            <span>•</span>
            <span>Yer: Kızılağaç, Bodrum</span>
            <span>•</span>
            <span>Sürüm: 1.0</span>
          </div>
        </header>

        <!-- Section 1: Executive Summary -->
        <section class="mb-12">
          <h2 class="font-serif text-2xl text-ink font-bold mb-4 pb-2 border-b border-sand flex items-center gap-2">
            <span class="text-olive font-mono text-lg">01.</span>
            <span>Yönetici Özeti ve Vizyon</span>
          </h2>
          
          <p class="text-sm sm:text-base text-ink/85 leading-relaxed mb-4">
            Bodrum Kent Kütüphanesi; Bodrum’un kadim tarihini, denizcilik hafızasını ve <strong>Halikarnas Balıkçısı’nın (Cevat Şakir Kabaağaçlı)</strong> "Mavi Hümanizma" felsefesini korumak, yaşatmak ve gelecek kuşaklara aktarmak amacıyla hayata geçirilen bağımsız ve yaşayan bir kültür projesidir.
          </p>
          
          <p class="text-sm sm:text-base text-ink/85 leading-relaxed mb-4">
            İlk temelleri <strong>16.09.2019</strong> tarihinde Dibeklihan Kültür ve Sanat Köyü’nde atılan ve Sayın Sönmez Taner tarafından Zeytin Taneleri Kütüphanesi ekibine emanet edilen kütüphanemiz; araştırmacılar, yazarlar, öğrenciler ve tüm Bodrum sevdalıları için ilham verici bir sığınak olarak kapılarını açmaktadır.
          </p>

          <div class="bg-parchment p-5 border-l-4 border-olive my-6">
            <p class="font-serif italic text-sm sm:text-base text-ink/90">
              "Yokuş başına geldiğinde Bodrum'u göreceksin, sanma ki sen geldiğin gibi gideceksin. Senden öncekiler de böyleydiler; akıllarını hep Bodrum'da bırakıp gittiler..."
            </p>
            <span class="text-xs text-stone-gray block mt-2 font-mono">— Cevat Şakir Kabaağaçlı</span>
          </div>
        </section>

        <!-- Section 2: Founding Committee -->
        <section class="mb-12">
          <h2 class="font-serif text-2xl text-ink font-bold mb-4 pb-2 border-b border-sand flex items-center gap-2">
            <span class="text-olive font-mono text-lg">02.</span>
            <span>Girişim Kurulumuz</span>
          </h2>
          <p class="text-sm text-ink/80 mb-6">
            Kütüphanemizin kuruluşuna harç koyan ve projeyi titizlikle yöneten kurucu üyelerimiz:
          </p>

          <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
            {sortedBoard.map((member) => (
              <div class="p-3 bg-parchment border border-sand text-xs">
                <span class="font-semibold text-ink block">{member.data.name}</span>
                <span class="text-stone-gray text-[11px]">{member.data.roleTr}</span>
              </div>
            ))}
          </div>
        </section>

        <!-- Section 3: Event Agenda -->
        <section class="mb-12">
          <h2 class="font-serif text-2xl text-ink font-bold mb-4 pb-2 border-b border-sand flex items-center gap-2">
            <span class="text-olive font-mono text-lg">03.</span>
            <span>4-5 Eylül 2026 Lansman Program Akışı</span>
          </h2>

          <div class="space-y-6">
            <div class="bg-parchment p-6 border border-sand">
              <div class="flex items-center justify-between border-b border-sand pb-3 mb-4">
                <span class="font-serif text-lg font-bold text-ink">1. GÜN: 4 EYLÜL 2026, CUMA</span>
                <span class="text-xs font-mono text-olive font-semibold uppercase">Resmi Açılış & Kültür Mirası</span>
              </div>
              <ul class="space-y-2.5 text-xs sm:text-sm text-ink/80">
                <li class="flex items-start gap-2"><strong>14:00 - 14:30:</strong> Karşılama ve Kayıt</li>
                <li class="flex items-start gap-2"><strong>14:30 - 15:30:</strong> Açılış Töreni & Protokol / Girişim Kurulu Konuşmaları</li>
                <li class="flex items-start gap-2"><strong>15:30 - 16:15:</strong> Ana Sponsor ve Kurumsal Hamiler Teşekkür Plaketi Takdimi</li>
                <li class="flex items-start gap-2"><strong>16:30 - 17:45:</strong> 'Cevat Şakir’in Bodrum’u: Nadir Nüshalar ve İmzalı İlk Baskılar' Özel Sergi Açılışı</li>
                <li class="flex items-start gap-2"><strong>18:00 - 19:30:</strong> Akdeniz Müzikleri Dinletisi & Gün Batımı Açılış Resepsiyonu (Gala Kokteyli)</li>
              </ul>
            </div>

            <div class="bg-parchment p-6 border border-sand">
              <div class="flex items-center justify-between border-b border-sand pb-3 mb-4">
                <span class="font-serif text-lg font-bold text-ink">2. GÜN: 5 EYLÜL 2026, CUMARTESİ</span>
                <span class="text-xs font-mono text-olive font-semibold uppercase">Edebiyat, Deniz & Gelecek Sempozyumu</span>
              </div>
              <ul class="space-y-2.5 text-xs sm:text-sm text-ink/80">
                <li class="flex items-start gap-2"><strong>10:30 - 12:30:</strong> 1. Oturum: 'Mavi Sürgün'den Bugüne Ege Edebiyatı ve Kent Belleği' (Akademisyenler ve Yazarlar Paneli)</li>
                <li class="flex items-start gap-2"><strong>13:00 - 14:30:</strong> Çocuk Programı: 'Ege Mitolojisi, Masallar ve Resim Atölyesi'</li>
                <li class="flex items-start gap-2"><strong>15:00 - 17:00:</strong> 2. Oturum: 'Akdeniz’de Dijital Kütüphanecilik, Açık Bilim ve Yerel Arşivler'</li>
                <li class="flex items-start gap-2"><strong>17:30 - 19:00:</strong> Kapanış Oturumu, Değerlendirme & Kütüphane Bahçesi Buluşması</li>
              </ul>
            </div>
          </div>
        </section>

        <!-- Section 4: Sponsorship Matrix Table -->
        <section class="mb-12">
          <h2 class="font-serif text-2xl text-ink font-bold mb-4 pb-2 border-b border-sand flex items-center gap-2">
            <span class="text-olive font-mono text-lg">04.</span>
            <span>Sponsorluk Hakları ve Görünürlük Matrisi</span>
          </h2>

          <div class="overflow-x-auto border border-sand bg-parchment">
            <table class="w-full text-left text-xs border-collapse">
              <thead>
                <tr class="bg-ink text-parchment">
                  <th class="p-3 border-b border-sand/40">Görünürlük & Haklar</th>
                  <th class="p-3 border-b border-sand/40 text-center">Ana Destekçi (Platin)</th>
                  <th class="p-3 border-b border-sand/40 text-center">Kültür-Sanat (Altın)</th>
                  <th class="p-3 border-b border-sand/40 text-center">Atölye (Gümüş)</th>
                  <th class="p-3 border-b border-sand/40 text-center">Hizmet Destekçisi</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-sand">
                <tr>
                  <td class="p-3 font-semibold">Ana Sahne & Basın Arkalığı Logo</td>
                  <td class="p-3 text-center text-olive font-bold">En Üst / Birincil</td>
                  <td class="p-3 text-center text-ink/80">İkincil</td>
                  <td class="p-3 text-center text-stone-gray">-</td>
                  <td class="p-3 text-center text-stone-gray">-</td>
                </tr>
                <tr>
                  <td class="p-3 font-semibold">Açılışta Selamlama Konuşması</td>
                  <td class="p-3 text-center text-olive font-bold">✓ (5 dk)</td>
                  <td class="p-3 text-center text-stone-gray">-</td>
                  <td class="p-3 text-center text-stone-gray">-</td>
                  <td class="p-3 text-center text-stone-gray">-</td>
                </tr>
                <tr>
                  <td class="p-3 font-semibold">Kütüphanede Kalıcı Hami Plaketi</td>
                  <td class="p-3 text-center text-olive font-bold">Bronz / Özel</td>
                  <td class="p-3 text-center text-ink/80">Kalıcı Plaket</td>
                  <td class="p-3 text-center text-stone-gray">-</td>
                  <td class="p-3 text-center text-stone-gray">-</td>
                </tr>
                <tr>
                  <td class="p-3 font-semibold">Panel / Salon İsim Hakkı</td>
                  <td class="p-3 text-center text-olive font-bold">Ana Salon</td>
                  <td class="p-3 text-center text-ink/80">1 Panel İsmi</td>
                  <td class="p-3 text-center text-stone-gray">-</td>
                  <td class="p-3 text-center text-stone-gray">-</td>
                </tr>
                <tr>
                  <td class="p-3 font-semibold">Çocuk Atölyesi İsim Sponsorluğu</td>
                  <td class="p-3 text-center text-stone-gray">-</td>
                  <td class="p-3 text-center text-stone-gray">-</td>
                  <td class="p-3 text-center text-olive font-bold">✓ (1 Yıllık)</td>
                  <td class="p-3 text-center text-stone-gray">-</td>
                </tr>
                <tr>
                  <td class="p-3 font-semibold">VIP Protokol Masası Davetiyesi</td>
                  <td class="p-3 text-center text-olive font-bold">10 Kişilik</td>
                  <td class="p-3 text-center text-ink/80">5 Kişilik</td>
                  <td class="p-3 text-center text-ink/80">3 Kişilik</td>
                  <td class="p-3 text-center text-ink/80">2 Kişilik</td>
                </tr>
                <tr>
                  <td class="p-3 font-semibold">Basılı Program Kitapçığı Görünürlük</td>
                  <td class="p-3 text-center text-olive font-bold">Tam Sayfa</td>
                  <td class="p-3 text-center text-ink/80">Yarım Sayfa</td>
                  <td class="p-3 text-center text-ink/80">Çeyrek Sayfa</td>
                  <td class="p-3 text-center text-stone-gray">Logo</td>
                </tr>
                <tr>
                  <td class="p-3 font-semibold">Web Sitesi & E-Bülten Logo</td>
                  <td class="p-3 text-center text-olive font-bold">✓ (Öne Çıkan)</td>
                  <td class="p-3 text-center text-ink/80">✓</td>
                  <td class="p-3 text-center text-ink/80">✓</td>
                  <td class="p-3 text-center text-ink/80">✓</td>
                </tr>
              </tbody>
            </table>
          </div>
        </section>

        <!-- Section 5: Contact & Process -->
        <footer class="pt-8 border-t-2 border-ink/20">
          <h2 class="font-serif text-xl text-ink font-bold mb-4">İletişim ve Koordinasyon</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
            <div class="bg-parchment p-4 border border-sand">
              <span class="text-stone-gray block mb-1 font-mono uppercase">E-Posta</span>
              <a href="mailto:sponsorluk@bodrumkentkutuphanesi.org" class="font-semibold text-ink hover:text-olive text-sm">
                sponsorluk@bodrumkentkutuphanesi.org
              </a>
              <span class="block text-stone-gray mt-1">bilgi@bodrumkentkutuphanesi.org</span>
            </div>

            <div class="bg-parchment p-4 border border-sand">
              <span class="text-stone-gray block mb-1 font-mono uppercase">Web & Adres</span>
              <a href="https://bodrumkentkutuphanesi.pages.dev" class="font-semibold text-ink hover:text-olive text-sm block">
                bodrumkentkutuphanesi.pages.dev
              </a>
              <span class="text-stone-gray mt-1 block">Kızılağaç, Bodrum / Muğla</span>
            </div>
          </div>
        </footer>

      </article>

    </div>
  </div>
</Layout>

<style>
  @media print {
    body {
      background-color: #ffffff !important;
      color: #000000 !important;
    }
    header, footer, nav {
      display: none !important;
    }
  }
</style>
