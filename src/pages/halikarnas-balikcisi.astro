---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { getT } from '../utils/i18n';

const lang = 'tr';
const t = getT(lang);

// Fetch all 25 books from Content Collections sorted by order
const allBooks = await getCollection('books');
const books = allBooks.sort((a, b) => a.data.order - b.data.order);
---

<Layout
  title={`Halikarnas Balıkçısı Cevat Şakir Kabaağaçlı | ${t.siteTitle}`}
  description="Cevat Şakir Kabaağaçlı’nın (Halikarnas Balıkçısı) tüm 25 eseri, yaşamı ve Bodrum'un kültürel mirasına katkıları."
  lang={lang}
  currentPath="/halikarnas-balikcisi"
>
  <!-- 1. Hero Section -->
  <section class="relative min-h-[70vh] flex items-center py-16 md:py-24 px-5 md:px-12 overflow-hidden border-b border-sand bg-surface-bright">
    <div class="absolute -top-12 -right-12 md:top-8 md:right-12 ex-libris-watermark select-none pointer-events-none">
      <span class="material-symbols-outlined text-[280px] md:text-[420px] text-olive leading-none">anchor</span>
    </div>

    <div class="relative z-10 max-w-[1280px] mx-auto w-full">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <!-- Hero Text Content -->
        <div class="lg:col-span-7">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 bg-secondary-container/80 border border-sand text-ink text-xs font-serif font-bold tracking-widest uppercase mb-6 rounded-xs">
            <span class="w-2 h-2 rounded-full bg-olive animate-pulse"></span>
            <span>EDEBİYAT MİRASI</span>
          </div>

          <h1 class="font-serif text-4xl sm:text-5xl md:text-6xl text-ink font-bold leading-tight mb-6">
            Halikarnas Balıkçısı Cevat Şakir Kabaağaçlı
          </h1>

          <div class="bg-parchment border border-sand p-6 sm:p-8 rounded-xs shadow-xs max-w-2xl mb-8">
            <p class="font-serif text-lg sm:text-xl text-ink/90 leading-relaxed">
              Cevat Şakir Kabaağaçlı’nın eserleri, Bodrum’la kurduğu bağ ve kültürel mirası.
            </p>
          </div>

          <div>
            <a
              href="#katalog"
              class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-olive text-white hover:bg-bodrum-blue-dark font-serif font-bold text-sm tracking-wider uppercase transition-all duration-200 shadow-md group"
            >
              <span>Kitap Kataloğunu İncele</span>
              <span class="material-symbols-outlined text-lg transition-transform group-hover:translate-y-1">arrow_downward</span>
            </a>
          </div>
        </div>

        <!-- Hero Portrait Presentation -->
        <div class="lg:col-span-5">
          <div class="relative bg-parchment border border-sand p-3 shadow-md">
            <div class="aspect-[4/5] w-full overflow-hidden bg-surface-container-high relative border border-sand/60">
              <img
                src="https://lh3.googleusercontent.com/aida-public/AB6AXuBtamE2wb97G4UEjVppyIa8xyaz9ESuP7aGYOlM4umN3pryekAUYBwn8XZKo45ZH7aqW73vU6dZsZMnwJgHghenoLISwtjdMxzizGhJdT-zogTKwukWr8_mcLz_GzaVctJXJRHJp7NTLN-FpTqgLCSpt_ul3-9IG-wgO12fv2VihhT8grjHZSbIrejBTST3Qk4OkAZzS9DaaMmyQAUTQACoPiS-Px-FESLfSfYs8RcKnv1j1wlDAq9KyjedqU32oOYQb0Hdoct4hQA"
                alt="Cevat Şakir Kabaağaçlı - Halikarnas Balıkçısı"
                class="w-full h-full object-cover"
                loading="eager"
              />
            </div>
            <div class="p-3 text-center">
              <div class="font-serif font-bold text-lg text-ink">Cevat Şakir Kabaağaçlı</div>
              <div class="text-xs text-stone-gray font-serif italic">1886 – 1973 • Halikarnas Balıkçısı</div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- 2. Mavi Hümanizmanın ve Anadolu Uygarlığının İzinde -->
  <section class="py-16 md:py-24 px-5 md:px-12 bg-parchment border-b border-sand">
    <div class="max-w-[1280px] mx-auto">
      
      <div class="max-w-3xl mb-12">
        <h2 class="font-serif text-3xl sm:text-4xl text-ink font-bold leading-tight mb-4">
          Mavi Hümanizmanın ve Anadolu Uygarlığının İzinde
        </h2>
        <p class="font-serif text-lg sm:text-xl text-ink/85 leading-relaxed">
          Halikarnas Balıkçısı Cevat Şakir Kabaağaçlı’nın Girit’ten Atina’ya, İstanbul’dan Bodrum’a ve İzmir’e uzanan, Akdeniz Mirasına ve Anadolu Uygarlığına kazandırdığı ölümsüz miras
        </p>
      </div>

      <!-- Prepared Sections Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="bg-surface-container-low p-8 border-2 border-olive rounded-xs shadow-xs">
          <h3 class="font-serif text-2xl text-ink font-bold mb-3">Biyografik Arşiv</h3>
          <p class="font-serif italic text-base text-stone-gray">Bu bölüm hazırlanmaktadır.</p>
        </div>

        <div class="bg-surface-container-low p-8 border-2 border-olive rounded-xs shadow-xs">
          <h3 class="font-serif text-2xl text-ink font-bold mb-3">Önemli Kilometre Taşları</h3>
          <p class="font-serif italic text-base text-stone-gray">Bu bölüm hazırlanmaktadır.</p>
        </div>

        <div class="bg-surface-container-low p-8 border-2 border-olive rounded-xs shadow-xs">
          <h3 class="font-serif text-2xl text-ink font-bold mb-3">Mavi Hümanizma</h3>
          <p class="font-serif italic text-base text-stone-gray">İçerik hazırlanmaktadır.</p>
        </div>

        <div class="bg-surface-container-low p-8 border-2 border-olive rounded-xs shadow-xs">
          <h3 class="font-serif text-2xl text-ink font-bold mb-3">Bodrum’u Yeşerten Kalem</h3>
          <p class="font-serif italic text-base text-stone-gray">İçerik hazırlanmaktadır.</p>
        </div>
      </div>

    </div>
  </section>

  <!-- 3. Eserler Kataloğu Section: 25 Kitap Tam Liste (Renkli Kapaklar) -->
  <section id="katalog" class="py-16 md:py-24 px-5 md:px-12 bg-surface-bright border-b border-sand">
    <div class="max-w-[1280px] mx-auto">
      
      <div class="max-w-3xl mb-12">
        <h2 class="font-serif text-3xl sm:text-4xl text-ink font-bold leading-tight mb-4">
          Halikarnas Balıkçısı Cevat Şakir Kabaağaçlı Eserler Kataloğu
        </h2>
        <p class="font-serif text-lg text-ink/80">
          Bodrum Kent Kütüphanesi bünyesinde bulunan 25 eserin eksiksiz koleksiyon dizini.
        </p>
      </div>

      <!-- 25 Book Cards Grid (Full Color) -->
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-6 mb-16">
        {books.map((book) => (
          <div class="bg-parchment border-2 border-olive rounded-xs p-4 flex flex-col justify-between hover:shadow-md transition-all shadow-xs">
            <div>
              <!-- Direct Full Color Cover -->
              <div class="aspect-[2/3] overflow-hidden bg-surface-container-high mb-4 border border-sand shadow-2xs">
                <img
                  src={book.data.coverImage}
                  alt={book.data.title}
                  class="w-full h-full object-cover"
                />
              </div>

              <div class="text-xs text-stone-gray font-mono font-bold mb-1">{book.data.originalYear}</div>
              <h3 class="font-serif font-bold text-base text-ink leading-snug mb-2">{book.data.title}</h3>
              <p class="font-serif text-xs text-ink/80 leading-relaxed line-clamp-3">{book.data.summaryTr}</p>
            </div>
          </div>
        ))}
      </div>

      <!-- Complete 25-Book Directory Table -->
      <div class="bg-parchment border-2 border-olive rounded-xs overflow-x-auto shadow-xs">
        <table class="w-full text-left text-sm sm:text-base font-serif">
          <thead>
            <tr class="bg-olive text-white font-bold">
              <th class="p-4 w-14">#</th>
              <th class="p-4">Eser Adı</th>
              <th class="p-4">İlk Basım Yılı</th>
              <th class="p-4">Kısa Açıklama</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-sand text-ink/90">
            {books.map((book, idx) => (
              <tr class="hover:bg-surface-container-low transition-colors">
                <td class="p-4 font-mono font-bold text-olive">{idx + 1}</td>
                <td class="p-4 font-bold text-ink text-base">{book.data.title}</td>
                <td class="p-4 font-mono font-semibold">{book.data.originalYear}</td>
                <td class="p-4 text-ink/80 text-sm">{book.data.summaryTr}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

    </div>
  </section>
</Layout>
