---
import Layout from '../../layouts/Layout.astro';
import { getT } from '../../utils/i18n';

const lang = 'en';
const t = getT(lang);

const balıkçıQuotesEn = [
  {
    quote: "When you reach the top of the hill, you will see Bodrum. Don't think you will leave as you came. Those before you were the same; they all left their minds behind in Bodrum...",
    source: "The Blue Exile"
  },
  {
    quote: "The sea awakens the infinity within man. Once you give your heart to the Mediterranean, you can no longer fit into the narrow confines of the land.",
    source: "Hello Mediterranean"
  },
  {
    quote: "Our humanism was not crafted at a desk, but forged in the salty waters of the Aegean and the millennial soil of Anatolia.",
    source: "The Sixth Continent Mediterranean"
  }
];

const initialGuestbookNotesEn = [
  {
    name: "Defne S.",
    location: "Bodrum / Gumusluk",
    date: "August 2026",
    note: "Seeing Bodrum's spirit and the Fisherman's legacy come alive in such a library is invaluable. We eagerly await the Olive Seeds Library!"
  },
  {
    name: "Prof. Dr. Murat A.",
    location: "Izmir",
    date: "July 2026",
    note: "An independent cultural oasis for Aegean and Mediterranean studies. The rare collection in the archive is truly precious."
  },
  {
    name: "Selin & Caner",
    location: "Istanbul",
    date: "August 2026",
    note: "Counting down the days to participate in the book club discussions. Thank you for this wonderful cultural space."
  }
];
---

<Layout
  title={t.siteTitle}
  description={t.siteTagline}
  lang={lang}
  currentPath="/en"
>
  <!-- 1. Hero & Main Showcase -->
  <section class="relative min-h-[60vh] flex items-center justify-center py-12 md:py-16 px-5 md:px-12 overflow-hidden border-b border-sand bg-surface-bright">
    
    <div class="absolute inset-0 z-0 opacity-10 pointer-events-none">
      <div
        class="w-full h-full bg-cover bg-center filter grayscale contrast-125"
        style="background-image: url('/images/logo.png');"
      ></div>
      <div class="absolute inset-0 bg-gradient-to-b from-parchment/70 via-parchment/90 to-parchment"></div>
    </div>

    <!-- Ex Libris Watermark -->
    <div class="absolute -top-10 -right-10 md:top-8 md:right-10 ex-libris-watermark select-none pointer-events-none">
      <span class="material-symbols-outlined text-[180px] md:text-[300px] text-olive leading-none">auto_stories</span>
    </div>

    <!-- Hero Content Container -->
    <div class="relative z-10 max-w-[1280px] mx-auto w-full">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        
        <!-- Left: Headline & Manifesto -->
        <div class="lg:col-span-7 space-y-6">
          <h1 class="font-serif text-3xl sm:text-4xl lg:text-[38px] text-ink font-bold leading-[1.25] tracking-tight">
            A Living Library Dedicated to Bodrum's Cultural Memory
          </h1>

          <div class="bg-parchment border border-sand p-6 sm:p-8 rounded-xs shadow-xs space-y-4">
            <p class="font-sans text-base sm:text-[17px] text-ink/90 leading-relaxed text-justify">
              Bodrum City Library is a multi-purpose, living library project designed to bring together residents and visitors with esteemed figures and works of literature, art, and science.
            </p>
            <p class="font-sans text-base sm:text-[17px] text-ink/90 leading-relaxed text-justify">
              Through book-centered events, talks, workshops, and cultural gatherings, it supports lifelong learning, creation, and sharing; preserving the Mediterranean and Blue Humanism of the Fisherman of Halicarnassus and highlighting the timeless value of Anatolian Civilization as an independent meeting space.
            </p>
          </div>
        </div>

        <!-- Right: Official Logo Showcase -->
        <div class="lg:col-span-5">
          <div class="relative group">
            <div class="relative bg-parchment border-2 border-olive p-4 shadow-md rounded-xs">
              <div class="aspect-square overflow-hidden bg-olive flex items-center justify-center p-4 rounded-xs border border-sand/60 shadow-inner">
                <img
                  src="/images/logo.png"
                  alt="Bodrum City Library Emblem"
                  class="w-full h-full object-contain drop-shadow-md"
                  loading="eager"
                />
              </div>
              <div class="pt-3 pb-1 px-1 flex items-center justify-between text-xs sm:text-sm text-stone-gray font-sans">
                <span class="font-bold text-ink font-serif">Bodrum City Library</span>
                <span class="font-mono text-xs">Kizilagac • 2019</span>
              </div>
            </div>
          </div>
        </div>

      </div>

      <!-- 3 Institutional Boxes with Logos -->
      <div class="mt-12 pt-8 border-t border-sand grid grid-cols-1 md:grid-cols-3 gap-6 text-ink">
        
        <div class="bg-parchment p-6 border-2 border-olive rounded-xs shadow-xs flex flex-col items-center justify-between text-center">
          <div class="w-full flex flex-col items-center">
            <h3 class="font-serif text-xl font-bold text-olive mb-3 text-center">
              Olive Seeds Library
            </h3>

            <div class="w-24 h-24 my-2 flex items-center justify-center overflow-hidden">
              <img
                src="/images/ztk_logo.png"
                alt="Olive Seeds Library Logo"
                class="max-w-full max-h-full object-contain"
              />
            </div>

            <p class="font-sans text-sm sm:text-base text-ink/85 leading-relaxed my-3 text-center">
              Library initiative for children, youth, parents, and educators
            </p>
          </div>
          <div class="pt-2 border-t border-olive/20 text-xs font-sans italic text-stone-gray w-full text-center">
            Web page under preparation
          </div>
        </div>

        <div class="bg-parchment p-6 border-2 border-olive rounded-xs shadow-xs flex flex-col items-center justify-between text-center">
          <div class="w-full flex flex-col items-center">
            <h3 class="font-serif text-xl font-bold text-olive mb-3 text-center">
              Children of Halicarnassus
            </h3>

            <div class="w-24 h-24 my-2 flex items-center justify-center overflow-hidden rounded-xs border border-sand">
              <img
                src="/images/hc_logo.jpg"
                alt="Children of Halicarnassus Arts Program"
                class="w-full h-full object-cover"
              />
            </div>

            <p class="font-sans text-sm sm:text-base text-ink/85 leading-relaxed my-3 text-center">
              Arts and cultural workshops for all ages
            </p>
          </div>
          <div class="pt-2 border-t border-olive/20 text-xs font-sans italic text-stone-gray w-full text-center">
            Web page under preparation
          </div>
        </div>

        <div class="bg-parchment p-6 border-2 border-olive rounded-xs shadow-xs flex flex-col items-center justify-between text-center">
          <div class="w-full flex flex-col items-center">
            <h3 class="font-serif text-xl font-bold text-olive mb-3 text-center leading-snug">
              Halicarnassus Culture, Arts, Education<br />& Ecology Association
            </h3>

            <div class="w-24 h-24 my-2 flex items-center justify-center bg-olive/10 text-olive rounded-full border border-olive/30">
              <span class="material-symbols-outlined text-4xl">account_balance</span>
            </div>

            <p class="font-sans text-sm sm:text-base text-ink/85 leading-relaxed my-3 text-center">
              Official institutional umbrella for all our initiatives
            </p>
          </div>
          <div class="pt-2 border-t border-olive/20 text-xs font-sans italic text-stone-gray w-full text-center">
            Web page under preparation
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- 2. Daily Fisherman Quote -->
  <section class="py-12 md:py-16 px-5 md:px-12 bg-surface-container-low border-b border-sand">
    <div class="max-w-[1280px] mx-auto">
      <div class="bg-parchment border-2 border-olive rounded-xs p-8 sm:p-12 shadow-md relative overflow-hidden">
        
        <div class="absolute -right-8 -bottom-8 opacity-5 pointer-events-none select-none">
          <span class="material-symbols-outlined text-[200px] text-olive leading-none">format_quote</span>
        </div>

        <div class="relative z-10 max-w-4xl mx-auto text-center space-y-6">
          <div class="inline-flex items-center gap-2 px-3 py-1 bg-olive/10 text-olive text-xs font-sans font-bold uppercase tracking-widest rounded-xs">
            <span class="material-symbols-outlined text-sm">auto_stories</span>
            <span>A GREETING FROM THE FISHERMAN OF HALICARNASSUS</span>
          </div>

          <blockquote id="quote-display-en" class="font-serif italic text-xl sm:text-2xl md:text-3xl text-ink leading-relaxed">
            "{balıkçıQuotesEn[0].quote}"
          </blockquote>

          <div class="flex items-center justify-center gap-3 text-sm font-sans">
            <span class="font-bold text-olive font-serif text-base">Cevat Şakir Kabaağaçlı</span>
            <span class="text-stone-gray">•</span>
            <cite id="quote-source-en" class="not-italic text-stone-gray font-medium">{balıkçıQuotesEn[0].source}</cite>
          </div>

          <div class="pt-2 flex items-center justify-center gap-2">
            <button
              type="button"
              id="next-quote-btn-en"
              class="px-4 py-1.5 bg-olive text-white hover:bg-bodrum-blue-dark text-xs font-sans font-bold uppercase tracking-wider rounded-xs transition-colors shadow-2xs flex items-center gap-1.5 cursor-pointer"
            >
              <span class="material-symbols-outlined text-sm">refresh</span>
              <span>Display Another Quote</span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Digital Guestbook -->
  <section class="py-12 md:py-16 px-5 md:px-12 bg-surface-bright border-b border-sand">
    <div class="max-w-[1280px] mx-auto">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
        
        <div class="lg:col-span-5 space-y-5">
          <div class="inline-flex items-center gap-2 px-3 py-1 bg-olive text-white text-xs font-sans font-bold uppercase tracking-widest rounded-xs shadow-2xs">
            <span>DIGITAL GUESTBOOK</span>
          </div>

          <h2 class="font-serif text-2xl sm:text-3xl text-ink font-bold leading-tight">
            Leave a Note for Bodrum and the Library
          </h2>

          <p class="font-sans text-sm sm:text-base text-ink/80 leading-relaxed text-justify">
            Bodrum City Library flourishes through the thoughts and reflections of its readers. You are warmly invited to share your memories and thoughts.
          </p>

          <form id="guestbook-form-en" class="bg-parchment border-2 border-olive p-5 rounded-xs shadow-xs space-y-3 font-sans">
            <div>
              <label class="block text-xs font-bold text-ink uppercase tracking-wider mb-1">Your Name / Alias *</label>
              <input
                type="text"
                id="guest-name-en"
                required
                placeholder="e.g. Aegean Wanderer"
                class="w-full px-3 py-2 bg-surface-bright border border-sand text-ink text-sm rounded-xs focus:outline-none focus:border-olive"
              />
            </div>

            <div>
              <label class="block text-xs font-bold text-ink uppercase tracking-wider mb-1">City / Region</label>
              <input
                type="text"
                id="guest-location-en"
                placeholder="e.g. Bodrum / Yalikavak"
                class="w-full px-3 py-2 bg-surface-bright border border-sand text-ink text-sm rounded-xs focus:outline-none focus:border-olive"
              />
            </div>

            <div>
              <label class="block text-xs font-bold text-ink uppercase tracking-wider mb-1">Your Note *</label>
              <textarea
                id="guest-note-en"
                rows="3"
                required
                placeholder="Your thought about Bodrum and the library..."
                class="w-full px-3 py-2 bg-surface-bright border border-sand text-ink text-sm rounded-xs focus:outline-none focus:border-olive"
              ></textarea>
            </div>

            <button
              type="submit"
              class="w-full py-2.5 bg-olive hover:bg-bodrum-blue-dark text-white text-xs font-bold uppercase tracking-wider rounded-xs transition-colors shadow-xs flex items-center justify-center gap-1.5 cursor-pointer"
            >
              <span class="material-symbols-outlined text-sm">edit_note</span>
              <span>Add to Guestbook</span>
            </button>
          </form>
        </div>

        <div class="lg:col-span-7 space-y-4">
          <div class="flex items-center justify-between pb-2 border-b border-sand">
            <h3 class="font-serif text-xl font-bold text-ink">
              Notes from Book Lovers & Friends
            </h3>
            <span class="text-xs font-mono text-stone-gray font-bold">Latest Entries</span>
          </div>

          <div id="guestbook-list-en" class="space-y-3.5">
            {initialGuestbookNotesEn.map((item) => (
              <div class="bg-parchment border border-sand p-4 sm:p-5 rounded-xs shadow-2xs space-y-2 transition-all hover:border-olive">
                <p class="font-serif italic text-base sm:text-lg text-ink/90 leading-relaxed">
                  "{item.note}"
                </p>
                <div class="flex items-center justify-between text-xs font-sans text-stone-gray pt-2 border-t border-sand/50">
                  <span class="font-bold text-olive">{item.name} <span class="font-normal text-stone-gray/80">• {item.location}</span></span>
                  <span class="font-mono text-[11px]">{item.date}</span>
                </div>
              </div>
            ))}
          </div>
        </div>

      </div>

    </div>
  </section>
</Layout>

<script is:inline define:vars={{ balıkçıQuotesEn }}>
  let quoteIndexEn = 0;
  const quoteDisplayEn = document.getElementById('quote-display-en');
  const quoteSourceEn = document.getElementById('quote-source-en');
  const nextQuoteBtnEn = document.getElementById('next-quote-btn-en');

  if (nextQuoteBtnEn && quoteDisplayEn && quoteSourceEn) {
    nextQuoteBtnEn.addEventListener('click', () => {
      quoteIndexEn = (quoteIndexEn + 1) % balıkçıQuotesEn.length;
      quoteDisplayEn.textContent = `"${balıkçıQuotesEn[quoteIndexEn].quote}"`;
      quoteSourceEn.textContent = balıkçıQuotesEn[quoteIndexEn].source;
    });
  }

  const guestbookFormEn = document.getElementById('guestbook-form-en');
  const guestbookListEn = document.getElementById('guestbook-list-en');

  if (guestbookFormEn && guestbookListEn) {
    guestbookFormEn.addEventListener('submit', (e) => {
      e.preventDefault();
      const nameInput = document.getElementById('guest-name-en');
      const locationInput = document.getElementById('guest-location-en');
      const noteInput = document.getElementById('guest-note-en');

      const name = nameInput.value.trim();
      const location = locationInput.value.trim() || 'Bodrum';
      const note = noteInput.value.trim();

      if (!name || !note) return;

      const newCard = document.createElement('div');
      newCard.className = 'bg-parchment border-2 border-olive p-4 sm:p-5 rounded-xs shadow-xs space-y-2 transition-all';
      newCard.innerHTML = `
        <p class="font-serif italic text-base sm:text-lg text-ink leading-relaxed">
          "${note}"
        </p>
        <div class="flex items-center justify-between text-xs font-sans text-stone-gray pt-2 border-t border-sand/50">
          <span class="font-bold text-olive">${name} <span class="font-normal text-stone-gray/80">• ${location}</span></span>
          <span class="font-mono text-[11px] font-bold text-emerald-700 bg-emerald-50 px-1.5 py-0.5 rounded-2xs">Just now</span>
        </div>
      `;

      guestbookListEn.prepend(newCard);
      guestbookFormEn.reset();

      if (window.showToast) {
        window.showToast('Your note has been recorded in the Digital Guestbook! Thank you.', 'success', 5000);
      }
    });
  }
</script>
