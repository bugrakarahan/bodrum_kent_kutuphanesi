---
import Layout from '../../layouts/Layout.astro';
import { getT } from '../../utils/i18n';

const lang = 'en';
const t = getT(lang);

const balıkçıQuotesEn = [
  {
    quote: "When you reach the top of the hill, you will see Bodrum. Don't think you will leave as you came. Those before you were the same; they all left their minds behind in Bodrum...",
    source: "The Blue Exile"
  },
  {
    quote: "The sea awakens the infinity within man. Once you give your heart to the Mediterranean, you can no longer fit into the narrow confines of the land.",
    source: "Hello Mediterranean"
  },
  {
    quote: "Our humanism was not crafted at a desk, but forged in the salty waters of the Aegean and the millennial soil of Anatolia.",
    source: "The Sixth Continent Mediterranean"
  }
];

const initialGuestbookNotesEn = [
  {
    name: "Defne S.",
    location: "Bodrum / Gumusluk",
    date: "August 2026",
    note: "Seeing Bodrum's spirit and the Fisherman's legacy come alive in such a library is invaluable. We eagerly await the Olive Seeds Library!"
  },
  {
    name: "Prof. Dr. Murat A.",
    location: "Izmir",
    date: "July 2026",
    note: "An independent cultural oasis for Aegean and Mediterranean studies. The rare collection in the archive is truly precious."
  },
  {
    name: "Selin & Caner",
    location: "Istanbul",
    date: "August 2026",
    note: "Counting down the days to participate in the book club discussions. Thank you for this wonderful cultural space."
  }
];
---

<Layout
  title={t.siteTitle}
  description={t.siteTagline}
  lang={lang}
  currentPath="/en"
>
  <!-- 1. Hero & Main Showcase -->
  <section class="relative flex items-center justify-center py-6 md:py-10 px-5 md:px-12 overflow-hidden border-b border-sand bg-surface-bright">
    
    <div class="absolute inset-0 z-0 opacity-10 pointer-events-none">
      <div
        class="w-full h-full bg-cover bg-center filter grayscale contrast-125"
        style="background-image: url('/images/logo.png');"
      ></div>
      <div class="absolute inset-0 bg-gradient-to-b from-parchment/70 via-parchment/90 to-parchment"></div>
    </div>

    <!-- Ex Libris Watermark -->
    <div class="absolute -top-10 -right-10 md:top-6 md:right-8 ex-libris-watermark select-none pointer-events-none">
      <span class="material-symbols-outlined text-[140px] md:text-[220px] text-olive leading-none">auto_stories</span>
    </div>

    <!-- Hero Content Container -->
    <div class="relative z-10 max-w-[1280px] mx-auto w-full">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-10 items-center">
        
        <!-- Left: Headline & Manifesto -->
        <div class="lg:col-span-7 space-y-3.5">
          <h1 class="font-serif text-xl sm:text-2xl text-ink font-bold leading-snug tracking-tight">
            A Living Library Dedicated to<br class="hidden sm:inline" />
            Bodrum's Cultural Memory
          </h1>

          <div class="bg-parchment border border-sand p-4 sm:p-5 rounded-xs shadow-xs space-y-2.5">
            <p class="font-sans text-xs sm:text-sm text-ink/90 leading-relaxed text-justify">
              Bodrum City Library is a multi-purpose, living library project designed to bring together residents and visitors with esteemed figures and works of literature, art, and science.
            </p>
            <p class="font-sans text-xs sm:text-sm text-ink/90 leading-relaxed text-justify">
              Through book-centered events, talks, workshops, and cultural gatherings, it supports lifelong learning, creation, and sharing; preserving the Mediterranean and Blue Humanism of the Fisherman of Halicarnassus and highlighting the timeless value of Anatolian Civilization as an independent meeting space.
            </p>
          </div>
        </div>

        <!-- Right: Clean Oval-Cornered Logo -->
        <div class="lg:col-span-5 flex items-center justify-center">
          <div class="w-full max-w-[210px] sm:max-w-[240px] aspect-square rounded-xl sm:rounded-2xl overflow-hidden shadow-sm">
            <img
              src="/images/logo.png"
              alt="Bodrum City Library Logo"
              class="w-full h-full object-contain rounded-xl sm:rounded-2xl"
              loading="eager"
            />
          </div>
        </div>

      </div>

      <!-- 3 Institutional Boxes: Vertical 3:4 Aspect Ratio Frames -->
      <div class="mt-8 pt-6 border-t border-sand">
        <div class="max-w-4xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-5 text-ink">
          
          <!-- 1. Olive Seeds Library (Vertical 3:4) -->
          <div class="bg-parchment p-4 border-2 border-olive rounded-xs shadow-xs flex flex-col justify-between items-center text-center max-w-[280px] w-full mx-auto">
            <div class="h-10 flex items-center justify-center w-full">
              <h3 class="font-serif text-sm sm:text-base font-bold text-olive text-center leading-snug">
                Olive Seeds Library
              </h3>
            </div>

            <!-- Vertical 3:4 Frame -->
            <div class="aspect-[3/4] w-36 sm:w-40 my-2 flex items-center justify-center overflow-hidden rounded-xs border border-sand bg-white/60 p-1">
              <img
                src="/images/ztk_logo.png"
                alt="Olive Seeds Library Logo"
                class="w-full h-full object-contain"
              />
            </div>

            <div class="h-11 flex items-center justify-center w-full">
              <p class="font-sans text-[11px] sm:text-xs text-ink/85 leading-snug text-center">
                Library initiative for children, youth,<br />parents, and educators
              </p>
            </div>

            <div class="pt-2 border-t border-olive/20 text-[10px] sm:text-[11px] font-sans italic text-stone-gray w-full text-center">
              Web page under preparation
            </div>
          </div>

          <!-- 2. Children of Halicarnassus (Vertical 3:4) -->
          <div class="bg-parchment p-4 border-2 border-olive rounded-xs shadow-xs flex flex-col justify-between items-center text-center max-w-[280px] w-full mx-auto">
            <div class="h-10 flex items-center justify-center w-full">
              <h3 class="font-serif text-sm sm:text-base font-bold text-olive text-center leading-snug">
                Children of Halicarnassus
              </h3>
            </div>

            <!-- Vertical 3:4 Frame -->
            <div class="aspect-[3/4] w-36 sm:w-40 my-2 flex items-center justify-center overflow-hidden rounded-xs border border-sand bg-white/60 p-1">
              <img
                src="/images/hc_logo.jpg"
                alt="Children of Halicarnassus Arts Program"
                class="w-full h-full object-contain"
              />
            </div>

            <div class="h-11 flex items-center justify-center w-full">
              <p class="font-sans text-[11px] sm:text-xs text-ink/85 leading-snug text-center">
                Arts and cultural workshops<br />for all ages
              </p>
            </div>

            <div class="pt-2 border-t border-olive/20 text-[10px] sm:text-[11px] font-sans italic text-stone-gray w-full text-center">
              Web page under preparation
            </div>
          </div>

          <!-- 3. Halicarnassus Association (Vertical 3:4) -->
          <div class="bg-parchment p-4 border-2 border-olive rounded-xs shadow-xs flex flex-col justify-between items-center text-center max-w-[280px] w-full mx-auto">
            <div class="h-10 flex items-center justify-center w-full">
              <h3 class="font-serif text-sm sm:text-base font-bold text-olive text-center leading-snug">
                Halicarnassus Culture, Arts, Education<br />& Ecology Association
              </h3>
            </div>

            <!-- Vertical 3:4 Shield Frame -->
            <div class="aspect-[3/4] w-36 sm:w-40 my-2 flex flex-col items-center justify-center overflow-hidden rounded-xs border border-sand bg-olive/5 text-olive p-2">
              <div class="w-16 h-16 rounded-full bg-olive/10 border-2 border-olive flex items-center justify-center mb-1">
                <span class="material-symbols-outlined text-3xl text-olive">account_balance</span>
              </div>
              <span class="font-serif font-bold text-[10px] uppercase tracking-wider text-center text-olive">Official Umbrella</span>
            </div>

            <div class="h-11 flex items-center justify-center w-full">
              <p class="font-sans text-[11px] sm:text-xs text-ink/85 leading-snug text-center">
                Official institutional umbrella<br />for all our initiatives
              </p>
            </div>

            <div class="pt-2 border-t border-olive/20 text-[10px] sm:text-[11px] font-sans italic text-stone-gray w-full text-center">
              Web page under preparation
            </div>
          </div>

        </div>
      </div>

    </div>
  </section>

  <!-- 2. Daily Fisherman Quote -->
  <section class="py-8 md:py-10 px-5 md:px-12 bg-surface-container-low border-b border-sand">
    <div class="max-w-[1280px] mx-auto">
      <div class="bg-parchment border-2 border-olive rounded-xs p-5 sm:p-8 shadow-md relative overflow-hidden">
        
        <div class="absolute -right-6 -bottom-6 opacity-5 pointer-events-none select-none">
          <span class="material-symbols-outlined text-[150px] text-olive leading-none">format_quote</span>
        </div>

        <div class="relative z-10 max-w-3xl mx-auto text-center space-y-3">
          <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 bg-olive/10 text-olive text-[11px] font-sans font-bold uppercase tracking-widest rounded-xs">
            <span class="material-symbols-outlined text-xs">auto_stories</span>
            <span>A GREETING FROM THE FISHERMAN OF HALICARNASSUS</span>
          </div>

          <blockquote id="quote-display-en" class="font-serif italic text-base sm:text-lg text-ink leading-relaxed">
            "{balıkçıQuotesEn[0].quote}"
          </blockquote>

          <div class="flex items-center justify-center gap-2 text-xs font-sans">
            <span class="font-bold text-olive font-serif text-sm">Cevat Şakir Kabaağaçlı</span>
            <span class="text-stone-gray">•</span>
            <cite id="quote-source-en" class="not-italic text-stone-gray font-medium">{balıkçıQuotesEn[0].source}</cite>
          </div>

          <div class="pt-1 flex items-center justify-center gap-2">
            <button
              type="button"
              id="next-quote-btn-en"
              class="px-3.5 py-1.5 bg-olive text-white hover:bg-bodrum-blue-dark text-[11px] font-sans font-bold uppercase tracking-wider rounded-xs transition-colors shadow-2xs flex items-center gap-1 cursor-pointer"
            >
              <span class="material-symbols-outlined text-xs">refresh</span>
              <span>Display Another Quote</span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Digital Guestbook -->
  <section class="py-8 md:py-10 px-5 md:px-12 bg-surface-bright border-b border-sand">
    <div class="max-w-[1280px] mx-auto">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-start">
        
        <div class="lg:col-span-5 space-y-3.5">
          <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 bg-olive text-white text-[11px] font-sans font-bold uppercase tracking-widest rounded-xs shadow-2xs">
            <span>DIGITAL GUESTBOOK</span>
          </div>

          <h2 class="font-serif text-base sm:text-lg text-ink font-bold leading-snug">
            Leave a Note for Bodrum<br />
            and Our Library
          </h2>

          <p class="font-sans text-xs text-ink/80 leading-relaxed">
            Bodrum City Library flourishes through the interest and support of book lovers and friends.<br />
            Please share your thoughts, suggestions, and wishes for our library and Bodrum here.
          </p>

          <form id="guestbook-form-en" class="bg-parchment border-2 border-olive p-3.5 sm:p-4 rounded-xs shadow-xs space-y-2.5 font-sans">
            <div>
              <label class="block text-[11px] font-bold text-ink uppercase tracking-wider mb-0.5">Your Name / Alias *</label>
              <input
                type="text"
                id="guest-name-en"
                required
                placeholder="e.g. Aegean Wanderer"
                class="w-full px-3 py-1.5 bg-surface-bright border border-sand text-ink text-xs rounded-xs focus:outline-none focus:border-olive"
              />
            </div>

            <div>
              <label class="block text-[11px] font-bold text-ink uppercase tracking-wider mb-0.5">City / Region</label>
              <input
                type="text"
                id="guest-location-en"
                placeholder="e.g. Bodrum / Yalikavak"
                class="w-full px-3 py-1.5 bg-surface-bright border border-sand text-ink text-xs rounded-xs focus:outline-none focus:border-olive"
              />
            </div>

            <div>
              <label class="block text-[11px] font-bold text-ink uppercase tracking-wider mb-0.5">Your Note *</label>
              <textarea
                id="guest-note-en"
                rows="3"
                required
                placeholder="Your thoughts, suggestions and notes for Bodrum and our library..."
                class="w-full px-3 py-1.5 bg-surface-bright border border-sand text-ink text-xs rounded-xs focus:outline-none focus:border-olive"
              ></textarea>
            </div>

            <button
              type="submit"
              class="w-full py-2 bg-olive hover:bg-bodrum-blue-dark text-white text-xs font-bold uppercase tracking-wider rounded-xs transition-colors shadow-xs flex items-center justify-center gap-1 cursor-pointer"
            >
              <span class="material-symbols-outlined text-sm">edit_note</span>
              <span>Add to Guestbook</span>
            </button>
          </form>
        </div>

        <div class="lg:col-span-7 space-y-3">
          <div class="flex items-center justify-between pb-2 border-b border-sand">
            <h2 class="font-serif text-base sm:text-lg font-bold text-ink leading-snug">
              Notes from Book Lovers & Friends
            </h2>
            <span class="text-[11px] font-mono text-stone-gray font-bold">Latest Entries</span>
          </div>

          <div id="guestbook-list-en" class="space-y-2.5">
            {initialGuestbookNotesEn.map((item) => (
              <div class="bg-parchment border border-sand p-3 sm:p-3.5 rounded-xs shadow-2xs space-y-1 transition-all hover:border-olive">
                <p class="font-serif italic text-xs sm:text-sm text-ink/90 leading-relaxed">
                  "{item.note}"
                </p>
                <div class="flex items-center justify-between text-[11px] font-sans text-stone-gray pt-1 border-t border-sand/50">
                  <span class="font-bold text-olive">${item.name} <span class="font-normal text-stone-gray/80">• ${item.location}</span></span>
                  <span class="font-mono text-[10px]">${item.date}</span>
                </div>
              </div>
            ))}
          </div>
        </div>

      </div>

    </div>
  </section>
</Layout>

<script is:inline define:vars={{ balıkçıQuotesEn }}>
  let quoteIndexEn = 0;
  const quoteDisplayEn = document.getElementById('quote-display-en');
  const quoteSourceEn = document.getElementById('quote-source-en');
  const nextQuoteBtnEn = document.getElementById('next-quote-btn-en');

  if (nextQuoteBtnEn && quoteDisplayEn && quoteSourceEn) {
    nextQuoteBtnEn.addEventListener('click', () => {
      quoteIndexEn = (quoteIndexEn + 1) % balıkçıQuotesEn.length;
      quoteDisplayEn.textContent = `"${balıkçıQuotesEn[quoteIndexEn].quote}"`;
      quoteSourceEn.textContent = balıkçıQuotesEn[quoteIndexEn].source;
    });
  }

  const guestbookFormEn = document.getElementById('guestbook-form-en');
  const guestbookListEn = document.getElementById('guestbook-list-en');

  if (guestbookFormEn && guestbookListEn) {
    guestbookFormEn.addEventListener('submit', (e) => {
      e.preventDefault();
      const nameInput = document.getElementById('guest-name-en');
      const locationInput = document.getElementById('guest-location-en');
      const noteInput = document.getElementById('guest-note-en');

      const name = nameInput.value.trim();
      const location = locationInput.value.trim() || 'Bodrum';
      const note = noteInput.value.trim();

      if (!name || !note) return;

      const newCard = document.createElement('div');
      newCard.className = 'bg-parchment border-2 border-olive p-3 rounded-xs shadow-xs space-y-1 transition-all';
      newCard.innerHTML = `
        <p class="font-serif italic text-xs sm:text-sm text-ink leading-relaxed">
          "${note}"
        </p>
        <div class="flex items-center justify-between text-[11px] font-sans text-stone-gray pt-1 border-t border-sand/50">
          <span class="font-bold text-olive">${name} <span class="font-normal text-stone-gray/80">• ${location}</span></span>
          <span class="font-mono text-[10px] font-bold text-emerald-700 bg-emerald-50 px-1 py-0.5 rounded-2xs">Just now</span>
        </div>
      `;

      guestbookListEn.prepend(newCard);
      guestbookFormEn.reset();

      if (window.showToast) {
        window.showToast('Your note has been recorded in the Digital Guestbook! Thank you.', 'success', 5000);
      }
    });
  }
</script>
