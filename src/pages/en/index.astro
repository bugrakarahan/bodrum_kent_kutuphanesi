---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { getT } from '../../utils/i18n';

const lang = 'en';
const t = getT(lang);

// Fetch events and talks collections
const allEvents = await getCollection('events');
const upcomingEvents = allEvents
  .filter((event) => !event.data.isPast)
  .sort((a, b) => new Date(a.data.date).getTime() - new Date(b.data.date).getTime())
  .slice(0, 3);

const allTalks = await getCollection('talks');
const latestTalks = allTalks
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 2);
---

<Layout
  title={t.siteTitle}
  description={t.siteTagline}
  lang={lang}
  currentPath="/en"
>
  <!-- 1. Hero Section -->
  <section class="relative min-h-[85vh] flex items-center justify-center py-20 md:py-32 px-margin-mobile md:px-margin-desktop overflow-hidden border-b border-sand bg-surface-bright">
    <!-- Subtle Ambient Background Layer -->
    <div class="absolute inset-0 z-0 opacity-20 pointer-events-none">
      <div
        class="w-full h-full bg-cover bg-center filter grayscale contrast-125"
        style="background-image: url('https://lh3.googleusercontent.com/aida/AP1WRLvo60AOVtg-X2yx5_UsWAYHm8SVZyT_7GmTxiGOeYNbsSg0TADSsk0S_nyvd794vLfkUY3I7nwaPhBWhJdlPkO45ZzOwy2dFyAdRBD_sw9MQ0ohoBLQsfabJSdYSm4TbUmg_2DEzDzqMqJbLKVQjdUYWpK6uJXcvx1KUMGHoDWpGghWlQBy8J7PfXLubkb5erCLKPe8Nznl46CMhd-jcSxP8dhqHD4evmD0Zl-vA-Sxo0_PqpRIAuZpIWo');"
      ></div>
      <div class="absolute inset-0 bg-gradient-to-b from-parchment/60 via-parchment/80 to-parchment"></div>
    </div>

    <!-- Ex Libris Watermark Flourish -->
    <div class="absolute -top-10 -right-10 md:top-12 md:right-16 ex-libris-watermark select-none pointer-events-none">
      <span class="material-symbols-outlined text-[240px] md:text-[380px] text-olive leading-none">auto_stories</span>
    </div>

    <!-- Hero Content Container -->
    <div class="relative z-10 max-w-container-max mx-auto w-full">
      <div class="max-w-4xl">
        <!-- Overline Badge & Launch Announcement -->
        <div class="flex flex-wrap items-center gap-3 mb-6">
          <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 bg-secondary-container/60 border border-sand text-ink text-xs font-semibold tracking-widest uppercase rounded">
            <span class="w-2 h-2 rounded-full bg-olive animate-pulse"></span>
            <span>Cultural Heritage Initiative</span>
          </div>

          <a
            href="/en/support"
            class="inline-flex items-center gap-2 px-3.5 py-1.5 bg-olive text-white text-xs font-semibold tracking-wider uppercase rounded hover:bg-ink transition-colors shadow-xs"
          >
            <span class="material-symbols-outlined text-sm">campaign</span>
            <span>September 4-5 Grand Launch & Sponsorship</span>
            <span class="material-symbols-outlined text-xs">arrow_forward</span>
          </a>
        </div>

        <!-- Headline -->
        <h1 class="font-display-lg text-4xl sm:text-5xl md:text-6xl lg:text-7xl text-ink font-serif leading-[1.12] tracking-tight mb-8 text-balance">
          A living library dedicated to Bodrum's cultural and maritime memory.
        </h1>

        <!-- Subtext Card -->
        <div class="bg-parchment/90 backdrop-blur-sm border border-sand/80 p-6 md:p-8 rounded shadow-sm max-w-2xl mb-10">
          <p class="font-sans text-base md:text-lg text-secondary leading-relaxed text-balance">
            Bodrum City Library is an independent cultural initiative preserving the peninsula's ancient history, the literary legacy of the Fisherman of Halicarnassus, and Mediterranean humanism through digital and physical collections.
          </p>
        </div>

        <!-- Primary & Secondary CTA Buttons -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 sm:gap-6">
          <a
            href="/en/events"
            class="inline-flex items-center justify-center gap-3 px-8 py-4 bg-ink text-parchment font-semibold text-xs md:text-sm uppercase tracking-widest hover:bg-olive transition-all duration-200 shadow-md group"
          >
            <span>{t.exploreEvents}</span>
            <span class="material-symbols-outlined text-[18px] transition-transform group-hover:translate-x-1">arrow_forward</span>
          </a>

          <a
            href="/en/support"
            class="inline-flex items-center justify-center px-8 py-4 bg-olive/10 border border-olive text-olive hover:bg-olive hover:text-white font-semibold text-xs md:text-sm uppercase tracking-widest transition-all duration-200 shadow-xs"
          >
            <span>Sponsorship & Support</span>
          </a>

          <a
            href="/en/about"
            class="inline-flex items-center justify-center px-8 py-4 border border-ink text-ink font-semibold text-xs md:text-sm uppercase tracking-widest hover:bg-sand/60 transition-all duration-200"
          >
            <span>{t.exploreProject}</span>
          </a>
        </div>
      </div>

      <!-- Quick Indicator Strip -->
      <div class="mt-16 md:mt-24 pt-8 border-t border-sand/60 grid grid-cols-2 md:grid-cols-4 gap-6 text-ink">
        <div>
          <div class="font-serif text-2xl md:text-3xl font-bold text-olive">11</div>
          <div class="text-xs uppercase tracking-wider text-stone-gray font-medium mt-1">Committee Members</div>
        </div>
        <div>
          <div class="font-serif text-2xl md:text-3xl font-bold text-olive">16.09.2019</div>
          <div class="text-xs uppercase tracking-wider text-stone-gray font-medium mt-1">Initiative Founding</div>
        </div>
        <div>
          <div class="font-serif text-2xl md:text-3xl font-bold text-olive">11 Works</div>
          <div class="text-xs uppercase tracking-wider text-stone-gray font-medium mt-1">Fisherman Collection</div>
        </div>
        <div>
          <div class="font-serif text-2xl md:text-3xl font-bold text-olive">Open Archive</div>
          <div class="text-xs uppercase tracking-wider text-stone-gray font-medium mt-1">Oral History & Media</div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Institutional Info Section (Hakkımızda Özeti) -->
  <section class="py-24 md:py-32 px-margin-mobile md:px-margin-desktop bg-parchment border-b border-sand relative">
    <div class="max-w-container-max mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-gutter items-start">
      
      <!-- Sticky Left Column -->
      <div class="lg:col-span-5 lg:sticky lg:top-28">
        <span class="font-sans text-xs uppercase tracking-[0.2em] text-olive font-semibold block mb-3">ABOUT US</span>
        <h2 class="font-serif text-3xl sm:text-4xl md:text-5xl text-ink leading-tight mb-6">
          What is Bodrum City Library?
        </h2>
        <p class="font-serif italic text-lg md:text-xl text-secondary leading-relaxed mb-6">
          "Following the Blue Exile, a tranquil cultural harbor where maritime heritage meets modern intellectual discovery."
        </p>
        <a
          href="/en/about"
          class="inline-flex items-center gap-2 font-sans text-xs font-bold uppercase tracking-widest text-ink hover:text-olive transition-colors pb-1 border-b border-ink hover:border-olive group"
        >
          <span>Explore Our History & Founding</span>
          <span class="material-symbols-outlined text-[16px] transition-transform group-hover:translate-x-1">arrow_forward</span>
        </a>
      </div>

      <!-- Right Column -->
      <div class="lg:col-span-7 space-y-8">
        <div class="prose prose-lg text-ink/90">
          <p class="font-serif text-xl md:text-2xl text-ink leading-relaxed font-normal">
            We are not merely a traditional repository of books; we are the guardians and creators of Bodrum's collective memory, where cultural heritage is shared and reproduced for future generations.
          </p>
          <div class="h-px w-20 bg-olive/40 my-6"></div>
          <p class="font-sans text-base md:text-lg text-secondary leading-relaxed">
            Our library spans from the maritime humanism of Cevat Şakir Kabaağaçlı (The Fisherman of Halicarnassus) to ancient Halicarnassus relics, local sponge diving oral histories, and contemporary literature workshops. We aim to democratize access to knowledge across the Mediterranean.
          </p>
        </div>

        <!-- 2 Feature Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 pt-4">
          <!-- Card 1: Digital Archive & Research -->
          <div class="p-6 md:p-8 bg-surface-container-low border border-sand rounded hover:border-olive/60 transition-colors group">
            <div class="w-12 h-12 rounded bg-parchment border border-sand flex items-center justify-center text-olive mb-5 group-hover:bg-olive group-hover:text-parchment transition-colors">
              <span class="material-symbols-outlined text-[24px]">history_edu</span>
            </div>
            <h3 class="font-serif text-xl font-semibold text-ink mb-3 group-hover:text-olive transition-colors">
              Digital Archive & Research
            </h3>
            <p class="font-sans text-sm text-secondary leading-relaxed mb-4">
              Rare manuscripts, first edition volumes, and local historical documents are systematically digitized for scholars and public research.
            </p>
            <a href="/en/fisherman-of-halicarnassus" class="inline-flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wider text-ink group-hover:text-olive">
              <span>View Collection</span>
              <span class="material-symbols-outlined text-[14px]">east</span>
            </a>
          </div>

          <!-- Card 2: Community & Volunteering -->
          <div class="p-6 md:p-8 bg-surface-container-low border border-sand rounded hover:border-olive/60 transition-colors group">
            <div class="w-12 h-12 rounded bg-parchment border border-sand flex items-center justify-center text-olive mb-5 group-hover:bg-olive group-hover:text-parchment transition-colors">
              <span class="material-symbols-outlined text-[24px]">groups</span>
            </div>
            <h3 class="font-serif text-xl font-semibold text-ink mb-3 group-hover:text-olive transition-colors">
              Community & Volunteering
            </h3>
            <p class="font-sans text-sm text-secondary leading-relaxed mb-4">
              Enriched by book donations, oral history contributions, and volunteer support, our library is built collaboratively by the community.
            </p>
            <a href="/en/contact" class="inline-flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wider text-ink group-hover:text-olive">
              <span>Join Us</span>
              <span class="material-symbols-outlined text-[14px]">east</span>
            </a>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- 3. Upcoming Events Section (Gündem & Yaklaşan Etkinlikler) -->
  <section class="py-24 md:py-32 px-margin-mobile md:px-margin-desktop bg-surface-container-low border-b border-sand">
    <div class="max-w-container-max mx-auto">
      
      <!-- Section Header -->
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 pb-6 border-b border-sand gap-4">
        <div>
          <span class="font-sans text-xs uppercase tracking-[0.2em] text-olive font-semibold block mb-2">AGENDA</span>
          <h2 class="font-serif text-3xl sm:text-4xl md:text-5xl text-ink leading-tight">
            {t.upcomingEvents}
          </h2>
        </div>
        <a
          href="/en/events"
          class="inline-flex items-center gap-2 font-sans text-xs font-bold uppercase tracking-widest text-ink hover:text-olive transition-colors group"
        >
          <span>{t.viewAll}</span>
          <span class="material-symbols-outlined text-[16px] transition-transform group-hover:translate-x-1">arrow_forward</span>
        </a>
      </div>

      <!-- 3-Card Events Grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {upcomingEvents.map((event) => (
          <article class="bg-parchment border border-sand rounded overflow-hidden flex flex-col group hover:shadow-md transition-shadow">
            <!-- Event Image Container -->
            <a href="/en/events" class="block relative aspect-[16/10] overflow-hidden bg-sand/30">
              <img
                src={event.data.image}
                alt={event.data.titleEn}
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-ink/5 group-hover:bg-transparent transition-colors"></div>
              
              <!-- Floating Date Badge -->
              <div class="absolute top-4 left-4 bg-ink text-parchment font-mono text-[11px] font-semibold px-3 py-1.5 uppercase tracking-wider rounded-sm shadow">
                {event.data.displayDateEn}
              </div>
            </a>

            <!-- Event Card Content -->
            <div class="p-6 flex-1 flex flex-col justify-between">
              <div>
                <!-- Category & Location Badges -->
                <div class="flex items-center justify-between gap-2 mb-3">
                  <span class="text-xs uppercase tracking-widest text-olive font-semibold">
                    {event.data.categoryLabelEn}
                  </span>
                  <span class="text-xs text-stone-gray flex items-center gap-1">
                    <span class="material-symbols-outlined text-[14px]">location_on</span>
                    {event.data.locationEn}
                  </span>
                </div>

                <!-- Event Title -->
                <h3 class="font-serif text-xl font-semibold text-ink leading-snug mb-3 group-hover:text-olive transition-colors">
                  <a href="/en/events">
                    {event.data.titleEn}
                  </a>
                </h3>

                <!-- Event Summary -->
                <p class="font-sans text-sm text-secondary leading-relaxed line-clamp-3 mb-6">
                  {event.data.summaryEn}
                </p>
              </div>

              <!-- Card Action Link -->
              <div class="pt-4 border-t border-sand/60">
                <a
                  href="/en/events"
                  class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-ink group-hover:text-olive transition-colors"
                >
                  <span>Explore Details</span>
                  <span class="material-symbols-outlined text-[14px] transition-transform group-hover:translate-x-1">arrow_forward</span>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>

    </div>
  </section>

  <!-- 4. Digital Talks Section (Dijital Yayınlar & Söyleşiler) -->
  <section class="py-24 md:py-32 px-margin-mobile md:px-margin-desktop bg-parchment border-b border-sand">
    <div class="max-w-container-max mx-auto">
      
      <!-- Section Header -->
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 pb-6 border-b border-sand gap-4">
        <div>
          <span class="font-sans text-xs uppercase tracking-[0.2em] text-olive font-semibold block mb-2">DIGITAL ARCHIVES</span>
          <h2 class="font-serif text-3xl sm:text-4xl md:text-5xl text-ink leading-tight">
            Library Talks & Recordings
          </h2>
          <p class="font-sans text-sm md:text-base text-secondary mt-2 max-w-xl">
            Watch recorded panels, discussions with scholars, and literary conversations on our YouTube channel.
          </p>
        </div>
        <a
          href="/en/talks"
          class="inline-flex items-center gap-2 font-sans text-xs font-bold uppercase tracking-widest text-ink hover:text-olive transition-colors group shrink-0"
        >
          <span>View All Talks</span>
          <span class="material-symbols-outlined text-[16px] transition-transform group-hover:translate-x-1">arrow_forward</span>
        </a>
      </div>

      <!-- 2 Video Cards Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-gutter">
        {latestTalks.map((talk) => (
          <div class="bg-surface-container-low border border-sand rounded overflow-hidden flex flex-col group hover:shadow-md transition-shadow">
            
            <!-- Video Thumbnail with Play Button Overlay -->
            <div
              class="relative aspect-video overflow-hidden bg-black cursor-pointer"
              data-youtube-id={talk.data.youtubeId}
              data-video-title={talk.data.titleEn}
              data-video-subtitle={`${talk.data.guestEn} • ${talk.data.roleEn}`}
              role="button"
              tabindex="0"
              aria-label={`Watch Video: ${talk.data.titleEn}`}
            >
              <img
                src={talk.data.thumbnail}
                alt={talk.data.titleEn}
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105 opacity-90 group-hover:opacity-100"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-ink/20 group-hover:bg-ink/10 transition-colors"></div>

              <!-- Play Button Center Overlay -->
              <div class="absolute inset-0 flex items-center justify-center">
                <div class="w-16 h-16 rounded-full bg-parchment/90 backdrop-blur-sm text-ink flex items-center justify-center shadow-lg transition-transform duration-300 group-hover:scale-110 group-hover:bg-olive group-hover:text-parchment">
                  <span class="material-symbols-outlined text-[32px] ml-0.5">play_arrow</span>
                </div>
              </div>

              <!-- Duration Badge -->
              <div class="absolute bottom-3 right-3 bg-ink/80 backdrop-blur-sm text-parchment font-mono text-xs px-2.5 py-1 rounded flex items-center gap-1">
                <span class="material-symbols-outlined text-[13px]">schedule</span>
                <span>{talk.data.duration}</span>
              </div>
            </div>

            <!-- Video Info & Meta -->
            <div class="p-6 md:p-8 flex-1 flex flex-col justify-between">
              <div>
                <div class="flex items-center gap-2 mb-2">
                  <span class="font-sans text-xs font-semibold uppercase tracking-widest text-olive">
                    {talk.data.roleEn}
                  </span>
                  <span class="text-stone-gray text-xs">•</span>
                  <span class="font-sans text-xs text-stone-gray">
                    {talk.data.guestEn}
                  </span>
                </div>

                <h3 class="font-serif text-xl md:text-2xl font-semibold text-ink leading-snug mb-3 group-hover:text-olive transition-colors">
                  {talk.data.titleEn}
                </h3>

                <p class="font-sans text-sm text-secondary leading-relaxed line-clamp-2 mb-6">
                  {talk.data.summaryEn}
                </p>
              </div>

              <!-- Video Modal Trigger Button -->
              <div class="pt-4 border-t border-sand/60 flex items-center justify-between">
                <button
                  type="button"
                  data-youtube-id={talk.data.youtubeId}
                  data-video-title={talk.data.titleEn}
                  data-video-subtitle={`${talk.data.guestEn} • ${talk.data.roleEn}`}
                  class="inline-flex items-center gap-2 font-sans text-xs font-bold uppercase tracking-wider text-ink hover:text-olive transition-colors group/btn cursor-pointer"
                >
                  <span class="material-symbols-outlined text-[18px] text-olive">smart_display</span>
                  <span>{t.watchOnYoutube}</span>
                  <span class="material-symbols-outlined text-[14px] transition-transform group-hover/btn:translate-x-1">north_east</span>
                </button>

                <span class="font-mono text-[11px] text-stone-gray">
                  {talk.data.date}
                </span>
              </div>
            </div>

          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- 5. Newsletter / Community Invitation -->
  <section class="py-20 md:py-28 px-margin-mobile md:px-margin-desktop bg-surface-container relative overflow-hidden">
    <!-- Ex Libris Watermark Background -->
    <div class="absolute -bottom-12 -left-12 ex-libris-watermark pointer-events-none select-none">
      <span class="material-symbols-outlined text-[280px] text-olive leading-none">menu_book</span>
    </div>

    <div class="max-w-4xl mx-auto relative z-10 text-center">
      <span class="font-sans text-xs uppercase tracking-[0.2em] text-olive font-semibold block mb-3">
        COMMUNITY INVITATION
      </span>
      <h2 class="font-serif text-3xl sm:text-4xl md:text-5xl text-ink leading-tight mb-6">
        {t.subscribeNewsletter}
      </h2>
      <p class="font-sans text-base md:text-lg text-secondary leading-relaxed max-w-2xl mx-auto mb-10">
        {t.newsletterDesc}
      </p>

      <!-- Interactive Newsletter Form -->
      <form id="home-newsletter-form-en" class="max-w-xl mx-auto flex flex-col sm:flex-row gap-3">
        <input
          type="email"
          id="home-newsletter-email-en"
          name="email"
          required
          placeholder="Enter your email address..."
          class="flex-1 px-5 py-4 bg-surface-bright border border-sand text-ink text-sm placeholder:text-stone-gray/70 focus:outline-none focus:border-olive focus:ring-1 focus:ring-olive rounded-sm shadow-sm"
          aria-label="Your email address"
        />
        <button
          type="submit"
          class="px-8 py-4 bg-ink text-parchment font-sans font-semibold text-xs tracking-widest uppercase hover:bg-olive transition-colors rounded-sm shadow-sm shrink-0 flex items-center justify-center gap-2 cursor-pointer"
        >
          <span>{t.subscribeButton}</span>
          <span class="material-symbols-outlined text-[16px]">send</span>
        </button>
      </form>

      <p class="font-sans text-xs text-stone-gray mt-4">
        We respect your privacy. You can unsubscribe at any time.
      </p>
    </div>
  </section>

  <!-- Client-side Script for Newsletter Submission -->
  <script>
    function setupNewsletterEn() {
      const form = document.getElementById('home-newsletter-form-en') as HTMLFormElement | null;
      const input = document.getElementById('home-newsletter-email-en') as HTMLInputElement | null;

      if (!form || !input) return;

      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const email = input.value.trim();

        if (email && email.includes('@')) {
          if (typeof (window as any).showToast === 'function') {
            (window as any).showToast('Thank you for subscribing to our newsletter!', 'success');
          }
          input.value = '';
        } else {
          if (typeof (window as any).showToast === 'function') {
            (window as any).showToast('Please enter a valid email address.', 'error');
          }
        }
      });
    }

    setupNewsletterEn();
    document.addEventListener('astro:page-load', setupNewsletterEn);
  </script>
</Layout>
