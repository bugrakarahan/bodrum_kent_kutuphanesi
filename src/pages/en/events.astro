---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { getT } from '../../utils/i18n';

const lang = 'en';
const t = getT(lang);

const allEvents = await getCollection('events');
const upcomingEvents = allEvents.filter((e) => !e.data.isPast);
const pastEvents = allEvents.filter((e) => e.data.isPast);

const pastEventCategoriesEn = [
  "ALL", "LITERATURE", "CULTURE", "ARTS", "HISTORY", "PHILOSOPHY", "ARCHAEOLOGY", "SOCIOLOGY", "PSYCHOLOGY", "ECOLOGY", "SCIENCE"
];
---

<Layout
  title={`Events | ${t.siteTitle}`}
  description="Bodrum City Library events, book club, talks, and cultural gatherings."
  lang={lang}
  currentPath="/en/events"
>
  <!-- Hero Header -->
  <section class="py-10 md:py-14 px-5 md:px-12 bg-surface-bright border-b border-sand">
    <div class="max-w-[1280px] mx-auto">
      <div class="max-w-3xl">
        <h1 class="font-serif text-3xl sm:text-4xl text-ink font-bold leading-tight mb-3">
          Events in the Light of Knowledge and Art
        </h1>
        <p class="font-sans text-base sm:text-lg text-ink/80 leading-relaxed">
          We look forward to welcoming you to our events in Literature, History, Archaeology, Philosophy, Sociology, and Arts…
        </p>
      </div>
    </div>
  </section>

  <!-- Main Content Area -->
  <div class="max-w-[1280px] mx-auto px-5 md:px-12 py-10 md:py-14 space-y-16">
    
    <!-- Upcoming Events Section -->
    <section>
      <h2 class="font-serif text-2xl sm:text-3xl text-ink font-bold mb-6 pb-3 border-b border-sand">
        Upcoming Events
      </h2>

      {upcomingEvents.map((event) => (
        <div class="bg-surface-container-low border-2 border-olive p-6 sm:p-10 shadow-xs rounded-xs">
          <div>
            <div class="inline-block px-3.5 py-1 bg-olive text-white text-xs font-sans uppercase tracking-widest font-bold mb-4 rounded-xs">
              {event.data.categoryLabelEn}
            </div>

            <h3 class="font-serif text-2xl sm:text-3xl text-ink font-bold leading-tight mb-6">
              {event.data.titleEn}
            </h3>

            <div class="space-y-6 text-ink/90 font-sans text-base sm:text-lg leading-relaxed text-justify">
              <p>
                We aim to be a distinctive book club that challenges conventional thinking. The books we select and the topics we discuss will be thought-provoking and inquisitive.
              </p>
              
              <p>
                We seek an environment of vigorous and constructive debate where differing viewpoints meet. If you are ready to explore, question, and reflect together, you are warmly invited to our Book Club!
              </p>

              <!-- 4/3 Centered Image -->
              <div class="my-6 max-w-xl mx-auto bg-parchment border-2 border-olive p-3 rounded-xs shadow-md">
                <div class="aspect-[4/3] overflow-hidden bg-surface-container-high relative border border-sand/60 rounded-2xs">
                  <img
                    src="https://lh3.googleusercontent.com/aida-public/AB6AXuDQ_kg3bbgJ4ynOz1o7DQcY3YaIdeG_zUESiNKW-81FsNfEZqrXlPi-ZAYWzb2FYdKriB4ESdIgn04zGCTSrnOaQAobk2tEQSDMKK4TlQhdPdjUJk74KLsSusQUSR9nHe1QycFJgHdfJUQSr8eFa2k0wQHdX3j1D5aQBbxg9mUEAGpQs_UGA_l1geAuKfbBil5Wy-_VugN7cjAepbQ_HoOugyaLOfsfF-vsYSCOhY75Ao3sAvwHFdv3nGJYn9whKvXn8vnrP8j4yEE"
                    alt="Bodrum City Library Book Club"
                    class="w-full h-full object-cover"
                  />
                </div>
                <div class="pt-2 text-center text-xs text-stone-gray font-sans italic">
                  Bodrum City Library • Book Club Sessions
                </div>
              </div>

              <p class="font-bold text-olive">
                If you are ready to change, question, and reflect together, join our Book Club!
              </p>
            </div>

            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pt-6 mt-6 border-t border-sand">
              <div class="flex flex-wrap items-center gap-3">
                <a
                  href="https://wa.me/905423739748?text=Hello,%20I%20would%20like%20to%20join%20the%20Bodrum%20City%20Library%20Book%20Club."
                  target="_blank"
                  rel="noopener noreferrer"
                  class="px-6 py-3 bg-olive hover:bg-bodrum-blue-dark text-white text-xs sm:text-sm font-sans font-bold tracking-wider uppercase transition-colors shadow-xs shrink-0 rounded-xs inline-flex items-center gap-2"
                >
                  <span class="material-symbols-outlined text-base">chat</span>
                  <span>JOIN OUR BOOK CLUB</span>
                </a>

                <a
                  href="https://calendar.google.com/calendar/render?action=TEMPLATE&text=Bodrum+City+Library+Book+Club&details=Bodrum+City+Library+Book+Club+Meeting&location=Kizilagac%2C+Bodrum"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="px-4 py-3 bg-parchment border border-olive text-olive hover:bg-olive hover:text-white text-xs sm:text-sm font-sans font-bold tracking-wider uppercase transition-colors shadow-xs shrink-0 rounded-xs inline-flex items-center gap-1.5"
                  title="Add to Google Calendar"
                >
                  <span class="material-symbols-outlined text-base">calendar_add_on</span>
                  <span>Add to Calendar</span>
                </a>
              </div>

              <span class="text-xs sm:text-sm font-sans italic text-ink/80 leading-snug">
                Announcements and initial meeting schedule have been shared on Instagram and WhatsApp.
              </span>
            </div>
          </div>
        </div>
      ))}
    </section>

    <!-- Past Events Section -->
    <section>
      <h2 class="font-serif text-2xl sm:text-3xl text-ink font-bold mb-4 pb-3 border-b border-sand">
        Past Events
      </h2>

      <!-- Topic Badges: Centered -->
      <div class="flex flex-wrap items-center justify-center gap-2 mb-8 text-xs font-sans font-bold pt-2">
        {pastEventCategoriesEn.map((cat, idx) => (
          <span class={`px-3 py-1.5 uppercase tracking-wider rounded-xs transition-colors shadow-2xs ${
            idx === 0
              ? 'bg-olive text-white ring-2 ring-olive/40'
              : 'bg-olive text-white hover:bg-bodrum-blue-dark'
          }`}>
            {cat}
          </span>
        ))}
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {pastEvents.map((event) => (
          <div class="bg-surface-container-low border-2 border-olive p-5 sm:p-6 flex flex-col justify-between shadow-xs rounded-xs">
            <div>
              <div 
                class="aspect-[16/10] overflow-hidden bg-surface-container-high mb-4 border border-sand rounded-2xs cursor-pointer group relative"
                data-gallery-trigger
                data-gallery-title={event.data.titleEn}
                data-gallery-photos={JSON.stringify(event.data.photos || [event.data.image])}
              >
                <img
                  src={event.data.image}
                  alt={event.data.titleEn}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                />
                <div class="absolute inset-0 bg-black/30 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center text-white text-xs font-sans font-bold uppercase tracking-wider gap-1.5">
                  <span class="material-symbols-outlined text-lg">photo_library</span>
                  <span>View Photos & Poster</span>
                </div>
              </div>

              <div class="flex items-center justify-between text-xs text-stone-gray font-mono mb-2">
                <span class="text-olive font-sans font-bold text-xs uppercase">{event.data.categoryLabelEn}</span>
                <span class="font-bold">{event.data.displayDateEn}</span>
              </div>

              <h3 class="font-serif text-lg sm:text-xl text-ink font-bold mb-3 leading-snug text-center">
                Anthropologist & Archaeologist<br />
                <span class="text-olive font-bold">Timuçin Binder with</span><br />
                Sky Myths of Ancient Aegean
              </h3>

              <div class="text-sm text-ink/85 font-sans leading-relaxed mb-5 space-y-2 whitespace-pre-line text-justify">
                {event.data.summaryEn}
              </div>
            </div>

            <div class="flex items-center justify-center gap-3 pt-3 border-t border-sand">
              <button
                type="button"
                class="px-4 py-1.5 bg-olive text-white hover:bg-bodrum-blue-dark text-xs font-sans font-bold uppercase tracking-wider transition-colors rounded-xs shadow-2xs cursor-pointer"
                onclick={`alert('${event.data.titleEn}\\n\\n${event.data.summaryEn}')`}
              >
                Details
              </button>

              <button
                type="button"
                class="px-4 py-1.5 bg-parchment border border-olive text-olive hover:bg-olive hover:text-white text-xs font-sans font-bold uppercase tracking-wider transition-colors rounded-xs shadow-2xs cursor-pointer inline-flex items-center gap-1"
                data-gallery-trigger
                data-gallery-title={event.data.titleEn}
                data-gallery-photos={JSON.stringify(event.data.photos || [event.data.image])}
              >
                <span class="material-symbols-outlined text-sm">photo_library</span>
                <span>Gallery</span>
              </button>
            </div>
          </div>
        ))}
      </div>
    </section>

  </div>
</Layout>
