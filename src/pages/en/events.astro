---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { getT } from '../../utils/i18n';

const lang = 'en';
const t = getT(lang);

const allEvents = await getCollection('events');
const upcomingEvents = allEvents.filter((e) => !e.data.isPast);
const pastEvents = allEvents.filter((e) => e.data.isPast);

const pastEventCategoriesEn = [
  "ALL", "LITERATURE", "CULTURE", "ARTS", "HISTORY", "PHILOSOPHY", "ARCHAEOLOGY", "SOCIOLOGY", "PSYCHOLOGY", "ECOLOGY", "SCIENCE"
];
---

<Layout
  title={`Events | ${t.siteTitle}`}
  description="Bodrum City Library events, book club, talks, and cultural gatherings."
  lang={lang}
  currentPath="/en/events"
>
  <!-- Hero Header -->
  <section class="py-6 md:py-10 px-5 md:px-12 bg-surface-bright border-b border-sand">
    <div class="max-w-[1280px] mx-auto">
      <div class="max-w-3xl">
        <h1 class="font-serif text-xl sm:text-2xl text-ink font-bold leading-snug mb-2">
          Events in the Light of Knowledge and Art
        </h1>
        <p class="font-sans text-xs sm:text-sm text-ink/80 leading-relaxed">
          We look forward to welcoming you to our events in Literature, History, Archaeology, Philosophy, Sociology, and Arts…
        </p>
      </div>
    </div>
  </section>

  <!-- Main Content Area -->
  <div class="max-w-[1280px] mx-auto px-5 md:px-12 py-6 md:py-10 space-y-12">
    
    <!-- 1. Upcoming Events (Left-aligned 3-column Grid) -->
    <section>
      <h2 class="font-serif text-lg sm:text-xl text-ink font-bold mb-4 pb-2 border-b border-sand">
        Upcoming Events
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {upcomingEvents.map((event) => {
          const eventPayload = JSON.stringify({
            title: event.data.titleEn,
            category: event.data.categoryLabelEn,
            date: event.data.date,
            displayDate: event.data.displayDateEn,
            location: event.data.locationEn,
            summary: event.data.summaryEn,
            image: event.data.image,
            photos: event.data.photos || []
          });

          return (
            <div class="bg-surface-container-low border-2 border-olive p-4 sm:p-5 flex flex-col justify-between shadow-xs rounded-xs">
              <div>
                <div 
                  class="aspect-[3/4] w-full bg-parchment border-2 border-olive p-1.5 rounded-xs shadow-sm cursor-pointer group mb-3.5 relative overflow-hidden"
                  data-event-detail-trigger
                  data-event-data={eventPayload}
                  title="View Event Details"
                >
                  <div class="w-full h-full overflow-hidden bg-surface-container-high relative border border-sand/60 rounded-2xs flex items-center justify-center">
                    <img
                      src={event.data.image}
                      alt="Bodrum City Library Book Club"
                      class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-300"
                    />
                  </div>
                  <div class="absolute inset-0 bg-black/30 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center text-white text-xs font-sans font-bold uppercase tracking-wider gap-1">
                    <span class="material-symbols-outlined text-sm">open_in_new</span>
                    <span>View Details</span>
                  </div>
                </div>

                <div class="flex items-center justify-between text-xs text-stone-gray font-mono mb-2">
                  <span class="text-olive font-sans font-bold text-xs uppercase">{event.data.categoryLabelEn}</span>
                  <span class="font-bold">{event.data.displayDateEn}</span>
                </div>

                <h3 class="font-serif text-base sm:text-lg text-ink font-bold leading-snug mb-2.5">
                  {event.data.titleEn}
                </h3>

                <div class="space-y-2 text-xs sm:text-[13px] text-ink/85 font-sans leading-relaxed text-justify mb-4">
                  <p>
                    We aim to be a distinctive book club that challenges conventional thinking. The books we select and the topics we discuss will be thought-provoking and inquisitive.
                  </p>
                  <p class="font-bold text-olive">
                    If you are ready to change, question, and reflect together, join our Book Club!
                  </p>
                </div>
              </div>

              <!-- Action Buttons -->
              <div class="pt-3 border-t border-sand space-y-2">
                <div class="flex items-center gap-2">
                  <a
                    href="https://wa.me/905423739748?text=Hello,%20I%20would%20like%20to%20join%20the%20Bodrum%20City%20Library%20Book%20Club."
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex-1 py-2 bg-olive hover:bg-bodrum-blue-dark text-white text-xs font-sans font-bold tracking-wider uppercase transition-colors shadow-xs rounded-xs inline-flex items-center justify-center gap-1"
                  >
                    <span class="material-symbols-outlined text-sm">chat</span>
                    <span>JOIN</span>
                  </a>

                  <button
                    type="button"
                    class="flex-1 py-2 bg-parchment border border-olive text-olive hover:bg-olive hover:text-white text-xs font-sans font-bold tracking-wider uppercase transition-colors shadow-xs rounded-xs inline-flex items-center justify-center gap-1 cursor-pointer"
                    data-event-detail-trigger
                    data-event-data={eventPayload}
                  >
                    <span class="material-symbols-outlined text-sm">event_note</span>
                    <span>DETAILS</span>
                  </button>
                </div>

                <div class="text-[10px] font-sans italic text-stone-gray text-center">
                  Updates via WhatsApp & Instagram.
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </section>

    <!-- 2. Past Events (Left-aligned 3-column Grid) -->
    <section>
      <h2 class="font-serif text-lg sm:text-xl text-ink font-bold mb-3 pb-2 border-b border-sand">
        Past Events
      </h2>

      <div class="flex flex-wrap items-center justify-center gap-1.5 mb-6 text-[11px] font-sans font-bold pt-1">
        {pastEventCategoriesEn.map((cat, idx) => (
          <span class={`px-2.5 py-1 uppercase tracking-wider rounded-xs transition-colors shadow-2xs ${
            idx === 0
              ? 'bg-olive text-white ring-2 ring-olive/40'
              : 'bg-olive text-white hover:bg-bodrum-blue-dark'
          }`}>
            {cat}
          </span>
        ))}
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {pastEvents.map((event) => {
          const eventPayload = JSON.stringify({
            title: event.data.titleEn,
            category: event.data.categoryLabelEn,
            date: event.data.date,
            displayDate: event.data.displayDateEn,
            location: event.data.locationEn,
            summary: event.data.summaryEn,
            image: event.data.image,
            photos: event.data.photos || []
          });

          return (
            <div class="bg-surface-container-low border-2 border-olive p-4 sm:p-5 flex flex-col justify-between shadow-xs rounded-xs">
              <div>
                <div 
                  class="aspect-[3/4] w-full overflow-hidden bg-surface-container-high border-2 border-olive rounded-xs mb-3.5 cursor-pointer group relative shadow-sm"
                  data-gallery-trigger
                  data-gallery-title={event.data.titleEn}
                  data-gallery-photos={JSON.stringify(event.data.photos || [event.data.image])}
                  title="View 11 Photos Archive"
                >
                  <img
                    src={event.data.image}
                    alt={event.data.titleEn}
                    class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-300"
                  />
                  <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center text-white text-xs font-sans font-bold uppercase tracking-wider gap-1.5 p-2 text-center">
                    <span class="material-symbols-outlined text-base">photo_library</span>
                    <span>View Photos (11)</span>
                  </div>
                </div>

                <div class="flex items-center justify-between text-xs text-stone-gray font-mono mb-2">
                  <span class="text-olive font-sans font-bold text-xs uppercase">{event.data.categoryLabelEn}</span>
                  <span class="font-bold">{event.data.displayDateEn}</span>
                </div>

                <h3 class="font-serif text-base sm:text-lg text-ink font-bold mb-2.5 leading-snug text-center">
                  Anthropologist & Archaeologist<br />
                  <span class="text-olive">Timuçin Binder with</span><br />
                  Sky Myths of Ancient Aegean
                </h3>

                <div class="text-xs text-ink/85 font-sans leading-relaxed mb-4 space-y-2 whitespace-pre-line text-justify">
                  {event.data.summaryEn}
                </div>
              </div>

              <div class="flex items-center justify-center gap-2.5 pt-3 border-t border-sand">
                <button
                  type="button"
                  class="flex-1 py-2 bg-olive text-white hover:bg-bodrum-blue-dark text-xs font-sans font-bold uppercase tracking-wider transition-colors rounded-xs shadow-2xs cursor-pointer inline-flex items-center justify-center gap-1"
                  data-event-detail-trigger
                  data-event-data={eventPayload}
                >
                  <span class="material-symbols-outlined text-sm">event_note</span>
                  <span>Details</span>
                </button>

                <button
                  type="button"
                  class="flex-1 py-2 bg-parchment border border-olive text-olive hover:bg-olive hover:text-white text-xs font-sans font-bold uppercase tracking-wider transition-colors rounded-xs shadow-2xs cursor-pointer inline-flex items-center justify-center gap-1"
                  data-gallery-trigger
                  data-gallery-title={event.data.titleEn}
                  data-gallery-photos={JSON.stringify(event.data.photos || [event.data.image])}
                >
                  <span class="material-symbols-outlined text-sm">photo_library</span>
                  <span>Photos</span>
                </button>
              </div>
            </div>
          );
        })}
      </div>
    </section>

  </div>
</Layout>
