---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { getT } from '../../utils/i18n';

const lang = 'en';
const t = getT(lang);

const allEvents = await getCollection('events');
const upcomingEvents = allEvents.filter((e) => !e.data.isPast);
const pastEvents = allEvents.filter((e) => e.data.isPast);
---

<Layout
  title={`Events | ${t.siteTitle}`}
  description="Bodrum City Library events, book club, talks, and cultural gatherings."
  lang={lang}
  currentPath="/en/events"
>
  <!-- Hero Header -->
  <section class="py-16 md:py-24 px-5 md:px-12 bg-surface-bright border-b border-sand">
    <div class="max-w-[1280px] mx-auto">
      <div class="max-w-3xl">
        <h1 class="font-serif text-3xl sm:text-4xl md:text-5xl text-ink font-bold leading-tight mb-4">
          Events in the Light of Knowledge and Art
        </h1>
        <p class="font-serif text-lg sm:text-xl text-ink/80 leading-relaxed">
          We look forward to welcoming you to our events in Literature, History, Archaeology, Philosophy, Sociology, and Arts…
        </p>
      </div>
    </div>
  </section>

  <!-- Main Content Area -->
  <div class="max-w-[1280px] mx-auto px-5 md:px-12 py-16">
    
    <!-- Upcoming Events Section -->
    <section class="mb-20">
      <h2 class="font-serif text-2xl sm:text-3xl text-ink font-bold mb-8 pb-3 border-b border-sand">
        Upcoming Events
      </h2>

      {upcomingEvents.map((event) => (
        <div class="bg-surface-container-low border border-sand p-8 sm:p-12 shadow-xs">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
            
            <div class="lg:col-span-8">
              <div class="inline-block px-3 py-1 bg-olive text-white text-xs font-serif uppercase tracking-widest font-semibold mb-4 rounded-xs">
                {event.data.categoryLabelEn}
              </div>

              <h3 class="font-serif text-2xl sm:text-3xl text-ink font-bold leading-tight mb-6">
                {event.data.titleEn}
              </h3>

              <div class="prose max-w-none text-ink/90 font-serif text-base sm:text-lg leading-relaxed space-y-4 whitespace-pre-line mb-8">
                {event.data.summaryEn}
              </div>

              <div class="flex flex-wrap items-center gap-4 pt-4 border-t border-sand">
                <button
                  type="button"
                  id="btn-join-bookclub-en"
                  class="px-8 py-3.5 bg-olive text-white hover:bg-ink text-sm font-serif font-semibold tracking-wider uppercase transition-colors shadow-xs"
                >
                  Join the Book Club
                </button>
                <span class="text-xs text-stone-gray font-serif italic">
                  Announcements and schedule will be shared via our official channels.
                </span>
              </div>
            </div>

            <div class="lg:col-span-4">
              <div class="bg-parchment border border-sand p-3 shadow-xs">
                <div class="aspect-[4/3] overflow-hidden bg-surface-container-high">
                  <img
                    src={event.data.image}
                    alt={event.data.titleEn}
                    class="w-full h-full object-cover grayscale contrast-110 hover:grayscale-0 transition-all duration-500"
                  />
                </div>
                <div class="p-3 text-center">
                  <span class="font-serif italic text-sm text-ink block font-bold">Bodrum City Library</span>
                  <span class="text-xs text-stone-gray font-serif">Hall & Garden</span>
                </div>
              </div>
            </div>

          </div>
        </div>
      ))}
    </section>

    <!-- Past Events Section -->
    <section>
      <h2 class="font-serif text-2xl sm:text-3xl text-ink font-bold mb-8 pb-3 border-b border-sand">
        Past Events
      </h2>

      <!-- Topic Badges -->
      <div class="flex flex-wrap gap-2 mb-8 text-xs font-serif">
        <span class="px-3.5 py-1.5 bg-olive text-white font-semibold">All</span>
        <span class="px-3.5 py-1.5 bg-surface-container-low border border-sand text-ink">Archaeology</span>
        <span class="px-3.5 py-1.5 bg-surface-container-low border border-sand text-ink">History</span>
        <span class="px-3.5 py-1.5 bg-surface-container-low border border-sand text-ink">Literature</span>
        <span class="px-3.5 py-1.5 bg-surface-container-low border border-sand text-ink">Philosophy</span>
        <span class="px-3.5 py-1.5 bg-surface-container-low border border-sand text-ink">Ecology</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {pastEvents.map((event) => (
          <div class="bg-surface-container-low border border-sand p-6 flex flex-col justify-between">
            <div>
              <div class="aspect-[16/10] overflow-hidden bg-surface-container-high mb-4 border border-sand">
                <img
                  src={event.data.image}
                  alt={event.data.titleEn}
                  class="w-full h-full object-cover grayscale contrast-110 hover:grayscale-0 transition-all duration-500"
                />
              </div>

              <div class="flex items-center justify-between text-xs text-stone-gray font-mono mb-2">
                <span class="text-olive font-serif font-bold uppercase">{event.data.categoryLabelEn}</span>
                <span>{event.data.displayDateEn}</span>
              </div>

              <h3 class="font-serif text-xl text-ink font-bold mb-3 leading-snug">
                {event.data.titleEn}
              </h3>

              <p class="text-xs sm:text-sm text-ink/80 font-serif leading-relaxed mb-6">
                {event.data.summaryEn}
              </p>
            </div>

            <div class="flex items-center gap-3 pt-4 border-t border-sand">
              <button
                type="button"
                class="px-4 py-2 bg-ink text-parchment hover:bg-olive text-xs font-serif font-semibold uppercase tracking-wider transition-colors"
                onclick={`alert('${event.data.titleEn}\\n\\n${event.data.summaryEn}')`}
              >
                Details
              </button>

              <button
                type="button"
                class="px-4 py-2 bg-parchment border border-sand text-ink hover:border-olive text-xs font-serif font-semibold uppercase tracking-wider transition-colors"
                onclick="alert('Archival photo gallery will be available soon.')"
              >
                Gallery
              </button>
            </div>
          </div>
        ))}
      </div>
    </section>

  </div>
</Layout>
