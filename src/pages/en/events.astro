---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { getT } from '../../utils/i18n';

const lang = 'en';
const t = getT(lang);

const allEvents = await getCollection('events');
const upcomingEvents = allEvents.filter((e) => !e.data.isPast);
const pastEvents = allEvents.filter((e) => e.data.isPast);

const pastEventCategoriesEn = [
  "ALL", "LITERATURE", "CULTURE", "ARTS", "HISTORY", "PHILOSOPHY", "ARCHAEOLOGY", "SOCIOLOGY", "PSYCHOLOGY", "ECOLOGY", "SCIENCE"
];
---

<Layout
  title={`Events | ${t.siteTitle}`}
  description="Bodrum City Library events, book club, talks, and cultural gatherings."
  lang={lang}
  currentPath="/en/events"
>
  <!-- Hero Header -->
  <section class="py-12 md:py-16 px-5 md:px-12 bg-surface-bright border-b border-sand">
    <div class="max-w-[1280px] mx-auto">
      <div class="max-w-3xl">
        <h1 class="font-serif text-3xl sm:text-4xl text-ink font-bold leading-tight mb-4">
          Events in the Light of Knowledge and Art
        </h1>
        <p class="font-serif text-lg sm:text-xl text-ink/80 leading-relaxed">
          We look forward to welcoming you to our events in Literature, History, Archaeology, Philosophy, Sociology, and Arts…
        </p>
      </div>
    </div>
  </section>

  <!-- Main Content Area -->
  <div class="max-w-[1280px] mx-auto px-5 md:px-12 py-12 space-y-16">
    
    <!-- Upcoming Events Section -->
    <section>
      <h2 class="font-serif text-2xl sm:text-3xl text-ink font-bold mb-6 pb-3 border-b border-sand">
        Upcoming Events
      </h2>

      {upcomingEvents.map((event) => (
        <div class="bg-surface-container-low border-2 border-olive p-6 sm:p-10 shadow-xs rounded-xs">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
            
            <div class="lg:col-span-8">
              <div class="inline-block px-3.5 py-1 bg-olive text-white text-xs font-serif uppercase tracking-widest font-bold mb-4 rounded-xs">
                {event.data.categoryLabelEn}
              </div>

              <h3 class="font-serif text-2xl sm:text-3xl text-ink font-bold leading-tight mb-5">
                {event.data.titleEn}
              </h3>

              <div class="prose max-w-none text-ink/90 font-serif text-lg leading-relaxed space-y-4 whitespace-pre-line mb-6">
                {event.data.summaryEn}
              </div>

              <div class="flex flex-col sm:flex-row sm:items-center gap-4 pt-6 border-t border-sand">
                <button
                  type="button"
                  id="btn-join-bookclub-en"
                  class="px-7 py-3 bg-olive text-white hover:bg-bodrum-blue-dark text-sm font-serif font-bold tracking-wider uppercase transition-colors shadow-xs shrink-0 rounded-xs"
                >
                  Join the Book Club
                </button>
                <span class="text-sm sm:text-base font-serif italic text-ink/80 leading-snug">
                  Announcements and schedule will be shared via our official channels.
                </span>
              </div>
            </div>

            <div class="lg:col-span-4">
              <div class="bg-parchment border-2 border-olive p-3 shadow-xs rounded-xs">
                <div class="aspect-[4/3] overflow-hidden bg-surface-container-high border border-sand/60">
                  <img
                    src={event.data.image}
                    alt={event.data.titleEn}
                    class="w-full h-full object-cover"
                  />
                </div>
                <div class="p-3 text-center">
                  <span class="font-serif italic text-base text-ink block font-bold">Bodrum City Library</span>
                  <span class="text-xs text-stone-gray font-serif">Hall & Garden</span>
                </div>
              </div>
            </div>

          </div>
        </div>
      ))}
    </section>

    <!-- Past Events Section -->
    <section>
      <h2 class="font-serif text-2xl sm:text-3xl text-ink font-bold mb-6 pb-3 border-b border-sand">
        Past Events
      </h2>

      <!-- Topic Badges -->
      <div class="flex flex-wrap items-center gap-2 mb-8 text-xs font-serif font-bold">
        {pastEventCategoriesEn.map((cat, idx) => (
          <span class={`px-3 py-1.5 uppercase tracking-wider rounded-xs transition-colors shadow-2xs ${
            idx === 0
              ? 'bg-olive text-white ring-2 ring-olive/40'
              : 'bg-olive text-white hover:bg-bodrum-blue-dark'
          }`}>
            {cat}
          </span>
        ))}
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {pastEvents.map((event) => (
          <div class="bg-surface-container-low border-2 border-olive p-6 flex flex-col justify-between shadow-xs rounded-xs">
            <div>
              <div class="aspect-[16/10] overflow-hidden bg-surface-container-high mb-4 border border-sand rounded-2xs">
                <img
                  src={event.data.image}
                  alt={event.data.titleEn}
                  class="w-full h-full object-cover"
                />
              </div>

              <div class="flex items-center justify-between text-xs text-stone-gray font-mono mb-2">
                <span class="text-olive font-serif font-bold text-xs uppercase">{event.data.categoryLabelEn}</span>
                <span class="font-bold">{event.data.displayDateEn}</span>
              </div>

              <h3 class="font-serif text-xl sm:text-2xl text-ink font-bold mb-3 leading-snug text-center">
                {event.data.titleEn}
              </h3>

              <div class="text-base text-ink/85 font-serif leading-relaxed mb-6 space-y-3 whitespace-pre-line text-justify">
                {event.data.summaryEn}
              </div>
            </div>

            <div class="flex items-center justify-center gap-3 pt-4 border-t border-sand">
              <button
                type="button"
                class="px-5 py-2 bg-olive text-white hover:bg-bodrum-blue-dark text-xs font-serif font-bold uppercase tracking-wider transition-colors rounded-xs shadow-2xs"
                onclick={`alert('${event.data.titleEn}\\n\\n${event.data.summaryEn}')`}
              >
                Details
              </button>

              <button
                type="button"
                class="px-5 py-2 bg-parchment border border-olive text-olive hover:bg-olive hover:text-white text-xs font-serif font-bold uppercase tracking-wider transition-colors rounded-xs shadow-2xs"
                onclick="alert('Archival photo gallery will be available soon.')"
              >
                Gallery
              </button>
            </div>
          </div>
        ))}
      </div>
    </section>

  </div>
</Layout>
