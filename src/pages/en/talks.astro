---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { getT } from '../../utils/i18n';

const lang = 'en';
const t = getT(lang);

const talks = await getCollection('talks');
---

<Layout
  title={`Talks | ${t.siteTitle}`}
  description="Bodrum City Library recorded talks, sessions with authors, scholars, and cultural researchers."
  lang={lang}
  currentPath="/en/talks"
>
  <!-- Hero Header -->
  <section class="py-6 md:py-10 px-5 md:px-12 bg-surface-bright border-b border-sand">
    <div class="max-w-[1280px] mx-auto">
      <div class="max-w-3xl">
        <h1 class="font-serif text-xl sm:text-2xl text-ink font-bold leading-snug mb-2">
          Literature, Art and Science Talks
        </h1>
        <p class="font-sans text-xs sm:text-sm text-ink/80 leading-relaxed">
          Digital video archive of in-depth sessions with authors, scholars, historians, and researchers.
        </p>
      </div>
    </div>
  </section>

  <!-- Video Grid: 4-Column Compact Layout -->
  <div class="max-w-[1280px] mx-auto px-5 md:px-12 py-6 md:py-10">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-5">
      {talks.map((talk) => (
        <div class="bg-surface-container-low border-2 border-olive rounded-xs p-3.5 sm:p-4 flex flex-col justify-between shadow-xs hover:shadow-md transition-shadow">
          <div>
            <div
              class="aspect-video relative overflow-hidden bg-surface-container-high border border-sand cursor-pointer group rounded-2xs mb-3"
              data-youtube-id={talk.data.youtubeId}
            >
              <img
                src={talk.data.thumbnail}
                alt={talk.data.titleEn}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
              />
              <div class="absolute inset-0 bg-ink/30 group-hover:bg-ink/10 transition-colors flex items-center justify-center">
                <div class="w-9 h-9 rounded-full bg-olive/90 text-white flex items-center justify-center shadow-lg group-hover:scale-110 transition-transform">
                  <span class="material-symbols-outlined text-xl ml-0.5">play_arrow</span>
                </div>
              </div>
              <span class="absolute bottom-1.5 right-1.5 px-1.5 py-0.5 bg-ink/85 text-parchment text-[10px] font-mono rounded">
                {talk.data.duration}
              </span>
            </div>

            <div class="flex items-center justify-between text-[11px] text-stone-gray font-mono mb-1.5">
              <span class="text-olive font-sans font-bold text-[11px] uppercase truncate mr-1">{talk.data.guestEn}</span>
              <span class="font-bold shrink-0">{talk.data.date}</span>
            </div>

            <h2 class="font-serif text-sm sm:text-base text-ink font-bold mb-2 leading-snug whitespace-pre-line text-center">
              {talk.data.titleEn}
            </h2>

            <p class="text-xs text-ink/85 font-sans leading-relaxed mb-3 text-justify line-clamp-4">
              {talk.data.summaryEn}
            </p>

            {talk.data.chapters && talk.data.chapters.length > 0 && (
              <div class="mb-3 p-2 bg-parchment border border-sand rounded-xs space-y-1">
                <div class="flex items-center gap-1 text-[10px] font-sans font-bold uppercase tracking-wider text-olive">
                  <span class="material-symbols-outlined text-xs">schedule</span>
                  <span>Chapters</span>
                </div>
                <div class="grid grid-cols-1 gap-0.5 text-[11px] font-sans">
                  {talk.data.chapters.map((chap) => (
                    <button
                      type="button"
                      class="chapter-btn flex items-center justify-between p-1 hover:bg-olive/10 rounded text-left transition-colors cursor-pointer w-full group/chap"
                      data-youtube-id={talk.data.youtubeId}
                      data-start={chap.seconds}
                    >
                      <span class="text-ink/90 group-hover/chap:text-olive font-medium truncate mr-1">{chap.titleEn}</span>
                      <span class="font-mono text-stone-gray font-bold text-[10px] bg-sand/40 px-1 py-0.2 rounded shrink-0">{chap.time}</span>
                    </button>
                  ))}
                </div>
              </div>
            )}
          </div>

          <div class="pt-2.5 border-t border-sand flex items-center justify-between">
            <button
              type="button"
              class="inline-flex items-center gap-1 text-[11px] font-sans font-bold text-olive hover:text-bodrum-blue-dark uppercase tracking-wider cursor-pointer"
              data-youtube-id={talk.data.youtubeId}
            >
              <span class="material-symbols-outlined text-sm">play_circle</span>
              <span>Watch</span>
            </button>
            <span class="text-[11px] font-sans text-stone-gray truncate ml-1">{talk.data.roleEn}</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</Layout>

<script>
  document.querySelectorAll('.chapter-btn').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const target = e.currentTarget as HTMLElement;
      const youtubeId = target.getAttribute('data-youtube-id');
      const start = target.getAttribute('data-start') || '0';
      if (youtubeId && (window as any).openVideoModal) {
        (window as any).openVideoModal(youtubeId, parseInt(start, 10));
      }
    });
  });
</script>
