---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { getT } from '../../utils/i18n';

const lang = 'en';
const t = getT(lang);

const talks = await getCollection('talks');
---

<Layout
  title={`Talks | ${t.siteTitle}`}
  description="Bodrum City Library recorded talks, sessions with authors, scholars, and cultural researchers."
  lang={lang}
  currentPath="/en/talks"
>
  <!-- Hero Header -->
  <section class="py-8 md:py-12 px-5 md:px-12 bg-surface-bright border-b border-sand">
    <div class="max-w-[1280px] mx-auto">
      <div class="max-w-3xl">
        <h1 class="font-serif text-2xl sm:text-3xl text-ink font-bold leading-tight mb-2.5">
          Literature, Art and Science Talks
        </h1>
        <p class="font-sans text-sm sm:text-base text-ink/80 leading-relaxed">
          Digital video archive of in-depth sessions with authors, scholars, historians, and researchers.
        </p>
      </div>
    </div>
  </section>

  <!-- Video Grid -->
  <div class="max-w-[1280px] mx-auto px-5 md:px-12 py-8 md:py-12">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {talks.map((talk) => (
        <div class="bg-surface-container-low border-2 border-olive rounded-xs p-5 sm:p-6 flex flex-col justify-between shadow-xs">
          <div>
            <div
              class="aspect-video relative overflow-hidden bg-surface-container-high border border-sand cursor-pointer group rounded-2xs mb-4"
              data-youtube-id={talk.data.youtubeId}
            >
              <img
                src={talk.data.thumbnail}
                alt={talk.data.titleEn}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
              />
              <div class="absolute inset-0 bg-ink/30 group-hover:bg-ink/10 transition-colors flex items-center justify-center">
                <div class="w-12 h-12 rounded-full bg-olive/90 text-white flex items-center justify-center shadow-lg group-hover:scale-110 transition-transform">
                  <span class="material-symbols-outlined text-2xl ml-0.5">play_arrow</span>
                </div>
              </div>
              <span class="absolute bottom-2.5 right-2.5 px-2 py-0.5 bg-ink/80 text-parchment text-xs font-mono rounded">
                {talk.data.duration}
              </span>
            </div>

            <div class="flex items-center justify-between text-xs text-stone-gray font-mono mb-2">
              <span class="text-olive font-sans font-bold text-xs uppercase">{talk.data.guestEn}</span>
              <span class="font-bold">{talk.data.date}</span>
            </div>

            <h2 class="font-serif text-base sm:text-lg text-ink font-bold mb-2.5 leading-snug whitespace-pre-line text-center">
              {talk.data.titleEn}
            </h2>

            <p class="text-xs sm:text-sm text-ink/85 font-sans leading-relaxed mb-4 text-justify">
              {talk.data.summaryEn}
            </p>

            {talk.data.chapters && talk.data.chapters.length > 0 && (
              <div class="mb-4 p-3 bg-parchment border border-sand rounded-xs space-y-1.5">
                <div class="flex items-center gap-1.5 text-xs font-sans font-bold uppercase tracking-wider text-olive">
                  <span class="material-symbols-outlined text-sm">schedule</span>
                  <span>Chapters & Topics</span>
                </div>
                <div class="grid grid-cols-1 gap-1 text-xs font-sans">
                  {talk.data.chapters.map((chap) => (
                    <button
                      type="button"
                      class="chapter-btn flex items-center justify-between p-1.5 hover:bg-olive/10 rounded text-left transition-colors cursor-pointer w-full group/chap"
                      data-youtube-id={talk.data.youtubeId}
                      data-start={chap.seconds}
                    >
                      <span class="text-ink/90 group-hover/chap:text-olive font-medium">{chap.titleEn}</span>
                      <span class="font-mono text-stone-gray font-bold text-[11px] bg-sand/40 px-1.5 py-0.5 rounded">{chap.time}</span>
                    </button>
                  ))}
                </div>
              </div>
            )}
          </div>

          <div class="pt-3 border-t border-sand flex items-center justify-between">
            <button
              type="button"
              class="inline-flex items-center gap-1.5 text-xs font-sans font-bold text-olive hover:text-bodrum-blue-dark uppercase tracking-wider cursor-pointer"
              data-youtube-id={talk.data.youtubeId}
            >
              <span class="material-symbols-outlined text-base">play_circle</span>
              <span>Watch Recording</span>
            </button>
            <span class="text-xs font-sans text-stone-gray">{talk.data.roleEn}</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</Layout>

<script>
  document.querySelectorAll('.chapter-btn').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const target = e.currentTarget as HTMLElement;
      const youtubeId = target.getAttribute('data-youtube-id');
      const start = target.getAttribute('data-start') || '0';
      if (youtubeId && (window as any).openVideoModal) {
        (window as any).openVideoModal(youtubeId, parseInt(start, 10));
      }
    });
  });
</script>
