---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { getT } from '../../utils/i18n';

const lang = 'en';
const t = getT(lang);

const allTalks = await getCollection('talks');

const categoriesEn = [
  "ALL", "AUTHORS", "LITERATURE", "CULTURE", "ARTS", "HISTORY", "PHILOSOPHY", "ARCHAEOLOGY", "SOCIOLOGY", "PSYCHOLOGY", "ECOLOGY", "SCIENCE"
];
---

<Layout
  title={`Talks | ${t.siteTitle}`}
  description="Conversations with authors, scholars, and artists illuminating our cultural and intellectual world."
  lang={lang}
  currentPath="/en/talks"
>
  <!-- Hero Section -->
  <section class="py-10 md:py-14 px-5 md:px-12 bg-surface-bright border-b border-sand">
    <div class="max-w-[1280px] mx-auto">
      <div class="max-w-3xl">
        <h1 class="font-serif text-3xl sm:text-4xl text-ink font-bold leading-tight mb-3">
          Culture, Art and Science Talks
        </h1>
        <p class="font-serif text-base sm:text-lg text-ink/80 leading-relaxed">
          Video recordings of our conversations with authors, artists, scientists, and researchers who enrich our cultural, social, and scientific world.
        </p>
      </div>
    </div>
  </section>

  <!-- Category Pills Bar -->
  <div class="border-b border-sand bg-parchment py-3.5 px-5 md:px-12 sticky top-24 z-30 overflow-x-auto">
    <div class="max-w-[1280px] mx-auto flex items-center justify-center gap-2 min-w-max">
      {categoriesEn.map((cat, idx) => (
        <button
          type="button"
          class={`px-3 py-1.5 text-xs font-serif font-bold uppercase tracking-wider rounded-xs transition-colors shadow-2xs ${
            idx === 0
              ? 'bg-olive text-white ring-2 ring-olive/40'
              : 'bg-olive text-white hover:bg-bodrum-blue-dark'
          }`}
        >
          {cat}
        </button>
      ))}
    </div>
  </div>

  <div class="max-w-[1280px] mx-auto px-5 md:px-12 py-10 md:py-14">
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {allTalks.map((talk) => (
        <div class="bg-surface-container-low border-2 border-olive p-5 flex flex-col justify-between shadow-xs rounded-xs">
          <div>
            <div 
              class="relative aspect-[16/9] overflow-hidden bg-black mb-4 cursor-pointer group border border-sand rounded-2xs"
              data-youtube-id={talk.data.youtubeId}
            >
              <img
                src={talk.data.thumbnail}
                alt={talk.data.titleEn}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
              
              <div class="absolute inset-0 bg-gradient-to-t from-ink/70 via-transparent to-transparent flex items-center justify-center">
                <div class="w-12 h-12 rounded-full bg-olive text-white flex items-center justify-center shadow-lg group-hover:scale-110 transition-transform">
                  <span class="material-symbols-outlined text-2xl">play_arrow</span>
                </div>
              </div>

              <div class="absolute bottom-2.5 right-2.5 px-2 py-0.5 bg-black/80 text-white font-mono text-[11px] rounded-xs">
                {talk.data.duration}
              </div>
            </div>

            <div class="flex items-center justify-between text-xs text-stone-gray font-mono mb-2 pb-1 border-b border-sand/60">
              <span class="text-olive font-serif font-bold text-xs">{talk.data.guestEn}</span>
              <span class="font-bold">{talk.data.date}</span>
            </div>

            <h3 class="font-serif text-lg sm:text-xl text-ink font-bold leading-snug mb-3 whitespace-pre-line">
              {talk.data.titleEn}
            </h3>

            <p class="font-serif text-xs sm:text-sm text-ink/85 leading-relaxed mb-4 text-justify">
              {talk.data.summaryEn}
            </p>
          </div>

          <button
            type="button"
            data-youtube-id={talk.data.youtubeId}
            class="w-full py-2.5 bg-olive hover:bg-bodrum-blue-dark text-white text-xs font-serif font-bold uppercase tracking-wider transition-colors flex items-center justify-center gap-1.5 shadow-xs rounded-xs mt-2"
          >
            <span class="material-symbols-outlined text-sm">play_circle</span>
            <span>Watch Video</span>
          </button>
        </div>
      ))}
    </div>

  </div>
</Layout>
