---
import Layout from '../../layouts/Layout.astro';
import { getT } from '../../utils/i18n';

const lang = 'en';
const t = getT(lang);

const whyJoinUsEn = [
  {
    title: "To carry Bodrum's cultural and historical heritage into the future",
    desc: "To research, document, narrate, and pass on millennia of heritage from Halicarnassus to Caria to upcoming generations."
  },
  {
    title: "To make Bodrum a vibrant hub of culture and thought",
    desc: "To establish a lively forum where books, scholarly research, panels, conferences, and diverse disciplines converge."
  },
  {
    title: "To connect authors, scholars, and researchers with readers",
    desc: "To bring renowned writers, academics, and artists from across the globe to Bodrum, cultivating enriching intellectual exchange."
  },
  {
    title: "To strengthen Bodrum's cultural bridges with the world",
    desc: "To create collaborative national and international cultural, artistic, and scientific projects across the Aegean and Mediterranean."
  },
  {
    title: "To create an open space for diverse ideas and constructive dialogue",
    desc: "To foster a distinguished intellectual climate in Bodrum by nurturing cultures of reading, inquiry, and sharing."
  },
  {
    title: "To expand access to knowledge and books",
    desc: "To establish an accessible library culture where people of all ages can read, learn, and grow."
  },
  {
    title: "To nurture children and youth within this cultural environment",
    desc: "To support tomorrow's readers, researchers, and creators through initiatives engaging them in books, science, and the arts."
  },
  {
    title: "To accomplish this together",
    desc: "To expand our cultural, artistic, and ecological initiatives with broad civic participation under our founding association."
  }
];

const supportTypesEn = [
  {
    title: "Book Donations",
    desc: "Enrich our collection with literature, history, archaeology, and scientific works concerning Bodrum, Caria, and the Mediterranean."
  },
  {
    title: "Knowledge & Expertise",
    desc: "Contribute to our talks, conferences, and workshops as a researcher, scholar, author, or specialist."
  },
  {
    title: "Financial & Corporate Sponsorship",
    desc: "Support our library operations, publication programs, academic research, and international cultural projects."
  },
  {
    title: "Volunteering",
    desc: "Offer your skills and time across event coordination, research, archiving, communications, and library services."
  },
  {
    title: "Research & Project Support",
    desc: "Participate in local historical investigations, oral history recording, and archival documentation of Bodrum."
  },
  {
    title: "Venue & Equipment Support",
    desc: "Provide spaces, event venues, or technical equipment for workshops, lectures, and exhibitions."
  },
  {
    title: "Institutional Partnerships",
    desc: "Help connect authors, academic bodies, NGOs, and cultural institutions with Bodrum City Library."
  },
  {
    title: "Community Outreach",
    desc: "Share our mission with your network, bringing together new readers, volunteers, and benefactors."
  }
];
---

<Layout
  title={`Support & Volunteer | ${t.siteTitle}`}
  description="Support Bodrum City Library, volunteer, and contribute to Bodrum's shared cultural future."
  lang={lang}
  currentPath="/en/support"
>
  <!-- Hero Section -->
  <section class="py-16 md:py-24 px-5 md:px-12 bg-surface-bright border-b border-sand">
    <div class="max-w-[1280px] mx-auto">
      <div class="max-w-3xl">
        <h1 class="font-serif text-3xl sm:text-4xl md:text-5xl text-ink font-bold leading-tight mb-4">
          Support & Volunteer
        </h1>
        <p class="font-serif text-lg sm:text-xl text-ink/80 leading-relaxed">
          Join us in building Bodrum's cultural memory and collective intellectual future.
        </p>
      </div>
    </div>
  </section>

  <div class="max-w-[1280px] mx-auto px-5 md:px-12 py-16 space-y-24">
    
    <!-- 1. Why Join Us -->
    <section>
      <h2 class="font-serif text-2xl sm:text-3xl text-ink font-bold mb-8 pb-3 border-b border-sand">
        Why Should You Join This Vision?
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {whyJoinUsEn.map((item, index) => (
          <div class="bg-surface-container-low border-2 border-olive rounded-xs p-6 sm:p-8 flex items-start gap-4 shadow-xs">
            <span class="w-8 h-8 rounded-full bg-olive text-white flex items-center justify-center font-mono text-xs font-bold shrink-0 mt-0.5 shadow-xs">
              {index + 1}
            </span>
            <div>
              <h3 class="font-serif text-xl text-ink font-bold mb-2 leading-snug">
                {item.title}
              </h3>
              <p class="font-serif text-base text-ink/85 leading-relaxed">
                {item.desc}
              </p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 2. Ways to Contribute -->
    <section>
      <h2 class="font-serif text-2xl sm:text-3xl text-ink font-bold mb-8 pb-3 border-b border-sand">
        How Can You Contribute?
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {supportTypesEn.map((item) => (
          <div class="bg-parchment border-2 border-olive rounded-xs p-6 flex flex-col justify-between hover:shadow-md transition-all shadow-xs">
            <div>
              <div class="w-10 h-10 rounded-full bg-olive/10 text-olive flex items-center justify-center mb-4">
                <span class="material-symbols-outlined text-2xl">favorite</span>
              </div>
              <h3 class="font-serif text-lg text-ink font-bold mb-2 leading-snug">
                {item.title}
              </h3>
              <p class="font-serif text-sm text-ink/80 leading-relaxed">
                {item.desc}
              </p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 3. Direct Contact & Application Form -->
    <section class="bg-surface-container-low border-2 border-olive rounded-xs p-8 sm:p-12 shadow-xs">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        
        <!-- Left: Direct Contact -->
        <div class="lg:col-span-5 space-y-6">
          <div>
            <span class="text-xs uppercase tracking-widest text-olive font-serif font-bold block mb-2">DIRECT CONTACT</span>
            <h3 class="font-serif text-2xl sm:text-3xl text-ink font-bold leading-tight mb-3">
              Speak with Our Library Coordinator
            </h3>
            <p class="font-serif text-base text-ink/85 leading-relaxed">
              Reach out to discuss your contributions and participation directly.
            </p>
          </div>

          <div class="space-y-4 pt-4 border-t border-sand text-base font-serif">
            <div class="flex items-center gap-3">
              <span class="material-symbols-outlined text-olive text-2xl">call</span>
              <div>
                <div class="text-xs text-stone-gray font-sans font-bold uppercase tracking-wider">Phone</div>
                <a href="tel:+905423739748" class="text-ink font-bold text-lg hover:text-olive transition-colors">
                  +90 (0) 542 373 97 48
                </a>
              </div>
            </div>

            <div class="flex items-center gap-3">
              <span class="material-symbols-outlined text-olive text-2xl">mail</span>
              <div>
                <div class="text-xs text-stone-gray font-sans font-bold uppercase tracking-wider">Support Coordination</div>
                <a href="mailto:destek@bodrumkentkutuphanesi.org" class="text-ink font-bold text-base hover:text-olive transition-colors">
                  destek@bodrumkentkutuphanesi.org
                </a>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <span class="material-symbols-outlined text-olive text-2xl mt-0.5">location_on</span>
              <div>
                <div class="text-xs text-stone-gray font-sans font-bold uppercase tracking-wider">Campus</div>
                <div class="text-ink font-bold text-base">Kizilagac, Bodrum / Mugla, Turkiye</div>
              </div>
            </div>
          </div>
        </div>

        <!-- Right: Form -->
        <div class="lg:col-span-7 bg-parchment border-2 border-olive rounded-xs p-6 sm:p-8 shadow-xs">
          <h3 class="font-serif text-2xl text-ink font-bold mb-2">
            Support & Volunteer Application Form
          </h3>
          <p class="font-serif text-sm text-stone-gray mb-6">
            Please fill in your details and selected areas of interest; our coordinator will get in touch with you.
          </p>

          <form id="support-form-en" class="space-y-4 font-serif">
            <div>
              <label class="block text-xs font-bold text-ink uppercase tracking-wider mb-1">Full Name *</label>
              <input 
                type="text" 
                required 
                placeholder="Your Full Name"
                class="w-full px-4 py-2.5 bg-surface-bright border border-sand text-ink text-base focus:outline-none focus:border-olive" 
              />
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-bold text-ink uppercase tracking-wider mb-1">Email Address *</label>
                <input 
                  type="email" 
                  required 
                  placeholder="name@domain.com"
                  class="w-full px-4 py-2.5 bg-surface-bright border border-sand text-ink text-base focus:outline-none focus:border-olive" 
                />
              </div>
              <div>
                <label class="block text-xs font-bold text-ink uppercase tracking-wider mb-1">Phone</label>
                <input 
                  type="tel" 
                  placeholder="+90 5XX XXX XX XX"
                  class="w-full px-4 py-2.5 bg-surface-bright border border-sand text-ink text-base focus:outline-none focus:border-olive" 
                />
              </div>
            </div>

            <div>
              <label class="block text-xs font-bold text-ink uppercase tracking-wider mb-1">Support Category *</label>
              <select required class="w-full px-4 py-2.5 bg-surface-bright border border-sand text-ink text-base focus:outline-none focus:border-olive">
                <option value="">Select category...</option>
                <option value="books">Book Donation</option>
                <option value="expertise">Knowledge & Expertise</option>
                <option value="financial">Financial / Corporate Sponsorship</option>
                <option value="volunteer">Volunteering</option>
                <option value="research">Research & Archival Support</option>
                <option value="venue">Venue & Equipment Support</option>
                <option value="network">Institutional Partnerships</option>
                <option value="other">Other</option>
              </select>
            </div>

            <div>
              <label class="block text-xs font-bold text-ink uppercase tracking-wider mb-1">Your Message / Proposal</label>
              <textarea 
                rows="4" 
                placeholder="Briefly describe your proposed contribution..."
                class="w-full px-4 py-2.5 bg-surface-bright border border-sand text-ink text-base focus:outline-none focus:border-olive"
              ></textarea>
            </div>

            <button 
              type="submit" 
              class="w-full py-3.5 bg-olive text-white hover:bg-bodrum-blue-dark text-base font-serif font-bold tracking-wider uppercase transition-colors shadow-xs"
            >
              Submit Application
            </button>
          </form>
        </div>

      </div>
    </section>

  </div>
</Layout>
