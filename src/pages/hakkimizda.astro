---
import Layout from '../layouts/Layout.astro';
import { getT } from '../utils/i18n';

const lang = 'tr';
const t = getT(lang);

const alphabeticalBoard = [
  "Birol K. Yiğitcan",
  "Canan Küçükeren",
  "Deniz Öztürk",
  "Doç. Dr. Yalçın İ. Gürkan",
  "Fikret Nesip Üçan",
  "Güldal Altuner",
  "Metin Ataç",
  "Nevra Sezer Tüfekçi",
  "Sema Sagat",
  "Sönmez Taner",
  "Ümran Yüksel"
];

const plannedActivitiesUppercase = [
  "YAZAR SÖYLEŞİ VE İMZA GÜNLERİ",
  "YAZI VE EDİTÖRLÜK ATÖLYELERİ",
  "DETAYLI ATÖLYE ÇALIŞMALARI (KİTAP VE ESER İNCELEME)",
  "KİTAP VE OKUMA KULÜPLERİ",
  "TOPLANTI, PANEL, SEMİNER, SEMPOZYUM, KONFERANS VE FESTİVAL ORGANİZASYONLARI",
  "KİTAP GÜNLERİ",
  "BİLİM, FELSEFE, ARKEOLOJİ, TARİH, SOSYOLOJİ, PSİKOLOJİ, SANAT VE SANAT TARİHİ ETKİNLİKLERİ",
  "SANAT ETKİNLİKLERİ (TİYATRO, SİNEMA, FOTOĞRAF, DANS)",
  "KARŞILAŞTIRMALI ETKİNLİKLER (ÖRN. EDEBİYAT VE FELSEFE, EDEBİYAT VE ARKEOLOJİ)",
  "OKUR BULUŞMALARI",
  "KİTAP DEĞİŞİM ETKİNLİKLERİ",
  "SERGİLER",
  "DERGİ VE GAZETE ÇALIŞMALARI",
  "BODRUM KONULU ÖZEL KİTAP KOLEKSİYONU / KİTAP KÖŞESİ",
  "ULUSAL VE ULUSLARARASI KÜTÜPHANELER, STK’LAR, MÜZELER VE KÜLTÜR-SANAT MERKEZLERİ İLE ORTAK PROJELER"
];
---

<Layout
  title={`Hakkımızda | ${t.siteTitle}`}
  description="Bodrum Kent Kütüphanesi'nin doğuşu, kurucu isimleri ve hedeflenen kültürel çalışmaları."
  lang={lang}
  currentPath="/hakkimizda"
>
  <!-- 1. Fikrin Doğuşu & Kurucu İsimler -->
  <section class="py-12 md:py-16 px-5 md:px-12 bg-surface-bright border-b border-sand relative overflow-hidden">
    <div class="max-w-[1280px] mx-auto">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start mb-10">
        
        <!-- Sol: Fikrin Doğuşu & Liste -->
        <div class="lg:col-span-7 space-y-6">
          <h1 class="font-serif text-3xl sm:text-4xl text-ink font-bold leading-tight">
            Fikrin Doğuşu
          </h1>
          
          <div class="bg-parchment p-6 sm:p-7 border border-sand shadow-xs space-y-4 text-lg text-ink/90 font-serif leading-relaxed">
            <p>
              Bodrum Kent Kütüphanesi ismi ve fikri, ilk olarak, <strong>16.09.2019</strong> tarihinde, Dibeklihan Kültür ve Sanat Köyü’nde, aşağıda yer alan değerli isimler tarafından dile getirilmiştir:
            </p>
          </div>

          <!-- Alt alta, alfabetik sıralı liste -->
          <div class="bg-parchment border border-sand p-6 shadow-xs">
            <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 text-base sm:text-lg font-serif font-bold text-ink">
              {alphabeticalBoard.map((name) => (
                <li class="flex items-center gap-2.5 py-0.5">
                  <span class="w-2 h-2 rounded-full bg-olive shrink-0"></span>
                  <span>{name}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Emanet Notu Kutusu (Açık Mavi Zemin) -->
          <div class="bg-[#EBF4FA] border border-olive/30 p-5 sm:p-6 rounded-xs shadow-2xs">
            <p class="font-serif text-base sm:text-lg text-ink font-semibold leading-relaxed">
              Bodrum Kent Kütüphanesi ismi, <strong>Sayın Sönmez Taner</strong> tarafından, <strong>7 Eylül 2019</strong> tarihinde Zeytin Taneleri Kütüphanesi ekibine emanet edilmiştir.
            </p>
          </div>
        </div>

        <!-- Sağ: Fotoğraf -->
        <div class="lg:col-span-5">
          <div class="bg-parchment border-2 border-olive p-3 rounded-xs shadow-md">
            <div class="aspect-[4/3] overflow-hidden bg-surface-container-high relative border border-sand/60">
              <img
                src="https://lh3.googleusercontent.com/aida-public/AB6AXuDQ_kg3bbgJ4ynOz1o7DQcY3YaIdeG_zUESiNKW-81FsNfEZqrXlPi-ZAYWzb2FYdKriB4ESdIgn04zGCTSrnOaQAobk2tEQSDMKK4TlQhdPdjUJk74KLsSusQUSR9nHe1QycFJgHdfJUQSr8eFa2k0wQHdX3j1D5aQBbxg9mUEAGpQs_UGA_l1geAuKfbBil5Wy-_VugN7cjAepbQ_HoOugyaLOfsfF-vsYSCOhY75Ao3sAvwHFdv3nGJYn9whKvXn8vnrP8j4yEE"
                alt="Bodrum Kent Kütüphanesi Fikrin Doğuşu"
                class="w-full h-full object-cover"
                loading="eager"
              />
            </div>
            <div class="p-2 text-center text-xs text-stone-gray font-serif italic">
              Bodrum Kent Kütüphanesi Kültürel Bellek Buluşması
            </div>
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- 2. Amaç ve Hedeflenen Çalışmalar -->
  <section class="py-12 md:py-16 px-5 md:px-12 bg-parchment border-b border-sand">
    <div class="max-w-[1280px] mx-auto">
      
      <div class="max-w-4xl mb-8">
        <h2 class="font-serif text-2xl sm:text-3xl text-ink font-bold mb-6">
          Amaç ve Hedeflenen Çalışmalar
        </h2>

        <!-- Main Manifesto Text: 2 Paragraphs (Justified) -->
        <div class="bg-surface-container-low p-6 sm:p-7 border border-sand shadow-xs mb-8 space-y-4">
          <p class="font-serif text-lg text-ink/90 leading-relaxed text-justify">
            Bodrum Kent Kütüphanesi, Bodrum’da yaşayanlar ile kenti ziyaret eden kitapseverleri, edebiyat, sanat ve bilim dünyasının değerli isimleriyle ve kitaplarıyla buluşturmayı amaçlayan, çok amaçlı ve yaşayan bir kütüphane projesidir.
          </p>
          <p class="font-serif text-lg text-ink/90 leading-relaxed text-justify">
            Kitap merkezli etkinlikler, söyleşiler, atölyeler ve kültürel buluşmalar aracılığıyla yaşam boyu öğrenmeyi, üretimi ve paylaşımı destekleyen; Halikarnas Balıkçısı’nın Akdeniz ve Mavi Hümanizmasını koruyan, Anadolu Uygarlığı’nın değerinin altını çizen; bağımsız bir buluşma alanı olarak tasarlanmaktadır.
          </p>
        </div>

        <p class="font-serif text-base sm:text-lg text-ink font-bold mb-4">
          Bu amaçla, ulusal ve uluslararası kapsamda, aşağıda belirtilen etkinliklerin yapılması hedeflenmektedir:
        </p>
      </div>

      <!-- 15 Maddelik Hedefler Grid (Bir numara daha küçük, derli toplu kutucuklar) -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {plannedActivitiesUppercase.map((act, index) => (
          <div class="bg-surface-container-low p-4 border border-olive rounded-xs shadow-2xs flex items-start gap-3">
            <span class="w-6 h-6 rounded-full bg-olive text-white flex items-center justify-center font-mono text-xs font-bold shrink-0 mt-0.5 shadow-2xs">
              {String(index + 1).padStart(2, '0')}
            </span>
            <p class="font-serif text-sm sm:text-base font-bold text-ink leading-snug">
              {act}
            </p>
          </div>
        ))}
      </div>

    </div>
  </section>
</Layout>
