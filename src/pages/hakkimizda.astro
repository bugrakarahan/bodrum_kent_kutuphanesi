---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { getT } from '../utils/i18n';

const lang = 'tr';
const t = getT(lang);

const board = await getCollection('board');
const sortedBoard = board.sort((a, b) => a.data.order - b.data.order);

const plannedActivities = [
  "Yazar söyleşi ve imza günleri",
  "Yazı ve editörlük atölyeleri",
  "Detaylı atölye çalışmaları (Kitap ve eser inceleme)",
  "Kitap ve okuma kulüpleri",
  "Toplantı, panel, seminer, sempozyum, konferans ve festival organizasyonları",
  "Kitap günleri",
  "Bilim, felsefe, arkeoloji, tarih, sosyoloji, psikoloji, sanat ve sanat tarihi etkinlikleri",
  "Sanat etkinlikleri (Tiyatro, sinema, fotoğraf, dans)",
  "Karşılaştırmalı etkinlikler (Örn. Edebiyat ve felsefe, edebiyat ve arkeoloji)",
  "Okur buluşmaları",
  "Kitap değişim etkinlikleri",
  "Sergiler",
  "Dergi ve gazete çalışmaları",
  "Bodrum konulu özel kitap koleksiyonu / kitap köşesi",
  "Ulusal ve uluslararası kütüphaneler, STK’lar, müzeler ve kültür-sanat merkezleri ile ortak projeler"
];
---

<Layout
  title={`Hakkımızda | ${t.siteTitle}`}
  description="Bodrum Kent Kütüphanesi'nin doğuşu, kurucu girişim kurulu ve hedeflenen kültürel çalışmaları."
  lang={lang}
  currentPath="/hakkimizda"
>
  <!-- 1. Fikrin Doğuşu & Girişim Kurulu -->
  <section class="py-16 md:py-24 px-5 md:px-12 bg-surface-bright border-b border-sand relative overflow-hidden">
    <div class="max-w-[1280px] mx-auto">
      
      <!-- Top Title Area -->
      <div class="max-w-3xl mb-12">
        <h1 class="font-serif text-3xl sm:text-4xl md:text-5xl text-ink font-bold leading-tight mb-6">
          Fikrin Doğuşu
        </h1>
        
        <div class="bg-parchment p-6 sm:p-8 border border-sand shadow-xs space-y-4 text-base sm:text-lg text-ink/90 font-serif leading-relaxed">
          <p>
            Bodrum Kent Kütüphanesi ismi ve fikri, ilk olarak, <strong>16.09.2019</strong> tarihinde, Dibeklihan Kültür ve Sanat Köyü’nde, aşağıda yer alan değerli isimler tarafından dile getirilmiştir:
          </p>
        </div>
      </div>

      <!-- Girişim Kurulu İsimleri Grid -->
      <div class="mb-12">
        <h2 class="font-serif text-2xl text-ink font-bold mb-6">Girişim Kurulumuz</h2>
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
          {sortedBoard.map((member) => (
            <div class="p-4 bg-parchment border border-sand hover:border-olive/50 transition-colors">
              <div class="font-serif font-bold text-ink text-base mb-1">{member.data.name}</div>
              <div class="text-xs text-stone-gray font-serif italic">{member.data.roleTr}</div>
            </div>
          ))}
        </div>
      </div>

      <!-- Emanet Notu -->
      <div class="bg-olive/5 border border-olive/20 p-6 sm:p-8 rounded-xs">
        <p class="font-serif text-base sm:text-lg text-ink font-medium leading-relaxed">
          Bodrum Kent Kütüphanesi ismi, <strong>Sayın Sönmez Taner</strong> tarafından, <strong>7 Eylül 2019</strong> tarihinde Zeytin Taneleri Kütüphanesi ekibine emanet edilmiştir.
        </p>
      </div>

    </div>
  </section>

  <!-- 2. Amaç ve Hedeflenen Çalışmalar -->
  <section class="py-16 md:py-24 px-5 md:px-12 bg-parchment border-b border-sand">
    <div class="max-w-[1280px] mx-auto">
      
      <div class="max-w-4xl mb-12">
        <h2 class="font-serif text-3xl sm:text-4xl text-ink font-bold mb-6">
          Amaç ve Hedeflenen Çalışmalar
        </h2>

        <div class="bg-surface-container-low p-6 sm:p-8 border border-sand shadow-xs mb-10">
          <p class="font-serif text-base sm:text-lg text-ink/90 leading-relaxed">
            Bodrum Kent Kütüphanesi, Bodrum’da yaşayanlar ile kenti ziyaret eden kitapseverleri, edebiyat, sanat ve bilim dünyasının değerli isimleriyle ve kitaplarıyla buluşturmayı amaçlayan, çok amaçlı ve yaşayan bir kütüphane projesidir. Kitap merkezli etkinlikler, söyleşiler, atölyeler ve kültürel buluşmalar aracılığıyla yaşam boyu öğrenmeyi, üretimi ve paylaşımı destekleyen, Akdeniz ve Anadolu hümanizmasını koruyan, bağımsız bir buluşma alanı olarak tasarlanmaktadır.
          </p>
        </div>

        <p class="font-serif text-base sm:text-lg text-ink font-semibold mb-6">
          Bu amaçla, ulusal ve uluslararası kapsamda, aşağıda belirtilen etkinliklerin yapılması hedeflenmektedir:
        </p>
      </div>

      <!-- 15 Maddelik Hedefler Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        {plannedActivities.map((act, index) => (
          <div class="bg-surface-container-low p-6 border border-sand hover:border-olive/40 transition-all flex items-start gap-4">
            <span class="w-8 h-8 rounded-full bg-olive/10 text-olive flex items-center justify-center font-mono text-xs font-bold shrink-0 mt-0.5">
              {String(index + 1).padStart(2, '0')}
            </span>
            <p class="font-serif text-base text-ink leading-relaxed">
              {act}
            </p>
          </div>
        ))}
      </div>

      <!-- Destek Çağrısı Kutusu -->
      <div class="mt-16 p-8 bg-surface-container-high border border-sand flex flex-col sm:flex-row items-center justify-between gap-6">
        <div>
          <h3 class="font-serif text-2xl text-ink font-bold mb-2">Bu Kültür Girişimine Katkıda Bulunun</h3>
          <p class="font-serif text-sm text-ink/80">
            Kitap bağışı, uzmanlık, gönüllülük veya ayni desteklerinizle Bodrum Kent Kütüphanesi'ne katılabilirsiniz.
          </p>
        </div>
        <a
          href="/destek"
          class="px-7 py-3.5 bg-olive text-white hover:bg-ink text-sm font-serif font-semibold tracking-wider uppercase transition-colors shrink-0 shadow-xs"
        >
          Destek & Gönüllü Katılım
        </a>
      </div>

    </div>
  </section>
</Layout>
