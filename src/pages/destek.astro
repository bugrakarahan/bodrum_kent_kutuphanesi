---
import Layout from '../layouts/Layout.astro';
import { getT } from '../utils/i18n';

const lang = 'tr';
const t = getT(lang);

const whyJoinUs = [
  {
    title: "Bodrum’un kültürel ve tarihsel mirasını geleceğe taşımak için",
    desc: "Kentin kadim hafızasını, sözlü tarihini ve Akdeniz kimliğini belgeleyip gelecek kuşaklara aktaran bağımsız bir kültür ocağı inşa ediyoruz."
  },
  {
    title: "Çocukların ve gençlerin kitaba, sanata ve bilime erişimini desteklemek için",
    desc: "Zeytin Taneleri Kütüphanesi ve Halikarnaslı Çocuklar projeleriyle her yaştan gencin hayal gücünü ve eleştirel düşüncesini besliyoruz."
  },
  {
    title: "Edebiyat, sanat ve bilim dünyasıyla doğrudan buluşmalar yaratmak için",
    desc: "Yazarlar, akademisyenler, sanatçılar ve araştırmacılarla Bodrum halkını aynı masa etrafında buluşturan yaşayan atölyeler ve söyleşiler düzenliyoruz."
  },
  {
    title: "Yaşayan, üreten ve paylaşan bir Bodrum topluluğu inşa etmek için",
    desc: "Tüketim yerine üretimi, yalnızlık yerine dayanışmayı koyarak Bodrum’un entelektüel hayatına kalıcı harç koyuyoruz."
  }
];

const supportTypes = [
  {
    title: "Kitap Bağışı",
    desc: "Kütüphane koleksiyonumuza ve Zeytin Taneleri Kütüphanesi’ne nitelikli kitap bağışında bulunabilirsiniz."
  },
  {
    title: "Bilgi ve Uzmanlık / Konuşmacı",
    desc: "Uzmanlık alanınızda atölye, söyleşi, seminer veya eğitim vererek katkı sunabilirsiniz."
  },
  {
    title: "Maddi / Kurumsal Destek",
    desc: "Kütüphanenin fiziki alanlarının tefrişi, etkinliklerin sürdürülebilirliği ve yayınlar için kurumsal/bireysel destek sağlayabilirsiniz."
  },
  {
    title: "Gönüllü Katılım",
    desc: "Etkinlik organizasyonu, arşivleme, çocuk atölyeleri, kütüphane düzeni veya dijital içerik üretiminde gönüllü olabilirsiniz."
  },
  {
    title: "Araştırma & Arşiv Desteği",
    desc: "Bodrum tarihi, Halikarnas Balıkçısı veya Ege kültürüyle ilgili belge, fotoğraf ve arşiv belgelerini kütüphanemize kazandırabilirsiniz."
  },
  {
    title: "Mekân, Ekipman ve Malzeme Desteği",
    desc: "Etkinlikler için mekân temini, ses/görüntü ekipmanı veya atölye malzemesi desteğinde bulunabilirsiniz."
  },
  {
    title: "Ulusal / Uluslararası Bağlantı ve İletişim",
    desc: "Kütüphanemizin yurt içi ve yurt dışındaki kurumlarla, kütüphanelerle ve STK’larla ortak projeler geliştirmesine köprü olabilirsiniz."
  },
  {
    title: "Diğer Katkılar",
    desc: "Aklınızdaki farklı bir proje, fikir veya katkı modelini bizimle paylaşabilirsiniz."
  }
];

const wishlistItems = [
  {
    id: "wish-1",
    category: "Kitap & Arşiv",
    title: "Halikarnas Balıkçısı İlk Baskıları & Nadir Bodrum Eserleri",
    desc: "Kütüphanemiz Özel Arşiv Odası için 1940-1970 arası döneme ait orijinal baskılar ve Bodrum tarihçesi yayınları.",
    status: "Aranıyor",
    selectValue: "kitap"
  },
  {
    id: "wish-2",
    category: "Çocuk & Sanat",
    title: "Zeytin Taneleri Kütüphanesi Çocuk Atölyesi Malzemeleri",
    desc: "Ahşap oturma minderleri, resim şövaleleri, suluboya takımları ve temel çocuk edebiyatı klasikleri seti.",
    status: "Devam Ediyor",
    selectValue: "mekan"
  },
  {
    id: "wish-3",
    category: "Dijital & Kayıt",
    title: "Sözlü Tarih & Söyleşi Dijital Kayıt Seti",
    desc: "Bodrum’un süngercileri, kaptanları ve yazarlarıyla yapılan arşiv kayıtları için kablosuz yaka mikrofonu seti.",
    status: "Aranıyor",
    selectValue: "mekan"
  },
  {
    id: "wish-4",
    category: "Yerleşke & Bahçe",
    title: "Açık Hava Okuma ve Sohbet Bahçesi Ahşap Bankları",
    desc: "Kızılağaç yerleşkemizde ağaç altı okuma saatleri ve küçük dinletiler için dayanıklı ahşap bank ve masa düzeni.",
    status: "İmece Aşamasında",
    selectValue: "maddi"
  }
];
---

<Layout
  title={`Destek & Gönüllü Katılım | ${t.siteTitle}`}
  description="Bodrum Kent Kütüphanesi'ne destek olun, gönüllü olarak katılın ve Bodrum'un kültürel geleceğine ortak olun."
  lang={lang}
  currentPath="/destek"
>
  <!-- Hero Header (Standardized Scale) -->
  <section class="py-6 md:py-10 px-5 md:px-12 bg-surface-bright border-b border-sand">
    <div class="max-w-[1280px] mx-auto">
      <div class="max-w-3xl">
        <h1 class="font-serif text-xl sm:text-2xl text-ink font-bold leading-snug mb-2">
          Destek & Gönüllü Katılım
        </h1>
        <p class="font-sans text-xs sm:text-sm text-ink/80 leading-relaxed">
          Bodrum’un kültürel belleğini ve geleceğini birlikte inşa etmek, bilginin ışığını çoğaltmak için siz de bu ortak hayale katılabilirsiniz.
        </p>
      </div>
    </div>
  </section>

  <div class="max-w-[1280px] mx-auto px-5 md:px-12 py-6 md:py-10 space-y-10">
    
    <!-- 1. Bu Hayale Neden Ortak Olmalısınız? -->
    <section>
      <h2 class="font-serif text-lg sm:text-xl text-ink font-bold mb-4 pb-2 border-b border-sand">
        Bu Hayale Neden Ortak Olmalısınız?
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {whyJoinUs.map((item, index) => (
          <div class="bg-surface-container-low border-2 border-olive rounded-xs p-4 sm:p-5 flex items-start gap-3 shadow-xs">
            <span class="w-6 h-6 rounded-full bg-olive text-white flex items-center justify-center font-mono text-[11px] font-bold shrink-0 mt-0.5 shadow-xs">
              {index + 1}
            </span>
            <div>
              <h3 class="font-serif text-sm sm:text-base text-ink font-bold mb-1 leading-snug">
                {item.title}
              </h3>
              <p class="font-sans text-xs text-ink/85 leading-relaxed">
                {item.desc}
              </p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 2. Şeffaf İmece & İhtiyaç Panosu -->
    <section>
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-4 pb-2 border-b border-sand">
        <div>
          <span class="text-[11px] uppercase tracking-widest text-olive font-sans font-bold block mb-0.5">ŞEFFAF İMECE</span>
          <h2 class="font-serif text-lg sm:text-xl text-ink font-bold">
            Kütüphanemizin İmece İhtiyaçları
          </h2>
        </div>
        <span class="text-[11px] font-sans text-stone-gray">
          Doğrudan somut bir ihtiyacı üstlenerek kütüphanemize güç verebilirsiniz.
        </span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {wishlistItems.map((wish) => (
          <div class="bg-parchment border-2 border-olive rounded-xs p-4 flex flex-col justify-between shadow-xs hover:shadow-md transition-all">
            <div>
              <div class="flex items-center justify-between gap-2 mb-2">
                <span class="px-2 py-0.5 bg-olive/10 text-olive text-[10px] font-sans font-bold uppercase rounded-2xs">
                  {wish.category}
                </span>
                <span class="px-2 py-0.5 bg-amber-100 text-amber-900 text-[10px] font-sans font-bold rounded-2xs">
                  {wish.status}
                </span>
              </div>

              <h3 class="font-serif text-sm sm:text-base font-bold text-ink mb-1">
                {wish.title}
              </h3>

              <p class="font-sans text-xs text-ink/80 leading-relaxed mb-3">
                {wish.desc}
              </p>
            </div>

            <button
              type="button"
              class="btn-fulfill-wish w-full py-1.5 bg-olive hover:bg-bodrum-blue-dark text-white text-[11px] font-sans font-bold uppercase tracking-wider rounded-xs transition-colors shadow-2xs flex items-center justify-center gap-1 cursor-pointer mt-1"
              data-wish-select={wish.selectValue}
              data-wish-title={wish.title}
            >
              <span class="material-symbols-outlined text-xs">volunteer_activism</span>
              <span>Bu İhtiyacı Üstlen / Destek Ol</span>
            </button>
          </div>
        ))}
      </div>
    </section>

    <!-- 3. Ne Tür Desteklerde Bulunabilirsiniz? -->
    <section>
      <h2 class="font-serif text-lg sm:text-xl text-ink font-bold mb-4 pb-2 border-b border-sand">
        Ne Tür Desteklerde Bulunabilirsiniz?
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-3.5">
        {supportTypes.map((item) => (
          <div class="bg-parchment border-2 border-olive rounded-xs p-3.5 flex flex-col justify-between hover:shadow-md transition-all shadow-xs">
            <div>
              <div class="w-7 h-7 rounded-full bg-olive/10 text-olive flex items-center justify-center mb-2">
                <span class="material-symbols-outlined text-base">favorite</span>
              </div>
              <h3 class="font-serif text-sm font-bold text-ink mb-1 leading-snug">
                {item.title}
              </h3>
              <p class="font-sans text-xs text-ink/80 leading-relaxed">
                {item.desc}
              </p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 4. Doğrudan İletişim & Başvuru Formu -->
    <section id="basvuru-alani" class="bg-surface-container-low border-2 border-olive rounded-xs p-5 sm:p-8 shadow-xs">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-start">
        
        <!-- Sol Taraf: Doğrudan İletişim -->
        <div class="lg:col-span-5 space-y-4">
          <div>
            <span class="text-[11px] uppercase tracking-widest text-olive font-sans font-bold block mb-1">DOĞRUDAN İLETİŞİM</span>
            <h3 class="font-serif text-base sm:text-lg text-ink font-bold leading-snug mb-1.5">
              Kütüphane Yetkilimiz ile Görüşün
            </h3>
            <p class="font-sans text-xs text-ink/85 leading-relaxed">
              Katkıda bulunmak istediğiniz destek ile ilgili bize doğrudan ulaşabilirsiniz.
            </p>
          </div>

          <div class="space-y-2.5 pt-2.5 border-t border-sand">
            <div class="flex items-center gap-3">
              <div class="w-8 h-8 rounded-full bg-olive text-white flex items-center justify-center shrink-0 shadow-2xs">
                <span class="material-symbols-outlined text-base">call</span>
              </div>
              <div>
                <div class="text-[10px] text-stone-gray font-sans font-bold uppercase tracking-wider">Telefon</div>
                <a href="tel:+905423739748" class="text-ink font-bold text-xs sm:text-sm hover:text-olive transition-colors">
                  +90 (0) 542 373 97 48
                </a>
              </div>
            </div>

            <div class="flex items-center gap-3">
              <div class="w-8 h-8 rounded-full bg-olive text-white flex items-center justify-center shrink-0 shadow-2xs">
                <span class="material-symbols-outlined text-base">mail</span>
              </div>
              <div>
                <div class="text-[10px] text-stone-gray font-sans font-bold uppercase tracking-wider">E-Posta</div>
                <a href="mailto:bilgi@bodrumkentkutuphanesi.org" class="text-ink font-bold text-xs sm:text-sm hover:text-olive transition-colors break-all">
                  bilgi@bodrumkentkutuphanesi.org
                </a>
              </div>
            </div>

            <div class="flex items-center gap-3">
              <div class="w-8 h-8 rounded-full bg-olive text-white flex items-center justify-center shrink-0 shadow-2xs">
                <span class="material-symbols-outlined text-base">location_on</span>
              </div>
              <div>
                <div class="text-[10px] text-stone-gray font-sans font-bold uppercase tracking-wider">Yerleşke</div>
                <span class="text-ink font-bold text-xs sm:text-sm">Kızılağaç, Bodrum / Muğla</span>
              </div>
            </div>
          </div>

          <div class="p-3 bg-parchment border border-sand rounded-xs space-y-1.5">
            <h4 class="font-serif font-bold text-ink text-xs sm:text-sm">Sponsorluk & Kurumsal Katılım</h4>
            <p class="text-[11px] text-ink/80 font-sans leading-relaxed">
              Kütüphane salonu, atölye veya yayın sponsorlukları için detaylı dosyamızı inceleyebilir, resmi kurum protokolleri talep edebilirsiniz.
            </p>
            <a
              href="/sponsorluk-dosyasi"
              class="inline-flex items-center gap-1 text-[11px] font-sans font-bold text-olive hover:underline uppercase tracking-wider pt-0.5"
            >
              <span>Sponsorluk Dosyasını İnceleyin</span>
              <span class="material-symbols-outlined text-xs">arrow_forward</span>
            </a>
          </div>
        </div>

        <!-- Sağ Taraf: Destek ve Gönüllü Katılım Formu -->
        <div class="lg:col-span-7 bg-parchment border-2 border-olive rounded-xs p-4 sm:p-6 shadow-xs">
          <h3 class="font-serif text-base sm:text-lg text-ink font-bold mb-1">
            Destek ve Gönüllü Katılım Başvuru Formu
          </h3>
          <p class="font-sans text-xs text-ink/85 mb-4">
            Bilgilerinizi ve destek sunmak istediğiniz alanı iletin, sizinle iletişime geçelim.
          </p>

          <form id="support-form" class="space-y-3 font-sans">
            <div>
              <label class="block text-[11px] font-bold text-ink uppercase tracking-wider mb-0.5">Ad Soyad *</label>
              <input 
                type="text" 
                required 
                placeholder="Adınız Soyadınız"
                class="w-full px-3 py-1.5 bg-surface-bright border border-sand text-ink text-xs focus:outline-none focus:border-olive rounded-xs" 
              />
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div>
                <label class="block text-[11px] font-bold text-ink uppercase tracking-wider mb-0.5">E-Posta *</label>
                <input 
                  type="email" 
                  required 
                  placeholder="ornek@alanadi.com"
                  class="w-full px-3 py-1.5 bg-surface-bright border border-sand text-ink text-xs focus:outline-none focus:border-olive rounded-xs" 
                />
              </div>
              <div>
                <label class="block text-[11px] font-bold text-ink uppercase tracking-wider mb-0.5">Telefon / GSM *</label>
                <input 
                  type="tel" 
                  required
                  placeholder="05XX XXX XX XX"
                  class="w-full px-3 py-1.5 bg-surface-bright border border-sand text-ink text-xs focus:outline-none focus:border-olive rounded-xs" 
                />
              </div>
            </div>

            <div>
              <label class="block text-[11px] font-bold text-ink uppercase tracking-wider mb-0.5">Destek / Katkı Türü *</label>
              <select 
                id="support-type-select"
                required
                class="w-full px-3 py-1.5 bg-surface-bright border border-sand text-ink text-xs focus:outline-none focus:border-olive rounded-xs"
              >
                <option value="">Lütfen katkı türünü seçiniz...</option>
                <option value="kitap">Kitap Bağışı</option>
                <option value="uzmanlik">Bilgi ve Uzmanlık / Konuşmacı</option>
                <option value="maddi">Maddi / Kurumsal Destek</option>
                <option value="gonullu">Gönüllü Katılım (Etkinlik, Arşiv, Atölye)</option>
                <option value="arastirma">Araştırma & Arşiv Desteği</option>
                <option value="mekan">Mekân, Ekipman ve Malzeme Desteği</option>
                <option value="baglanti">Ulusal / Uluslararası Bağlantı</option>
                <option value="diger">Diğer Katkılar</option>
              </select>
            </div>

            <div>
              <label class="block text-[11px] font-bold text-ink uppercase tracking-wider mb-0.5">Katkı & İş Birliği Detayları / Notunuz *</label>
              <textarea 
                id="support-details-textarea"
                rows="3" 
                required 
                placeholder="Hangi alanda, nasıl bir katkı veya iş birliği sağlamak istediğinizi kısaca açıklayınız..."
                class="w-full px-3 py-1.5 bg-surface-bright border border-sand text-ink text-xs focus:outline-none focus:border-olive rounded-xs"
              ></textarea>
            </div>

            <div class="flex items-start gap-2 pt-0.5">
              <input type="checkbox" id="kvkk" required class="mt-0.5 accent-olive cursor-pointer" />
              <label for="kvkk" class="text-[10px] text-stone-gray leading-tight">
                Kişisel verilerimin Bodrum Kent Kütüphanesi iletişim süreçleri kapsamında işlenmesini onaylıyorum.
              </label>
            </div>

            <button 
              type="submit" 
              class="w-full py-2.5 bg-olive text-white hover:bg-bodrum-blue-dark text-xs font-sans font-bold tracking-wider uppercase transition-colors shadow-xs rounded-xs cursor-pointer"
            >
              Destek Başvurusunu İlet
            </button>
          </form>
        </div>

      </div>
    </section>

  </div>
</Layout>

<script>
  document.querySelectorAll('.btn-fulfill-wish').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      const target = e.currentTarget as HTMLElement;
      const selectVal = target.getAttribute('data-wish-select');
      const wishTitle = target.getAttribute('data-wish-title');

      const selectEl = document.getElementById('support-type-select') as HTMLSelectElement | null;
      const textEl = document.getElementById('support-details-textarea') as HTMLTextAreaElement | null;
      const formSection = document.getElementById('basvuru-alani');

      if (selectEl && selectVal) {
        selectEl.value = selectVal;
      }

      if (textEl && wishTitle) {
        textEl.value = `[İmece İhtiyacı]: "${wishTitle}" konusunda destek olmak istiyorum. `;
        textEl.focus();
      }

      if (formSection) {
        formSection.scrollIntoView({ behavior: 'smooth' });
      }
    });
  });

  const supportForm = document.getElementById('support-form');
  if (supportForm) {
    supportForm.addEventListener('submit', (e) => {
      e.preventDefault();
      if ((window as any).showToast) {
        (window as any).showToast(
          'Destek başvurunuz başarıyla alındı! Bodrum’un kültürel hafızasına sunduğunuz katkı için teşekkür ederiz.',
          'success',
          6000
        );
      }
      (supportForm as HTMLFormElement).reset();
    });
  }
</script>
