---
import Layout from '../layouts/Layout.astro';
import { getT } from '../utils/i18n';

const lang = 'tr';
const t = getT(lang);

const whyJoinUs = [
  {
    title: "Bodrum’un kültürel ve tarihsel mirasını geleceğe taşımak için",
    desc: "Halikarnas’tan Karya’ya uzanan binlerce yıllık birikimi araştırmak, belgelemek, anlatmak ve yeni kuşaklarla buluşturmak için."
  },
  {
    title: "Bodrum’u yaşayan bir kültür ve düşünce merkezi haline getirmek için",
    desc: "Kitapların, araştırmaların, söyleşilerin, konferansların, sergilerin ve farklı disiplinlerin bir araya geldiği canlı bir buluşma alanı oluşturmak için."
  },
  {
    title: "Yazarları, araştırmacıları ve bilim insanlarını okurlarla buluşturmak için",
    desc: "Türkiye’den ve dünyanın farklı ülkelerinden yazar, akademisyen, araştırmacı ve sanatçıları Bodrum’da okurlar ve ilgililerle buluşturarak bilgi ve düşünce alışverişini güçlendirmek için."
  },
  {
    title: "Bodrum’un dünyayla kültürel bağlarını güçlendirmek için",
    desc: "Ege, Akdeniz ve komşu coğrafyalardan başlayarak ulusal ve uluslararası kültür, sanat ve bilim projeleri geliştirmek ve ortak çalışmalar üretmek için."
  },
  {
    title: "Farklı düşüncelerin bir arada özgürce konuşulabildiği bir ortam yaratmak için",
    desc: "Okuma, tartışma, araştırma ve paylaşma kültürünü güçlendirerek Bodrum’da nitelikli bir düşünce ortamının oluşmasına katkıda bulunmak için."
  },
  {
    title: "Bilgiye ve kitaba erişimi yaygınlaştırmak için",
    desc: "Her yaştan insanın okuyabileceği, öğrenebileceği, araştırabileceği ve kendisini geliştirebileceği açık ve erişilebilir bir kütüphane kültürü oluşturmak için."
  },
  {
    title: "Çocukların ve gençlerin bu kültürün içinde yetişmesini sağlamak için",
    desc: "Onları kitap, sanat, bilim ve düşünceyle buluşturan çalışmalarla geleceğin okurlarını, araştırmacılarını ve sanatçılarını desteklemek için."
  },
  {
    title: "Bunu birlikte yapmak için",
    desc: "Bodrum Kent Kütüphanesi başta olmak üzere kültür, sanat ve ekoloji alanındaki projelerimizi kurulmakta olan derneğimizin çatısı altında, toplumun katılımıyla büyütmek istiyoruz."
  }
];

const supportTypes = [
  {
    title: "Kitap bağışlayabilirsiniz",
    desc: "Kütüphanemizin koleksiyonunu zenginleştirebilir; özellikle Bodrum, Halikarnas, Karya, Ege ve Akdeniz tarihi, arkeoloji, sanat, edebiyat ve bilim alanlarında kaynakların çoğalmasına katkıda bulunabilirsiniz."
  },
  {
    title: "Bilginiz ve uzmanlığınızla katkıda bulunabilirsiniz",
    desc: "Yazar, araştırmacı, akademisyen, bilim insanı, sanatçı veya farklı bir alanda uzman olarak söyleşi, konferans, atölye ve araştırma çalışmalarımıza katılabilirsiniz."
  },
  {
    title: "Maddi destek sağlayabilirsiniz",
    desc: "Kütüphanenin gelişimi, etkinlikler, yayınlar, araştırmalar, kültür-sanat projeleri ve ulusal/uluslararası çalışmaların gerçekleştirilmesine katkıda bulunabilirsiniz."
  },
  {
    title: "Gönüllü olabilirsiniz",
    desc: "Kütüphane çalışmalarından etkinlik organizasyonlarına, araştırmalardan iletişim ve tanıtıma kadar farklı alanlarda zamanınız ve becerilerinizle katkı sunabilirsiniz."
  },
  {
    title: "Araştırma ve proje çalışmalarına destek olabilirsiniz",
    desc: "Bodrum’un tarihi, kültürü, sanatı, doğası ve toplumsal yaşamına ilişkin araştırma, arşiv, sözlü tarih ve yayın çalışmalarına katkıda bulunabilirsiniz."
  },
  {
    title: "Mekân, ekipman ve malzeme desteği sağlayabilirsiniz",
    desc: "Etkinlik, sergi, toplantı ve atölyeler için mekânlarınızı veya ihtiyaç duyulan teknik ekipman ve malzemeleri paylaşabilirsiniz."
  },
  {
    title: "Ulusal ve uluslararası bağlantılar kurmamıza yardımcı olabilirsiniz",
    desc: "Yazarları, bilim insanlarını, sanatçıları, kurumları, üniversiteleri ve kültür kuruluşlarını Bodrum Kent Kütüphanesi ile buluşturarak yeni iş birliklerinin oluşmasına katkıda bulunabilirsiniz."
  },
  {
    title: "Bu çalışmaları çevrenizle paylaşabilirsiniz",
    desc: "Kütüphaneyi ve projelerimizi daha fazla insana ulaştırarak okurların, gönüllülerin, üreticilerin ve destekçilerin bu ortak hayale katılmasını sağlayabilirsiniz."
  }
];
---

<Layout
  title={`Destek & Gönüllü Katılım | ${t.siteTitle}`}
  description="Bodrum Kent Kütüphanesi'ne destek olun, gönüllü olarak katılın ve Bodrum'un kültürel geleceğine ortak olun."
  lang={lang}
  currentPath="/destek"
>
  <!-- Hero Section -->
  <section class="py-16 md:py-24 px-5 md:px-12 bg-surface-bright border-b border-sand">
    <div class="max-w-[1280px] mx-auto">
      <div class="max-w-3xl">
        <h1 class="font-serif text-3xl sm:text-4xl md:text-5xl text-ink font-bold leading-tight mb-4">
          Destek & Gönüllü Katılım
        </h1>
        <p class="font-serif text-lg sm:text-xl text-ink/80 leading-relaxed">
          Bodrum’un kültürel belleğini ve geleceğini birlikte inşa etmek, bilginin ışığını çoğaltmak için siz de bu ortak hayale katılabilirsiniz.
        </p>
      </div>
    </div>
  </section>

  <div class="max-w-[1280px] mx-auto px-5 md:px-12 py-16 space-y-24">
    
    <!-- 1. Bu Hayale Neden Ortak Olmalısınız? -->
    <section>
      <h2 class="font-serif text-2xl sm:text-3xl text-ink font-bold mb-8 pb-3 border-b border-sand">
        Bu Hayale Neden Ortak Olmalısınız?
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {whyJoinUs.map((item, index) => (
          <div class="bg-surface-container-low border border-sand p-6 sm:p-8 flex items-start gap-4">
            <span class="w-8 h-8 rounded-full bg-olive text-white flex items-center justify-center font-mono text-xs font-bold shrink-0 mt-0.5 shadow-xs">
              {index + 1}
            </span>
            <div>
              <h3 class="font-serif text-lg sm:text-xl text-ink font-bold mb-2 leading-snug">
                {item.title}
              </h3>
              <p class="font-serif text-sm sm:text-base text-ink/80 leading-relaxed">
                {item.desc}
              </p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 2. Ne Tür Desteklerde Bulunabilirsiniz? -->
    <section>
      <h2 class="font-serif text-2xl sm:text-3xl text-ink font-bold mb-8 pb-3 border-b border-sand">
        Ne Tür Desteklerde Bulunabilirsiniz?
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {supportTypes.map((item) => (
          <div class="bg-parchment border border-sand p-6 flex flex-col justify-between hover:border-olive/50 transition-all shadow-xs">
            <div>
              <div class="w-10 h-10 rounded-full bg-olive/10 text-olive flex items-center justify-center mb-4">
                <span class="material-symbols-outlined text-xl">favorite</span>
              </div>
              <h3 class="font-serif text-base sm:text-lg text-ink font-bold mb-2 leading-snug">
                {item.title}
              </h3>
              <p class="font-serif text-xs sm:text-sm text-ink/75 leading-relaxed">
                {item.desc}
              </p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 3. Doğrudan İletişim & Başvuru Formu -->
    <section class="bg-surface-container-low border border-sand p-8 sm:p-12 shadow-xs">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        
        <!-- Sol Taraf: Doğrudan İletişim -->
        <div class="lg:col-span-5 space-y-6">
          <div>
            <span class="text-xs uppercase tracking-widest text-olive font-serif font-bold block mb-2">DOĞRUDAN İLETİŞİM</span>
            <h3 class="font-serif text-2xl sm:text-3xl text-ink font-bold leading-tight mb-3">
              Kütüphane Yetkilimiz ile Görüşün
            </h3>
            <p class="font-serif text-sm text-ink/80 leading-relaxed">
              Katkıda bulunmak istediğiniz destek ile ilgili bize doğrudan ulaşabilirsiniz.
            </p>
          </div>

          <div class="space-y-4 pt-4 border-t border-sand text-sm font-serif">
            <div class="flex items-center gap-3">
              <span class="material-symbols-outlined text-olive text-xl">call</span>
              <div>
                <div class="text-xs text-stone-gray font-sans">Telefon</div>
                <a href="tel:+905423739748" class="text-ink font-bold text-base hover:text-olive transition-colors">
                  +90 (0) 542 373 97 48
                </a>
              </div>
            </div>

            <div class="flex items-center gap-3">
              <span class="material-symbols-outlined text-olive text-xl">mail</span>
              <div>
                <div class="text-xs text-stone-gray font-sans">Destek Koordinasyonu</div>
                <a href="mailto:destek@bodrumkentkutuphanesi.org" class="text-ink font-bold hover:text-olive transition-colors">
                  destek@bodrumkentkutuphanesi.org
                </a>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <span class="material-symbols-outlined text-olive text-xl mt-0.5">location_on</span>
              <div>
                <div class="text-xs text-stone-gray font-sans">Yerleşke</div>
                <div class="text-ink font-medium">Kızılağaç, Bodrum / Muğla</div>
              </div>
            </div>
          </div>
        </div>

        <!-- Sağ Taraf: Destek ve Gönüllü Katılım Başvuru Formu -->
        <div class="lg:col-span-7 bg-parchment border border-sand p-6 sm:p-8 shadow-xs">
          <h3 class="font-serif text-2xl text-ink font-bold mb-2">
            Destek ve Gönüllü Katılım Başvuru Formu
          </h3>
          <p class="font-serif text-xs text-stone-gray mb-6">
            Lütfen ilgilendiğiniz destek alanını ve bilgilerinizi iletin; yetkilimiz sizinle irtibata geçecektir.
          </p>

          <form id="support-form" class="space-y-4 font-serif">
            <div>
              <label class="block text-xs font-bold text-ink uppercase tracking-wider mb-1">Ad Soyad *</label>
              <input 
                type="text" 
                required 
                placeholder="Adınız Soyadınız"
                class="w-full px-4 py-2.5 bg-surface-bright border border-sand text-ink text-sm focus:outline-none focus:border-olive" 
              />
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-bold text-ink uppercase tracking-wider mb-1">E-Posta *</label>
                <input 
                  type="email" 
                  required 
                  placeholder="ornek@alanadi.com"
                  class="w-full px-4 py-2.5 bg-surface-bright border border-sand text-ink text-sm focus:outline-none focus:border-olive" 
                />
              </div>
              <div>
                <label class="block text-xs font-bold text-ink uppercase tracking-wider mb-1">Telefon</label>
                <input 
                  type="tel" 
                  placeholder="05XX XXX XX XX"
                  class="w-full px-4 py-2.5 bg-surface-bright border border-sand text-ink text-sm focus:outline-none focus:border-olive" 
                />
              </div>
            </div>

            <div>
              <label class="block text-xs font-bold text-ink uppercase tracking-wider mb-1">İlgilenilen Destek Türü *</label>
              <select required class="w-full px-4 py-2.5 bg-surface-bright border border-sand text-ink text-sm focus:outline-none focus:border-olive">
                <option value="">Destek türü seçiniz...</option>
                <option value="kitap">Kitap Bağışı</option>
                <option value="uzmanlik">Bilgi ve Uzmanlık / Konuşmacı</option>
                <option value="maddi">Maddi / Kurumsal Destek</option>
                <option value="gonullu">Gönüllü Katılım</option>
                <option value="arastirma">Araştırma & Arşiv Desteği</option>
                <option value="mekan">Mekân, Ekipman ve Malzeme Desteği</option>
                <option value="baglanti">Ulusal / Uluslararası Bağlantı ve İletişim</option>
                <option value="diger">Diğer</option>
              </select>
            </div>

            <div>
              <label class="block text-xs font-bold text-ink uppercase tracking-wider mb-1">Mesajınız / Katkı Öneriniz</label>
              <textarea 
                rows="4" 
                placeholder="Yapmak istediğiniz katkıyı kısaca açıklayınız..."
                class="w-full px-4 py-2.5 bg-surface-bright border border-sand text-ink text-sm focus:outline-none focus:border-olive"
              ></textarea>
            </div>

            <button 
              type="submit" 
              class="w-full py-3.5 bg-olive text-white hover:bg-ink text-sm font-serif font-semibold tracking-wider uppercase transition-colors shadow-xs"
            >
              Başvuruyu Gönder
            </button>
          </form>
        </div>

      </div>
    </section>

  </div>
</Layout>

<script>
  const form = document.getElementById('support-form') as HTMLFormElement;
  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if ((window as any).showToast) {
        (window as any).showToast('Destek ve katılım başvurunuz başarıyla alındı. Teşekkür ederiz.', 'success', 5000);
      }
      form.reset();
    });
  }
</script>
