---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchModal from '../components/SearchModal.astro';
import VideoModal from '../components/VideoModal.astro';
import BookDetailModal from '../components/BookDetailModal.astro';
import EventGalleryModal from '../components/EventGalleryModal.astro';
import { getT, getEquivalentLanguageUrl, type Lang } from '../utils/i18n';
import '../styles/global.css';

export interface Props {
  title: string;
  description?: string;
  lang?: Lang;
  currentPath?: string;
  image?: string;
  type?: 'website' | 'article';
}

const {
  title,
  description,
  lang = 'tr',
  currentPath = Astro.url.pathname,
  image = '/images/og-bodrum-library.jpg',
  type = 'website'
} = Astro.props;

const t = getT(lang);

const siteBase = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://bodrumkentkutuphanesi.org';
const canonicalURL = new URL(currentPath, siteBase).toString();

const trPath = lang === 'tr' ? currentPath : getEquivalentLanguageUrl(currentPath, 'tr');
const enPath = lang === 'en' ? currentPath : getEquivalentLanguageUrl(currentPath, 'en');

const trUrl = new URL(trPath, siteBase).toString();
const enUrl = new URL(enPath, siteBase).toString();

const pageTitle = title.includes(t.siteTitle) ? title : `${title} | ${t.siteTitle}`;
const metaDescription = description || t.siteTagline;
const ogImage = image.startsWith('http') ? image : new URL(image, siteBase).toString();
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Primary SEO Tags -->
    <title>{pageTitle}</title>
    <meta name="title" content={pageTitle} />
    <meta name="description" content={metaDescription} />
    <meta name="author" content="Bodrum Kent Kütüphanesi" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Multilingual Hreflang Alternates -->
    <link rel="alternate" hreflang="tr" href={trUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={trUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={t.siteTitle} />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'tr_TR'} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon.svg" />
    <meta name="theme-color" content="#F9F7F2" />
  </head>

  <body class="min-h-screen flex flex-col bg-parchment text-ink selection:bg-olive selection:text-white font-sans antialiased">
    
    <!-- Skip to Content Accessibility Link -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-ink focus:text-white focus:rounded focus:outline-none"
    >
      {lang === 'tr' ? 'İçeriğe Geç' : 'Skip to Content'}
    </a>

    <!-- Global Header -->
    <Header lang={lang} currentPath={currentPath} />

    <!-- Main Content Container -->
    <main id="main-content" class="flex-1 w-full pt-20">
      <slot />
    </main>

    <!-- Global Footer -->
    <Footer lang={lang} />

    <!-- Interactive Search Modal -->
    <SearchModal lang={lang} />

    <!-- Interactive YouTube Video Modal Player -->
    <VideoModal lang={lang} />

    <!-- Interactive Book Detail Modal Player -->
    <BookDetailModal lang={lang} />

    <!-- Interactive Event Photo Gallery Modal -->
    <EventGalleryModal lang={lang} />

    <!-- Toast Notifications Container -->
    <div
      id="toast-container"
      class="fixed bottom-6 right-6 z-50 flex flex-col gap-2.5 pointer-events-none max-w-sm w-full px-4 sm:px-0"
      aria-live="polite"
      aria-atomic="true"
    ></div>

    <!-- Global Toast Script Helper -->
    <script is:inline>
      (function() {
        window.showToast = function(message, type = 'info', duration = 4000) {
          const container = document.getElementById('toast-container');
          if (!container) return;

          const toast = document.createElement('div');
          toast.className = `pointer-events-auto flex items-start gap-3 p-4 rounded-md border shadow-lg transition-all duration-300 transform translate-y-4 opacity-0 text-sm font-medium ${
            type === 'success'
              ? 'bg-parchment border-olive text-ink'
              : type === 'error'
              ? 'bg-red-50 border-red-300 text-red-900'
              : type === 'warning'
              ? 'bg-amber-50 border-amber-300 text-amber-900'
              : 'bg-surface-bright border-sand text-ink'
          }`;

          const iconName =
            type === 'success' ? 'check_circle' :
            type === 'error' ? 'error' :
            type === 'warning' ? 'warning' : 'info';

          const iconColor =
            type === 'success' ? 'text-olive' :
            type === 'error' ? 'text-red-600' :
            type === 'warning' ? 'text-amber-600' : 'text-stone-gray';

          toast.innerHTML = `
            <span class="material-symbols-outlined text-[20px] ${iconColor} shrink-0 mt-0.5">${iconName}</span>
            <div class="flex-1 text-xs sm:text-sm leading-snug">${message}</div>
            <button type="button" class="text-stone-gray hover:text-ink shrink-0 -mr-1 -mt-1 p-1 rounded" aria-label="Kapat">
              <span class="material-symbols-outlined text-[16px]">close</span>
            </button>
          `;

          const closeBtn = toast.querySelector('button');
          function removeToast() {
            toast.classList.add('opacity-0', 'translate-y-2');
            setTimeout(() => {
              if (toast.parentElement) toast.remove();
            }, 300);
          }

          if (closeBtn) {
            closeBtn.addEventListener('click', removeToast);
          }

          container.appendChild(toast);

          // Trigger smooth animate in
          requestAnimationFrame(() => {
            toast.classList.remove('translate-y-4', 'opacity-0');
            toast.classList.add('translate-y-0', 'opacity-100');
          });

          if (duration > 0) {
            setTimeout(removeToast, duration);
          }
        };
      })();
    </script>
  </body>
</html>
